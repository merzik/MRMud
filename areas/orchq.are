  mpquiet on
  martialarts $n
  martialarts $n
  martialarts $n
  martialarts $n
  martialarts $n
  mpquiet off
  emote 's DEATH PSIONIC WAVE...
  mpforce $n help DUORP3
  break
endif
~
>death_prog 100~
