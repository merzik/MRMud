100 BODY_TORSO BODY_LEG|BODY_ARM|BODY_HAND 2d1000+9000 10d30+100
100000 RACE_ORC
POS_STANDING POS_STANDING SEX_FEMALE
>all_greet_prog 100~
if ispc($n)
  if race($n) == 6
    if level($n) < 10
      say Well, you have potential dear, however...
      say if GROW a little here,... and maybe there... :)
      say Well, anyways just come back when you're BIGGER ok?
      wink $n
      say Hope I'll see you soon dear.
      say But for now...
      emote starts chanting something softly.
      mpecho You begins to glow!
      mptransfer $n 9755
      mpat 9755 mpechoat $n You stop glowing.
      break
    else
      say Well, I suppose you're BIG enough to join...
      say Hmm...
      mpecho examine you critically...
      poke $n
      say Hmm... Do you want to join the army dear?
      wink $n
      say If you do, just say "yes".
      break
    endif
   else
      say Well, whatever race you are I'm sorry to say that this
      say place is off limits. Although I wish to see you here
      say more often.
      wink $n
      say Alone that is... :)
      emote starts chanting something.
      mpecho You starts to glow!
      mptransfer $n 9755
      mpat 9755 mpechoat $n The glow fades away from your body.
      break
  endif
endif
~
>speech_prog yes~
if ispc($n)
  if race($n) == 6
    if level($n) >= 10
      if quest (0,4,$n) == 0
        mpmset $n quest 0 4 2
        say Well, here you go, the form is no the floor.
        say Fill in your particulars and go ONE DOWN.
        say Give the form to Commander Chizkri and she'll
        say take it from there. Welcome to the army dear!
        mpquiet on
        mpoload 2401
        drop all
        mpquiet off
        break
      endif
    endif
  endif
endif
