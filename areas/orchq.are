100000 RACE_ORC
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if ispc($n)
  if sex($n) == 1
    smile $n
    say Please watch your steps, the floor is wet.
    break
  else
    say Oh My! Sorry but this is the men's restroom.
    shake 
    sigh 
    say I absolutely hate this job.
    emote writes something on a board and hangs it over you.
    emote hauls you out and you start glowing.
    mptransfer $n 9755 
    mpat 9755 mpechoat $n You feel kind of dumb.
    mpat 9755 mpechoat $n Your glowing subsides.
    break
  endif
endif
~
