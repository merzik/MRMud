>give_prog i2401~
if ispc($n)
  if race($n) == 6
    if level($n) >= 10
      if quest (0,4,$n) == 2
        mpmset quest $n 0 4 4
        say Thank you for joining the great cause.
        curtsey $n
        giggle $n
        say As a token of the army's appreciation, of you
        say joining the cause, please...
        say pick up your VERY OWN ARMY DOG TAG!
        say It's on the floor. Go ahead and wear it with pride. 
        giggle $n
        mpjunk all
        mpquiet on
        mpoload 2400
        drop all
        mpquiet off
        break
      endif
    endif
  endif
endif
~
