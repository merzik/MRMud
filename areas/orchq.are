>all_greet_prog 10~
if ispc($n)
  if level($n) < 16
    if race($n) == 6
      if quest (0,4,$n) == 4
        giggle $n
        say Welcome to the healer's chamber. :)
        say I can help heal your wounds.
        say Just say "cure" and I'll heal you.
        break
      endif
    endif
  endif
endif
~
>speech_prog cure~
if ispc($n)
  if race($n) == 6
    if level($n) < 16
      if quest (0,4,$n) == 4
        if quest (4,6,$i) == 0
          emote smile sweetly at you.
          emote closes her eyes and starts chanting.
          Unknown $n gold -10000
          mpquiet on
          cast "cure critical" $n
          mpquiet off
          mpecho A soothing feeling flows through your whole body.
          say There you go, I sincerely hope this would ease our pain.
          say As for now I need to rest little.
          say I'm sorry dear...
          emote closes her eyes.
          mpmset $i quest 4 6 30
          break
        else
          mpecho You don't wish to disturb the nice lady...
          mpecho for she has just offered her heart and soul to heal you. 
          break
        endif
      endif
    endif
  endif
endif
~
