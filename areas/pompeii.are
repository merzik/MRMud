>speech_prog vodka whiskey ale beer rum scotch tequilla bourbon~
if quest (0, 3, $n) == 0
  say Ah, we've got a strong drinker, eh?
  say Good choice, friend.
  say Bracing yourself for the upcoming HOLOCAUST, eh?
  wink $n
  mpoload 12524
  give i12524 $n
  mpmset $n quest 0 3 1
endif
~
>speech_prog holocaust~
if quest (0, 3, $n) == 1
  say Half the town's under lava already, Eagle-eye.
  say Maybe you don't need that drink after all
  snicker
  say I think this is where I cut you off, friend.
  say Get out, shoo! Don't bother the gatekeeper, either.
  say He's recruiting HELPers, not drunkers!
else
say What about it?
endif
~
>speech_prog help~
if quest (0, 3, $n) == 1
  say Not me!
  bonk $n
  say The Gatekeeper!
endif
~
