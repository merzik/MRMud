      tell $n You are a General, M'Lady.
      mpmset $n long Lady $n, a General of the Gnome Army is here.
      mppurge self
    else
      tell $n You are a General, M'Lord.
      mpmset $n long Lord $n, a General of the Gnome Army is here.
      mppurge self
  endif
else
mppurge self
endif
~
