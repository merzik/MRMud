463728 RACE_DROW 
POS_STANDING POS_STANDING SEX_MALE 
>rand_prog 100~ 
if quest(0,8,self) > 0 
  if isnight()
    mpmset self quest 0 8 0
    mppurge i18133
    mpecho The blue rose bush dies due to lack of sunlight. 
  endif 
endif 
~ 
>speech_prog p grow!~ 
if actorhasobjnum(18112) 
  if quest(0,8,self) > 0
    mpecho There is already a blue rose bush growing here.
  else
    if isday()
      mpoload 18133 
      mpoload 18110
      mpquiet on
        mpforce $n drop i18112
        mpforce $n drop i18116
        mpjunk i18112
        mpjunk i18116
      mpquiet off
      mpmset self quest 0 8 20 
      mpecho The blue rose grows and flourishes in the bright sunlight. 
      mpquiet on 
        drop i18110
      mpquiet off 
      mpecho Suddenly, the sun becomes even brighter, so bright even that you are blinded. 
      mpecho After a few moments, the sunlight returns to normal.
    else
      mpechoat $n Perhaps you should wait until daylight?
  endif 
endif 
~ 
