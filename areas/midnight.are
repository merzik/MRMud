~
>speech_prog p My lord, I have lost my sword~
  if quest(20,1,$n) == 1
    tell $n Impotent fool!
    if actorhasobjnum(18142)
      tell $n Do not attempt to trick me, young one.  I suggest you return to your travels
    else
      tell $n Very well, I shall supply you with a new one.
      mpoload 18142
      give 18142 $n
    endif
  endif
~
>speech_prog p My lord, I have lost my staff~
  if quest(20,1,$n) == 1
    tell $n Impotent fool!
    if actorhasobjnum(18131)
      tell $n Do not attempt to trick me, young one.  I suggest you return to your travels
    else
      tell $n Very well, I shall supply you with a new one.
      mpoload 18131
      give 18131 $n
    endif
  endif
~
>rand_prog 100~
  if quest(3,1,$i) == 1
    mpmset self quest 3 1 0
    say Well done, you have almost completed the staff.
    ponder
    say However, only a true wizard can bestow ultimate power. Bring me the king's Iron Fist and you shall have my power!
  endif
~
>all_greet_prog 100~
if quest(15,1,$n) == 1
  say So the queen trusts you...
  emote ponders you and your loyalty.
  say Very well, let us begin plotting to overthrow that dictator on the throne.
  mpoload 18120
  say I bestow upon you this spellbook, to assist you.
  mpquiet on
    give i18120 $n
  mpquiet off
  say In order to thwart the king, you need to make a staff.
  say Use that book to help.
  mpmset $n quest 31 5 4
endif
~
>give_prog i18107~
if quest(31,5,$n) == 14
  cackle
  mpecho The wizard reveals his true self!
  mpmset $i short Lord Demise
  bow
  say You have done well, my child
  mpecho Lord Demise lifts his hands in the air, and your stick is transformed.
  if class($n) == 0
  or class($n) == 1
  or class($n) == 4
  or class($n) == 5
    mpquiet on
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      mpoload 18131
      mpforce $n mpjunk i18110
      give i18131 $n
    mpquiet off
    mpforce $n wield i18131
  else
    mpquiet on
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      c rem $n
      mpoload 18142
      mpforce $n mpjunk i18110
      give i18142 $n
    mpquiet off
    mpforce $n wield i18142
  endif
  say Fare thee well, $n
  mpecho Lord Demise fades into the darkness.
  mpmset $n quest 31 5 15
  mppurge $i
endif
~
>speech_prog p The waking dead, the dead to waking~
if quest(31,5,$n) == 10
  mpmset $n quest 31 5 11
  mpecho The room grows dark as the forces of evil gather.
endif
~
>speech_prog p Breaking harmony and harmony broken~
if quest(31,5,$n) == 11
  mpmset $n quest 31 5 12
  mpecho Colors swirl, mix, and separate.
endif
~
>speech_prog p This power to you-the one to taking~
