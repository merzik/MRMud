>give_prog i18107~
if quest(31,5,$n) == 14
  wear i18107
  bow $n
  say I am most honored that you have returned my Iron Fist
  say You are certainly a great hero, and heroes deserve a hero's weapon
  mpoload 18142
  give i18142 $n
  mpmset $n quest 31 5 15
else
