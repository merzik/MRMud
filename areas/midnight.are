  mpmset $n quest 31 5 13
  mpecho A dark, glowing energy surrounds the wizard staff.
endif
~
>speech_prog p And sealing it with words so spoken~
if quest(31,5,$n) == 13
  mpmset $n quest 31 5 14
  mpecho Screams echo about the room, then all is normal.
  mpmset self quest 3 1 1
endif
