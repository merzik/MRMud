>rand_prog 90~
if quest(0,5,self) == 17
  say Why Gilikak so nice of you to visit me
  say After all these years.
  mpforce gili_quest_mob2 say Don't you get chummy with me Wyrm!
  mpforce gili_quest_mob2 say Why are you stirring up trouble?
  mpmset self quest 0 5 18
  break
endif
if quest(0,5,self) == 18
  say But Gilikak, are you not happy to see me?
  say After all you did put me here.
  say More than 2000 years ago!
  say Yessss I have counted everyday of my imprisonment!
  mpmset self quest 0 5 19
  break
endif
if quest(0,5,self) == 19
  mpforce gili_quest_mob2 say Your own actions put you here Wyrm.
  mpforce gili_quest_mob2 say You had the option to obey me, but
  mpforce gili_quest_mob2 say you chose to ignore your father and
  mpforce gili_quest_mob2 say run rampant through the land!
  mpforce gili_quest_mob2 say Wyrm, I will put you down if you do not quit this madness!
  cackle
  mpforce all external LAUGH.WAV
  mpmset self quest 0 5 20
  break
endif
if quest(0,5,self) == 20
  say You were no father!
  say You were my jailer!
  scream 
  mpecho $I rears up high upon its rear legs.
  mpforce gili_quest_mob2 Shout I warned you Wyrm!
  mpmset self quest 0 5 21
  mpforce gili_quest_mob2 mpkill wyrm_quest_mob
  break
endif
