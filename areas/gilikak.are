#11305
executioner ghost~
The ghostly executioner~
The silhouette of a strong dead executioner is here inflicting
pain on a prisoner.~
~
ACT_SENTINEL|ACT_BODY|ACT_SMART
AFF_INVISIBLE|AFF_HIDE|AFF_INFRARED|AFF_UNDERSTAND|AFF_TONGUES
-200 S
80 BODY_ARM BODY_LEG|BODY_ARM 1d1+9148 7d9+45
128761 711952
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 99~
if quest(0,4,self) == 0
  mpmset self quest 0 4 1
endif
~
>rand_prog 90~
if quest(0,4,self) == 1
  mpecho $I raises his ax over his head.
  say You have been convicted of crimes against
  say humanity.
  say Your sentence is death!
  mpmset self quest 0 4 2
  break
endif
if quest(0,4,self) == 2
  mpforce prisoner say But it wasn't me, I swear!
  mpecho $I lowers the ax slightly.
  say Haha, you would be surprised how many times 
  say I hear that in this job.
  mpmset self quest 0 4 3
  break
endif
if quest(0,4,self) == 3
  mpecho $I raises his ax over his head.
  say Any last words?
  mpmset self quest 0 4 4
  break
endif
if quest(0,4,self) == 4
  mpforce prisoner say Yes...
  mpforce prisoner say Your mother was really good to me last night!
  mpmset self quest 0 4 5
  break
endif
if quest(0,4,self) == 5
  gasp
  say You son of a ...
  mpecho $I throws the ax down and grabs the prisoner by the hair.
  mpmset self quest 0 4 6
endif
if quest(0,4,self) == 6
  mpforce all help help_beat
  mpforce all external SPLAT.WAV
  say You will pay for your slander, dog!!!
  mpkill prisoner
  mpmset self quest 0 4 7
  break
endif
if quest(0,4,self) == 9
  mpecho The executioner glances around nervously and runs from the room.
  mppurge self
  break
endif
~
>speech_prog stop~
if quest(0,4,$n) == 2
  if quest(0,4,self) == 7
    mpmset self quest 0 4 8
    say What? Who the hell are you?
    say How dare you come in here and tell me what to do.      
    peace
    mpforce prisoner rescale $n 80
    rescale 11305 $n 95
    mpquiet on
    mpforce prisoner sleep
    mpkill $n
    mpquiet off
  endif
else
  say Butt out!
  say You didn't see nothin.
endif
~
>death_prog 100~
mpecho $I spits up a lot of blood.
if quest(0,4,$n) == 2
  if quest(0,4,self) == 8
    mpmset $n quest 0 4 4
    mpmset prisoner quest 0 4 6
    peace
    mpquiet on
    mpforce prisoner stand
    mpquiet off
    mpmset self quest 0 4 0
  endif
endif
~
|
