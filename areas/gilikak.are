      endif
      if class($n) == 1
      or class($n) == 2
      or class($n) == 6
        mpoload 11358
        mpmset $n quest 31 1 1
      endif
      if class($n) == 0
      or class($n) == 4
        mpmset $n quest 31 1 1
        mpoload 11359
      endif
    endif
  endif
endif
~
