>all_greet_prog 100~
if quest (0,4,$n) >= 5
  mpmset self short NULL
  peace
  tell $n We look like hell.
  tell $n You haven't been taking good care of us.
  mpmset self quest 0 4 1
else
  if ispc($n)
    mpmset self short NULL
    mpecho $n looks deep into your soul.
    say There can be only one of us.
    say Therefore, you must die.
    mpmset self short NULL
    rescale 11307 $n 99
    mpkill $n
  endif
endif
~
>rand_prog 75~
if quest(0,4,self) == 1
  say We think our face is dry, and in need of some help.
  say We hear that a woman's facial cream is good for the complexion.
  mpmset self quest 0 4 0
  break
endif
if quest(0,4,self) == 2
  say Ahh yessss.  I look astounding.
  say You...  You look like hell.  A disgrace!
 rescale 11307 $n 99
  mpkill $n
  mpmset self short $n
  mpmset self quest 0 4 0
  break
endif
~
>give_prog i11321~
if quest(0,4,$n) == 6
  peace
  say Ahh we have done very well.
  mpforce $n help help_cream
  mpmset self quest 0 4 2
  rescale 11307 $n 85
else
  say What is this?
  say You think I need this?
 rescale 11307 $n 90
  mpkill $n
endif
~
>fight_prog 35~
say We will defeat you!
mpforce all external  CACKLE.WAV
if class($n) == 0
  cast "acid blast"
  cast "burning hands"
else
if class($n) == 1
  cast "fireball"
  cast "fireball"
else
if class($n) == 2
  mpecho $I backstabs you for 720 hit points!
  mpquiet on
  cast "acid blast"
  cast "weaken"
  cast "harm"
  mpquiet off
else
if class($n) == 4
  cast "energy drain"
  cast "weaken"
  cast "energy drain"
else
if class($n) == 5
  remove sword
  cast "harm"
  cast "harm"
  cast "cure critical"
else
if class($n) == 6
 mpquiet on
 cast "acid blast" $n
 mpquiet off 

 mpecho $i knifes $n hard. 
else
endif
endif
endif
endif
endif
endif
endif
~
>death_prog 100~
if quest(0,4,$n) == 6
 say Clearly you are the better self.
  say Hrm...Your face still looks worse than mine..... 
 say Use magic to keep yourself looking young.
  mpmset $n quest 0 4 7
  mpjunk i11321
endif
