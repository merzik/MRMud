  if quest(10,3,$n) == 7
    mpmset $n quest 4 3 2
    mpmset $n quest 10 3 0
    say You mortals are more clever than I thought.
    say You are fortunate that you did not double cross me.
    say Now, you must do one last thing for me.
    say Say unto Gilikak these words "He comes for you".
    say Now go from me...
    break
  endif
endif
