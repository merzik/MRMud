>speech_prog p He comes for you~
if quest(4,3,$n) == 2
  say Who comes for me?
  mpforce $n grin
  mpquiet on
  mpforce $n rest
  mpquiet off
  mpmload 11320
  mpforce wyrm_quest_mob2 shout I come for your soul Gilikak!
  mpecho The Great Wyrm appears within a bright flash of light.
  gasp
  mpforce wyrm_quest_mob2 say Surprised father??  You look as if you have seen a ghost.
  mpforce wyrm_quest_mob2 say Yes father, I have come to repay for years of neglect.
  Say YOU!?  How did you get out!?
  mpforce wyrm_quest_mob2 cackle
  mpforce wyrm_quest_mob2 say Your friend was easily conviced to help me.
  mpforce wyrm_quest_mob2 grin
  gasp
  mpforce wyrm_quest_mob2 say You thought I was safely tucked away.
  mpforce wyrm_quest_mob2 say A fancy bauble you could look at when you wished.
  mpforce wyrm_quest_mob2 say You created me!  Now you must deal with me!
  cackle
  mpquiet on
  mpmadd self currhp 10000
  mpmadd wyrm_quest_mob2 currhp 10000
  cast "sanctuary" wyrm_quest_mob2
  mpquiet off
  mpforce wyrm_quest_mob2 mpkill gili_quest_mob
  mpmset self quest 0 6 15
  mpmset $n quest 4 3 3
endif
