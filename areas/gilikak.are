>all_greet_prog 99~
  if whichgod($n) == 2
    if quest(0,4,$n) <= 9
      shout Vermin!
      shout Even in death I am sworn to exterminate all forces of Chaos.
      shout You shall pay for your deceit!
      rescale 11314 $n 120
      mpkill $n
    endif
  endif
  if quest(4,3,$n) < 2
    if quest(4,3,$n) >= 1
      look $n
      tell $n You look as if you are hiding something.
      tell $n What is it?
    endif 
  endif
  if quest(7,3,$n) == 3
    say You are a true ally.
    cast "giant strength" $n
    mpoload 11326
    give i11326 $n 
    if rand(45)
      mpoload 11328
