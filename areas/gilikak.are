AFF_INVISIBLE|AFF_HIDE|AFF_UNDERSTAND|AFF_TONGUES
100 S
40 BODY_ARM BODY_MOUTH|BODY_EYE|BODY_HIP|BODY_ARM 1d1+10252 5d5+15
0 584441
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 65~
if quest(0,4,self) == 6
  say Oh thank you!  I owe you something in return!
  say Give me a second to get myself cleaned up.
  mpmset self quest 0 4 7
  break
endif
if quest(0,4,self) == 7
  mpecho $I adjusts his shabby clothing.
  say Thank you so much...
  mpmset self quest 0 4 8
  break
endif
if quest(0,4,self) == 8
  say Well here you go.
  mpoload 11319
  mpmset self quest 0 4 9
  Say I've also got... hrm, where is it...
  mpecho $I searches through his shabby clothing.
  break
endif
if quest(0,4,self) == 9
  mpoload 11320
  mpecho $I hands you.. Ooo!
  drop all
  say Sorry, I get so clumsy after being saved from an execution.
  mpmset self quest 0 4 10
  break
endif
if quest(0,4,self) == 10
  say I guess this make us even.
  smile
  mpmset self quest 0 4 0
  break
endif
~
>death_prog 100~
  gasp
  say Why didn't you help me?
  say Please, Stop him from doing this again!
  say I was innocent!  Make him Stop!
  mpmset executioner quest 0 4 9
~
