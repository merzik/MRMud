0
350 S
65 BODY_HEAD|BODY_HAND BODY_HEAD|BODY_HAND 1d1+2250 1d1+45
31133 RACE_DWARF
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest (0,4,$n) == 3
  bow $n
else
  mpecho The guard yells, 'Be gone, pirate scum!'
  mptransfer $n 28700
endif
~
>fight_prog 100~
if rand (2)
  wield blade
  mpecho The guard feints left, then lunges right.
else
  if rand (4)
    wield blade
    mpechoat $n The guard cross-steps left to avoid your attack.
    mpechoaround $n The guard cross-steps left to avoid $n's attack.
  else
    if rand (6)
      wield blade
      mpechoat $n You narrowly dodge the guard's thrust.
      mpechoaround $n $n narrowly dodges the guard's thrust.
    else
      if rand (8)
        wield blade
        mpechoat $n The guard shifts the grip on his blade and advances toward you.
        mpechoaround $n The guard shifts the grip on his blade and advances toward $n.
      else
        if rand (10)
          wield blade
          mpecho The guard takes a step backward to recompose himself.
        else
          if rand (12)
            wield blade
            mpecho The guard raises his blade high above his head.
          else
            if rand (14)
              wield blade
              glare $n
            else
              if rand (16)
                spit $n
              else
                if rand (18)
                  slap $n
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif
~
|
