0
100 S
65 BODY_HEAD BODY_HEAD 1d1+2250 1d1+45
48484 RACE_DWARF
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 4~
mpecho The sentinel shifts his weight uneasily.
~
>fight_prog 100~
if rand (2)
  mpecho The sentinel launches a furious assault.
else
  if rand (4)
    mpecho The sentinel lashes out in anger.
  else
    if rand (6)
      mpecho The sentinel raises his voice in a horrific war cry.
    else
      if rand (8)
        glare $n
      else
        if rand (10)
          spit $n
        else
          if rand (11)
            if isgood($n)
            else
              mpecho The sentinel looks to the sea and makes a silent prayer to Neptune.
              mpforce $n remove all
              grin $n
            endif
          else
            if rand (14)
              say Pirate scum!   You shall fall to my mighty blade!
            else
              if rand (16)
                say Die, maggot!
              else
                if rand (17)
                  mpecho The sentinel flips around and lifts his tunic, giving
                  mpecho you an up-close look at his backside.
                else
                  if rand (20)
                    say In the name of Lord Neptune, you will perish!
                    mpecho The sea rumbles and waves crash against the wall.
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif
~
