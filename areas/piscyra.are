40 BODY_HEAD|BODY_HAND BODY_HEAD 1d1+640 1d1+26
39119 RACE_DWARF
POS_STANDING POS_STANDING SEX_FEMALE
>rand_prog 1~
mpecho The Piscyrean woman whimpers softly and looks at you with pleading
eyes.
~
>fight_prog 100~
if rand (2)
  grovel $n
~
>rand_prog 2~
mpecho You catch a glimpse of needle and thread in the woman's pouch.
~
>give_prog i28744~
smile $n
if quest(0,4,self)==0
  say Four more pieces of loach skin like that,
  say and I'd be able to sew a fine sash.
  mpmset self quest 0 4 1
else
if quest(0,4,self)==1  
  say Three more pieces of loach skin would be nice.
  mpmset self quest 0 4 2
else
if quest(0,4,self)==2
  say Two more pieces, and I'm all set.
  mpmset self quest 0 4 3
else
if quest(0,4,self)==3
  say One more piece, and you have yourself a sash.
  say Let me get started.
  mpecho The woman whips out a needle and some thread.
  mpmset self quest 0 4 4
else
if quest(0,4,self)==4
  say There we go!
  mpecho The woman carefully sews together
  mpecho the pieces of loach skin.
  say And... here you go.
  mpoload 28743
  mpquiet on
  c 'remove curse' self
  mpquiet off
  drop i28743
  bow $n
  mpmset self quest 0 4 0
endif
endif
endif
endif
endif
~
