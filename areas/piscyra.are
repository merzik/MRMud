>all_greet_prog 100~
if quest (0,4,$n) == 3
mpechoat $n You are blinded by a flash of turquoise!
mpechoat $n You feel different.
mpechoaround $n $n is surrounded by a turquoise aura!
mpquiet on
c 'blindness' $n
if rand(10)
  c 'sanctuary' $n
  c 'breath water' $n
  c 'mage shield' $n
  c 'stone skin' $n
else
if rand(30)
  c 'mage shield' $n
  c 'stone skin' $n
  c 'breath water' $n
else
if rand(50)
  c 'stone skin' $n
  c 'breath water' $n
else
if rand(70)
  c 'breath water' $n
else
c 'change sex' $n
endif
endif
endif
endif
c 'cure blindness' $n
mpquiet off
mpechoat $n Your vision returns.
~
