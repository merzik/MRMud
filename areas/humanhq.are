>speech_prog p I wish to enter the fortress.~
if armystatus($n) == 1
   tell $n Very well than. However if you have not seen Lord Gargkarth,
   tell $n you need to go see him.
   mpechoat $n The man opens the doors and let you in.
   mptransfer $n 508
else
   say Sorry, restricted personals only.
endif
~
>all_greet_prog 100~
if race($n) > 0
   sigh
   say I can see that Matthius is not doing his job again!
   say Oh well, I will just have to kill you myself.
   mpkill $n
else
   if race($n) == 0
      if armystatus($n) == 1
         smile $n
         mpechoat $n Type : "I wish to enter the fortress."
         mpechoat $n if you wishes to enter the fortress.
      endif
   endif
endif
~
>fight_prog 100~
mpechoat $n Welcome to your death.
echo $n is dead!!
mpquiet on
slay $n
mpquiet off
tell $n I am God compared to you.
~
|
