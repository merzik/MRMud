#AREA Fort Tellurian~
#AUTHORS Rukawa~


#HELPS
-1 SwordTech_StormCutter!~
{030}Captain Matthius throws his sword towards you and charges at you{300}
{030}at the same time! You were caught by surprise!!                  {300}

{020}Captain Matthius yells 'Sword technique: {130}Storm Cutter{020}!!'{300}

His {130}Storm Cutter{300} <<--**** {131}PUNISHES{300} ****-->> you for {110}300hp{300}!!
~
-1 SwordTech_RaisingFlame!~
{030}Captain Matthius leaps into the air and strikes his sword on the{300}
{030}ground hard!                                                    {300}

{020}Captain Matthius yells 'Sword technique: {110}Flame Booster{020}!!'{300}

{110}The earth shivers as flames erupt beneath your feet!!{300}

His {110}Flame Booster{300} [*[*[*[*[*[ {131}DEVASTATES{300} ]*]*]*]*]*] you for {110}300hp{300}!!
~
-1 SwordTech_WaveInfinity!~
{030}Captain Matthius holds his sword back as he summons his inner powers!{300}

{020}Captain Matthius yells 'Sword technique: {170}Vacuum Slash{020}!!'{300}

{170}You feel that as if the air around you is being sucked away as he{300}
{170}swing his sword up high!                                         {300}

His {170}Vacuum Slash{300} <<-***---|[ {170}DEMOLISHES{170} ]|---***->> you for {110}400hp{300}!!
~
-1 BEALLTHATYOUCANBE~

.       {130}|=========================================================|{300}
        {130}|{074}                                                         {130}|{300}
        {130}|{074}         To [{174}JOIN{074}/{174}RESIGN{074}] from the Army, say :           {130}|{300}
        {130}|{074}           " I wish to see the commander. "              {130}|{300}
        {130}|{074}                                                         {130}|{300}
        {130}|=========================================================|{300}

~
0 $~
#RANGES 0 99 0 99
#FLAGS AFLAG_NODEBUG|AFLAG_NOTELEPORT
#MOBILES
#500
guard leader captain matthius~
Captain Matthius~
A guard of this mighty fortress is standing here.~
Standing before you is a seven feet tall, muscular young man with
dark brown hair. You notice that the armor which he is using is 
different from the other guards who are currently standing beside
him. He must be the leader of the guards here.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_NO_ORDER|ACT_BODY|ACT_RACE
AFF_SANCTUARY|AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_INFRARED|AFF_UNDERSTAND|AFF_TONGUES
1000 S
95 BODY_TORSO BODY_LEG|BODY_ARM|BODY_HAND 1d1+9400 10d10+100
100000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if ispc($n)
  if race($n) == 0
    if level($n) < 10
       say This is no place for you kid. Now go train some more.
       emote takes you back to Chakkor city.
       mpechoat $n Come back when you are a bit older.
       mptransfer $n 9755
    else
       say Hello there.
       smile $n
       mpforce $n sleep
       mpforce $n help BEALLTHATYOUCANBE
    endif
  endif
  if race($n) > 1
   if level($n) < 50
     say Ah HA! A spy huh?
     say I will not even degrade myself to killing you.
     say However, I must teach you one hell of a lesson!
     say Guards, remove this 'thing' from my sight!
     mpechoat $n The guards pick you up and drag you to Chakkor city.
     mptransfer $n 9755
   else
     say Prepare to defend yourself $n!
     say Guards! Attack!
     mpforce trooper_spec mpkill $n
     mpkill $n
   endif
  endif
endif
~
>rand_prog 100~
if inroom($i) != 511
  if position($i) != 6
    mpmset self quest 0 4 0
    mpgoto 511
  endif
endif
if rand(3)
  emote looks around him, making sure that everything is okay.
endif
~
>speech_prog p I wish to see the commander.~
if race($n) == 0
   if level($n) > 9
      say Very well than.
      smile
      emote opens the door to the small hut and let you in.
      connect 1 515
      mpforce $n east
      emote closes the door.
      connect 1 -1
   endif
endif
~
>fight_prog 99~
   if quest(0,4,$i) != 0
      mpmset self quest 0 4 0
      mptransfer $n 511   
      mpgoto 511   
      mpkill $n
   endif
   if rand(43)
      mpforce $n help SwordTech_StormCutter!
      mpquiet on
      kick
      disarm
      cast 'fireball' $n
      cast 'tremor' $n
      mpquiet off
   endif
   if rand(26)
      if quest(0,4,$i) == 0
         mpforce $n help SwordTech_RaisingFlame!
         mpquiet on
         cast 'fireball' $n
         cast 'fireball' $n
         cast 'fireball' $n
         mpquiet off
         mptransfer $n 520
         mpgoto 520
         mpmset $i quest 0 4 1
         mpkill $n
         break
      endif
   endif
   if rand(36)
      if quest(0,4,$i) == 0
         mpforce $n help SwordTech_WaveInfinity!
         mpquiet on
         cast 'acid blast' $n
         cast 'acid blast' $n
         mpquiet off
         mptransfer $n 521
         mpgoto 521
         mpmset $i quest 0 4 1
         mpkill $n
         break
      endif
   endif
~
>death_prog 100~
   transfer $n 511
   mpgoto 511
   mpechoat $n Do not feel happy defeating me for I am the weakest officer here.
~
|
