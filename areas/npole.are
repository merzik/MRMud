>speech_prog p winter wonderland~
if quest(0,5,self) == 15
 say Yes!  You're right!
 mpmset self quest 10 4 0
 mpmset self quest 0 5 0
 if quest(12,1,$n) == 1
   mpmset $n quest 16 1 1
   say Great! You've learned a song! 
 endif
else
 poke $n
 say Hey! Wait till I finish, lemme start again!
 mpmset self quest 0 5 1
 mpmset self quest 10 4 1
  MPFORCE all EXTERNAL XMASWINT.MID
endif
~
