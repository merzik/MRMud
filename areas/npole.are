>social_prog fondle~
if isnpc ($n)
  lick $n
else
  if sex($n) == 0
    fondle $n
  else
    if sex($n) == 2
      scream 
      say I'm not that type!
      slap $n
    else
      french $n
    endif
  endif
endif
~
>social_prog french~
if isnpc ($n)
  lick $n
else
  if sex($n) == 0
    fondle $n
  else
    if sex($n) == 2
      scream 
      say I'm not that type!
      slap $n
    else
      french $n
    endif
  endif
