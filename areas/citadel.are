>rand_prog 20~ 
if quest(0, 3, $i) < 1 
  mpmset self quest 0 3 1 
  mpecho You should move quickly to secure safety.
else 
if quest(0, 3, $i) > 5 
  mpecho The walls around you begin to shake and rumble.
  mpecho You feel warm sensation and slight dizziness.
  mptransfer pcs 9755 
  mppurge self
else 
mpmadd self quest 0 3 1 
endif 
endif 
~
