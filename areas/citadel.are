0 S
100 0 0 1d1+15094 1d1+155
1 RACE_HUMAN
POS_STANDING POS_STANDING SEX_NEUTRAL
>speech_prog enter~
if class($n) == 0
or class($n) == 1
  mptransfer $n 14021
  mpecho $n has entered the Test of Air.
else
  if class($n) == 2
  or class($n) == 7
    mptransfer $n 14020
    mpecho $n has entered the Test of Water.
  else
    if class($n) == 3
    or class($n) == 5
      mptransfer $n 14022
      mpecho $n has entered the Test of Earth.
    else
      if class($n) == 4
      or class($n) == 6
        mptransfer $n 14019
        mpecho $n has entered the Test of Fire.
      endif
    endif
  endif
endif
~
