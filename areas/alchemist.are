32 BODY_HEAD|BODY_TAIL BODY_MOUTH|BODY_TAIL 3d5+600 2d5+23
500 121124
POS_RESTING POS_RESTING SEX_NEUTRAL
>rand_prog 20~
mpecho The viper follows you with its black eyes.
~
>fight_prog 20~
if rand(25)
  mpecho The viper's fangs dig deep into $r!  
  mpechoat $r You don't feel so well.
  mpquiet on
  cast 'poison' $r
  mpquiet off
else
if rand(33)
  mpecho The viper crushes you with its coils!
  mpechoat $r You don't feel so well.
  mpquiet on
  cast 'cause critical' $r
  mpquiet off
else
if rand(50)
  mpecho The viper gazes into your eyes!  
  mpechoat $r You don't feel so well.
  mpquiet on
  cast 'weaken' $r
  mpquiet off
else
  mpecho The viper spits into your eyes! 
  mpechoat $r You can't see!!
  mpquiet on 
  cast 'blindness' $r
  mpquiet off
endif
endif
endif
~
