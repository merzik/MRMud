>speech_prog avilenna~
if quest(8,1,$n) == 1
  say Greetings, fellow guild member.  
  say Do you have any gold for me?
  smile
else
  if hasobjnum(14436)
    mpjunk golden
    mpecho The old woman holds the gold in the palms of her gnarled hands.
    mpecho The gold changes shape and shrinks in her grasp.
    look $n
    say I see the proper qualities of an alchemist
    say in your soul. I will administer the oath of the 
    say alchemists. If you take it, you will be a member of
    say the alchemist's guild and receive the symbol of our
    say organization as well as all of the benefits!
    say Do you swear allegiance to the Guild of Alchemists
    say of the Transcendental Empire of Gnomes? Do you 
    say guarantee your silence in all matters alchemical? 
    say Will you keep your knowledge of gold making secret 
    say from the outside world?
    say Please answer with either I ACCEPT or I DECLINE.
    if quest(7,1,$n) == 0
      mpmset $n quest 7 1 1
    endif
  else
    if quest(10, 3, $n) > 0
      look $n
      say I can tell you know much about alchemy.
      say Bring me some gold and I will teach you 
      say something marvelous.
    else
    endif
  endif
endif
~
>speech_prog accept~
if quest(7,1,$n)== 1
  mpmset $n quest 8 1 1
  smile
  mpoload 14400
  mpquiet on
  cast 'giant strength' $n
  mpquiet off
  give medallion $n
  shout Welcome to the alchemist's guild $n!  
  say Wear this medallion with pride and remember your oath.
  say It is more than just a symbol. 
  bow
  say Good luck in your experiments, fellow alchemist
else
  say Accept what?
endif
~
>speech_prog decline~
if quest(7,1,$n) == 1
 if quest(8, 1, $n) != 1 
  mpmset $n quest 10 3 0
  mpmset $n quest 7 1 0
  mpmset $n quest 0 2 0
  say I am sorry to hear that.  Please leave this house
  say I have stripped you of all you knowledge of alchemy 
  mpecho $I turns and looks away.
 else
 endif
else
endif
~
