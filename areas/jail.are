>rand_prog 20~
if rand(15)
  mpecho $I drops some lipstick.
  nudge $n
  say $n wanna bend over and pick that up for me?
else
  if rand(15)
    say Hey $n, you ever been to a Turkish prison??
  else
    if rand(15)
      say $n... do you like to hang out in gyms alot?
      wink
    else
      if rand(15)
        say You ever watch two dogs playin in the yard $n?
        lick
      else
        if rand(10)
          say What ye doin' in my cell, $n ? Get the hell out!
        else
          say Have you ever seen a grown man naked $n??
        endif
      endif
    endif
  endif
endif
mpquiet on
cast feast
mpquiet off
~
