>all_greet_prog 100~
if level($n) < 96
  say Blasphemy! This is sacred ground! BEGONE!
  mptransfer $n 9755
else
  say Greetings $n 
endif
~
>speech_prog p dispel~
if level($n) < 96
 say Bah!  Leave me alone mortal!
else
mpquiet on
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
cast "dispel magic" $n & cast "dispel magic" $n
mpquiet off
say Spells removed, Revered One
endif
~
>speech_prog p cursed~
if level($n) < 96
 say Bah!  Leave me alone mortal!
else
mpquiet on
cast "remove curse" $n & cast "remove curse" $n
cast "remove curse" $n & cast "remove curse" $n
cast "remove curse" $n & cast "remove curse" $n
cast "remove curse" $n & cast "remove curse" $n
mpquiet off
say Curses removed, Righteous One
endif
~
>speech_prog p spells~
if level($n) < 96
 say Bah!  Leave me alone mortal!
else
mpquiet on
cast "ethereal travel" $n & cast "astral projection" $n
cast "breath water" $n    & cast "enhanced revive" $n
cast "enhanced heal" $n   & cast "enhanced rest" $n
cast "giant strength" $n  & cast "remove curse" $n
cast sanctuary $n         & cast bless $n
cast armor $n             & cast shield $n
cast "mirror image" $n    & cast infravision $n
cast fly $n               & cast tongues $n
cast understand $n        & cast feast
cast "righteous fury" $n  & cast "benediction" $n
mpquiet off
say You're all spelled up, Revered One
endif
~
>speech_prog p restore~
if level($n) < 96
 say Bah!  Leave me alone mortal!
else
mpquiet on
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
cast 'heal' $n & cast 'heal' $n & cast 'heal' $n & cast 'heal' $n
mpquiet off
say You're all healed up, Revered One
endif
~
>speech_prog p uniform~
mpquiet on
cast "giant strength" $n
mpquiet off
if level($n) >= 96
 if whichgod($n) == 1
  mpquiet on
  mpoload 12000  & mpoload 12001 & mpoload 12002 & mpoload 12003  
  mpoload 12004  & mpoload 12005 & mpoload 12006 & mpoload 12007 
  mpoload 12008  & mpoload 12009 & mpoload 12010 & mpoload 12031
  mpoload 12032  & mpoload 12033 & mpoload 12034 & mpoload 12035
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  give i12000 $n & give i12001 $n & give i12002 $n & give i12003 $n
  give i12004 $n & give i12005 $n & give i12006 $n & give i12007 $n 
  give i12008 $n & give i12009 $n & give i12010 $n & give i12031 $n
  give i12032 $n & give i12033 $n & give i12034 $n & give i12035 $n
  mpquiet off
  if level($n) >= 96
    mpquiet on
    mpoload 12025
    give i12025 $n
   mpquiet off
  endif
  mpquiet on
  sacrifice all
  mpquiet off
 else
 if whichgod($n) == 2
  mpquiet on
  mpoload 12011  & mpoload 12012 & mpoload 12013 & mpoload 12014  
  mpoload 12015  & mpoload 12016 & mpoload 12017 & mpoload 12018  
  mpoload 12019  & mpoload 12020 & mpoload 12021 & mpoload 12027
  mpoload 12028  & mpoload 12029 & mpoload 12030 & mpoload 12036
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  c 'remove curse' & c 'remove curse' & c 'remove curse' & c 'remove curse'
  give i12011 $n & give i12012 $n & give i12013 $n & give i12014 $n 
  give i12015 $n & give i12016 $n & give i12017 $n & give i12018 $n 
  give i12019 $n & give i12020 $n & give i12021 $n & give i12027 $n
  give i12028 $n & give i12029 $n & give i12030 $n & give i12036 $n
  mpquiet off
  if level($n) >= 96
    mpquiet on
    mpoload 12026
    give i12026 $n
   mpquiet off
  endif
  mpquiet on
  sacrifice all
  mpquiet off
  endif
 endif
endif
