spells ether~
The presence of Order~
~
~
ACT_SMART|ACT_BODY|ACT_RACE
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_ETHEREAL
0 S
99 BODY_HEAD BODY_HEAD 1d1+9882 1d1+95
0 RACE_HUMAN
POS_STANDING POS_STANDING SEX_NEUTRAL
>greet_prog 100~
if whichgod($n) == 2
  cast 'earthquake'
  slay $n
endif
~
>rand_prog 50~
mpquiet on
if rand(25)
  cast 'sanctuary' $r
else
  if rand(33)
    cast 'enhanced revive' $r
  else
    if rand(50)
      cast 'giant strength' $r
    else
      cast 'enhanced heal' $r
    endif
  endif
endif
~
