>rand_prog 100~
if rand(45)
  cast 'protection' $r
else
  if rand(53)
    cast 'remove curse' $r
  else
    if rand(70)
      cast 'cure blind' $r
    else
      cast 'remove poison' $r
    endif
  endif
endif
if rand(50)
  mpgoto 12120
  mppurge $i
endif
~
