>all_greet_prog 55~
if quest(5, 4, $n) == 0
  if quest(0, 4, $n) == 12
    if quest(10, 3, self) == 0
      mpmload 15020
      mpmset self quest 10 3 1
      mpecho Rydall throws down his gauntlet, before speaking to you.
      mpforce rydallmob say I am Rydall, King of Marnhull and of all the lands
      mpforce rydallmob say east beyond the fairy mists to the Great Impassable.  
      mpforce rydallmob say I have come to seek your surrender, $n.  My army is set
      mpforce rydallmob say  to sweep through Landover like a plague and destroy 
      mpforce rydallmob say everything in its path.  You have no choice but to accept my
      mpforce rydallmob say challenge.
    endif
  endif
else
  if quest(5, 4, $n) == 2
    mpmload 15021
    mpecho A stony giant approaches the gate calling for $n.
    mpecho The giant attacks, swinging his club at your head!
    rescale 15021 $n 80
    mpforce stony mpkill $n
    mpmset $n quest 5 4 3
  endif
else
  if quest(5, 4, $n) == 4
    mpmload 15022
    mpecho You have to look twice when you see what looks like
    mpecho the paladin coming towards the castle gate.
    mpecho When you go out to meet him, he attacks!
    rescale 15022 $n 90
    mpforce paladin mpkill $n
    mpmset $n quest 5 4 5
  endif
else
  if quest(5, 4, $n) == 6
    mpmload 15023
    mpecho A man sized metal golem strides jerkily up to the gate.
    mpecho It attacks you immediately!
    rescale 15023 $n 100
    mpforce golem mpkill $n
    mpmset $n quest 5 4 7
  endif
else
  if quest(5, 4, $n) == 8
    mpmload 15024
    mpecho The largest worm you have ever seen slithers up and attacks!
    rescale 15024 $n 110
    mpforce wurm mpkill $n
    mpmset $n quest 5 4 9
  endif
else
  if quest(5, 4, $n) == 10
    mpmload 15025
    mpecho A humanoid creature walks smoothly up to the gate.
    mpecho The ardsheal finally locates you and attacks!
    rescale 15025 $n 120
    mpforce ardsheal mpkill $n
    mpmset $n quest 5 4 11
  endif
endif
~
>speech_prog accept challenge~
if quest(5, 4, $n) == 0
  if quest(10,3, self) == 1
    mpmset $n quest 5 4 2
    mpmset self quest 10 3 2
  endif
endif
~
>rand_prog 55~
if quest(5, 4, $r) == 12
  mpmload 15020
  mpecho Rydall rides up looking furious.
  mpmset $r quest 5 4 13
else
  if quest(10, 3, self) == 1
    mpmset self quest 10 3 0
    mpecho Rydall rides off seeking someone to accept his challenge.
    mppurge rydallmob
  endif
else
  if quest(10, 3, self) ==2
    mpmset self quest 10 3 0
    mpecho Rydall rides off, happy that you have accepted his challenge.
    mppurge rydallmob
  endif
else
  if quest(5, 4, $r) == 14
    mpmset self quest 10 3 0
  endif
endif
~
