#2853
ogre chieftan~
the Ogre chieftan~
An enormous ogre scowls at you.~
{070}He is a huge ogre with extraordinarily large muscles wearing a jumble
of clothes that while expensive looking do not go together at all.
~
ACT_RACE|ACT_BODY|ACT_SMART|ACT_STAY_AREA|ACT_SENTINEL|ACT_TRAIN|ACT_PRACTICE
AFF_TONGUES|AFF_UNDERSTAND 
-500 S
40 BODY_FOOT BODY_HAND|BODY_HEAD 1d1+1000 1d1+50
100000 RACE_OGRE
POS_STANDING POS_STANDING SEX_MALE
>greet_prog 100~
if race($n) == 7
  if quest(0, 2, $n) == 0
    say You! Do Job for me!
    say Bring head of Thain!
    say Wear this, You one of us now.
    mpoload 2850
    give i2850 $n
    drop i2850
    mpjunk all
    mpmset $n quest 0 2 1
  endif
else
  if race($n) == 1
    say Mmmmmmm,  Halfling
    emote rubs his belly and smiles.
    mpkill $n
  else
    say What you want?
  endif
endif
~
>all_greet_prog 0~
if class($n) == 6
  if quest(30, 1, $n) == 0
    shout I have banished a filthy assassin!
    mpmset $n quest 30 1 1
  else
    mptransfer $n 2899
    mpat $n mpforce $n say I am a loser!
    shout I have sent a backstabbing assassin to hell!
  endif
endif
~
>death_prog 100~
if race($n) == 7
else
  mpmset $n quest 2 2 1
  if actorhasobjnum(1116)
    if race($n) == 1
      mpoload 2861
    endif
  endif
endif
~
>give_prog i1115~
if race($n) == 7
  if quest(0, 2, $n) == 1
    say Good Job.
    mpoload 2860
    give i2860 $n
    say Now go away!
    mpjunk all
    mpmset $n quest 0 2 2
  else
    say Nice head, me full though.
  endif
else
  say Nice head, me full though.
endif
~
|
