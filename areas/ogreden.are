0 
-500 S
40 BODY_FOOT 0 1d1+1000 1d1+50
50000 RACE_OGRE
POS_STANDING POS_STANDING SEX_FEMALE
>greet_prog 100~
if race($n) == 7
  mpechoat $n The ogre grunts at you in recognition.
  mpechoaround $n The ogre grunts as it sees $n.
else
  if race($n) == 1
    growl $n
    mpkill $n
  else
    if quest(2, 2, $n) == 1
      growl $n
      mpkill $n
    endif
  endif
endif
~
>all_greet_prog 0~
if class($n) == 6
  if quest(30, 1, $n) == 0
    shout I have banished a filthy assassin!
    mpmset $n quest 30 1 1
  else
    mptransfer $n 2899
    mpat $n mpforce $n say I am a loser!
    shout I have sent a backstabbing assassin to hell!
  endif
endif
~
>death_prog 100~
if race($n) == 7
else
  mpmset $n quest 2 2 1
endif
~
>rand_prog 10~
if race($r) == 7
  if rand(20)
    cast sanctuary $r
  else
    if rand(20)
      cast 'giant strength' $r
    else
      if rand(20)
        cast bless $r
      else
        if rand(20)
          cast 'enhanced heal' $r
        else
          cast shield $r
        endif
      endif
    endif
  endif
endif
~
|
