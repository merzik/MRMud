>all_greet_prog 99~
 if quest (0,6,$n) == 0
   say The Lord does not wish any vistors.
   say Mind not to disturb him
   mpmset $n quest 0 6 1
else
   grumble
endif
~
>speech_prog feather~
 if quest(0,6,$n) == 15
   say What would you want with this old thing?
   say If you want it you have to do me a favor.
mpmset $n quest 0 6 16
   say Will you do me that favor?
endif
~
>speech_prog no~
   say Than you wont get the feather will you.
~
>speech_prog yes~
if quest(0,6,$n) == 16
   say I have noticed that the Master's concubine hasn't been busy of late.
   say Ask her if she is in need of some company.
   mpmset $n quest 0 6 17
endif
if quest(0,6,$n) == 19
   say Great! Whooo hooo!
   mpoload 2762
   give feather $n
   say Thanks $n I am gonna rock her realm.
   mpmset $n quest 0 6 20
endif
~
