if quest(0,5,self) == 1
   mpforce all help help_gorth
   say Sage, why are you bothering me?
   mpforce sage_mob say But Master it is important.
   say What is it sage.
   mpmset self quest 0 5 2
endif
~

>speech_prog peaceful~
if quest(0,6,$n) == 33
   shout Yesss..!!!!!
   say That is it $n
   say You truly are the answer!
   say Thank you, Take this.  I must pray.
   if class($n) == 0
      mpoload 2759
      give i2759 $n
      mpmset $n quest 0 6 34
      mptransfer $n 2750
      tell $n Thank you
   else
      if class($n) == 4
         mpoload 2759
         give i2759 $n
         mpmset $n quest 0 6 34
         mptransfer $n 2750
         tell $n Thank you
      else
         if class($n) == 1
         or class($n) == 7
            mpoload 2760
            give i2760 $n
            mpmset $n quest 0 6 34
            mptransfer $n 2750
            tell $n Thank you
         else
            if class($n) == 5
               mpoload 2760
               give i2760 $n
               mpmset $n quest 0 6 34
               mptransfer $n 2750
               tell $n Thank you
            else
               if class($n) == 2
                  mpoload 2761
                  give i2761 $n
                  mpmset $n quest 0 6 34
                  mptransfer $n 2750
                  tell $n Thank You
               else
                  if class($n) == 3
                     mpoload 2761
                     give i2761 $n
                     mpmset $n quest 0 6 34
                     mptransfer $n 2750
                     tell $n Thank You
                  else
                     if class($n) == 6
                        mpoload 2761
                        give i2761 $n
                        mpmset $n quest 0 6 34
                        mptransfer $n 2750
                        tell $n Thank You
                     endif
                  endif
               endif
            endif
         endif
      endif
   endif
endif
