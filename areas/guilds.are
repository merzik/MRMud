#30921
secretary~
The secretary~
The Adventurer's Guild secretary sits behind her desk here.~
She resembles yo' momma!~
ACT_SMART|ACT_SENTINEL|ACT_STAY_AREA
AFF_TONGUES|AFF_UNDERSTAND|AFF_DETECT_HIDDEN|AFF_DETECT_INVIS
0 S
95 0 0 1d1+9999 1d1+199
0 0
POS_STANDING POS_STANDING SEX_FEMALE
>give_prog i30914~
if hasobjnum(30914)
mpjunk i30914
if quest(0, 3, $n) != 1
  say You aren't a member of the Adventurer's Guild!  Cheater!
else
 if quest(6, 7, $n) == 75
   say You've already redeemed 75 tokens.
   mpcheatlog $n Cashing in adventurers token
 else
   mpmadd $n quest 6 7 1
   say Congratulations $n!
   say You win a spin on the Wheel of Adventure.  Good Luck!
   mpecho The wheel spins for a couple of seconds... then stops!
   if rand(5)
     mpforce $n HELP WHLADVTEMPHP
     say You just won 100 temporary hit points!
     mpmadd $n hp 100
   else
     if rand(15)
      mpforce $n HELP WHLADVTHREEPRACS
      say You just won 3 practices!
      mpmadd $n practice 3
    else
      if rand(10)
        mpforce $n HELP WHLADVFIVEPRACS
        say You just won 5 practices!
        mpmadd $n practice 5
      else
        if rand(15)
        and level($n) < 95
          mpforce $n HELP WHLADVEXP
          say You just won 1 million experience points!
          mpmadd $n exp 1000000
        else
          if rand(2)
            mpforce $n HELP WHLADVDEATH
            say You just won a 1-way ticket to hell!
            slay $n
          else
            if rand(10)
              mpforce $n HELP WHLADVSUPERWEAPON
              say You just won a temporary super-weapon!
              mpoload 30990
              mposet i30990 level 25
              mposet i30990 quest 0 4 15
              give weapon $n
              mpforce $n look weapon
            else
              if rand(25)
                mpforce $n HELP WHLADVLOTSGOLD
                say You just won 5 million gold coins!
                mpmadd $n gold 5000000
              else
                mpforce $n HELP WHLADVLITTLEGOLD
                say You just won 1 million gold coins!
                mpmadd $n gold 1000000
              endif
            endif
          endif
        endif
      endif
    endif
  endif
else
endif
endif~
|
