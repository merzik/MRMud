#30900
rabbit~
a rabbit~
A rabbit here searches for a new hiding spot.~
The rabbit would make a delicious meal.~
ACT_STAY_AREA
0
0 S
1 0 0 1d6+20 1d3+2
0 10
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 100~
if quest(0,4,self) == 0
  mpmset self quest 0 4 15
  break
endif
if quest(0,4,self) == 1
  mpecho The rabbit goes into hiding.
  mpgoto 2
  suicide 
else
  mpmadd self quest 0 4 -1
endif
~
>death_prog 100~
if actorhasobjnum(30901)
  mpoload 30906
endif
~
|
