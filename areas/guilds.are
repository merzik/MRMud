99 0 0 1d1+9999 1d1+99
0 838032
POS_STANDING POS_STANDING SEX_NEUTRAL
>all_greet_prog 100~
if quest(0, 3, $n) != 0
  mpforce $n HELP GUILDBOUNCE
  mptransfer $n 9776
  tell $n You already belong to a guild.  Come back in your next life.
endif
~
|
#30906
guide tour~
The tour guide~
The tour guide is here.~
The tour guide is ethereal.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_UNDERSTAND|AFF_TONGUES|AFF_ETHEREAL
0 S
99 0 0 1d1+9999 1d1+99
0 838032
POS_STANDING POS_STANDING SEX_NEUTRAL
>all_greet_prog 100~
if quest(0, 3, $n) != 0
  say You already belong to a guild.  You do not belong here.
  mptransfer $n 9755
else
  mpmset $n quest 3 3 0
endif
~
>speech_prog adv~
mptransfer $n 30902
mpat 30902 mpforce $n look
mpecho $n goes to read information on the adventurer's guild.
~
>speech_prog sur~
if level($n) < 25
  tell $n You must be level 25 to join the survivalist guild.
else
  mptransfer $n 30903
  mpat 30903 mpforce $n look
  mpecho $n goes to read information on the survivalist's guild.
endif
~
>speech_prog lwr~
if level($n) < 30
  tell $n You must be level 30 to join the league of the white rose.
else
  mpoload 30910
  give i30910 $n
endif
~
>speech_prog cbl~
if level($n) < 30
  tell $n You must be level 30 to join the circle of the black lotus.
else
  mpoload 30911
  give i30911 $n
endif
~
>speech_prog psi~
if level($n) < 65
  tell $n You must be level 65 to join the psionicist's guild.
else
  mptransfer $n 30906
  mpat 30906 mpforce $n look
  mpecho $n goes to read information on the psionicist's guild.
endif
~
>speech_prog ojk~
if level($n) < 36
  tell $n You must be level 36 to join the order of the jagged knife.
else
  mpoload 30913
  give i30913 $n
endif
~
|
#30907
mike adventurer~
Mike~
Mike the adventurer is here wondering if you wish to join the guild.~
Mike is tall, and strong, and has seen many wondrous places since
joining the adventurer's guild.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_UNDERSTAND|AFF_TONGUES
0 S
99 0 0 1d1+9999 1d1+99
0 838032
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 10~
say Do you wish to join the adventurer's guild?
~
>speech_prog p yes~
say Then say: I wish to join the adventurer's guild.
~
>speech_prog p no~
mpmset $n quest 3 3 0
mptransfer $n 30901
tell $n See ya later then.
~
>speech_prog p I wish to join the adventurer's guild.~
if quest(3,3,$n) == 0
  mpmset $n quest 3 3 1
  say Then you must take the oath.  Repeat after me:
  say I swear to dedicate myself to a life of adventure.
endif
~
>speech_prog p I swear to dedicate myself to a life of adventure.~
if quest(3,3,$n) == 1
  mpmset $n quest 3 3 2
  say I believe that power comes from the deaths of enemies.
endif
~
>speech_prog p I believe that power comes from the deaths of enemies.~
if quest(3,3,$n) == 2
  mpmset $n quest 3 3 3
  say I will always defend myself when threatened.
endif
~
>speech_prog p I will always defend myself when threatened.~
if quest(3,3,$n) == 3
  mpmset $n quest 3 3 4
  say I shall never reject money or glory, so help me gods.
endif
~
>speech_prog p I shall never reject money or glory, so help me gods.~
if quest(3,3,$n) == 4
  mpmset $n quest 0 3 1
  echo $n has taken the oath and joined the Adventurer's Guild!
  mpquiet on
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'remove curse' $n
  cast 'giant strength' $n
  mpquiet off
  mpgoto 30999
  mptransfer $n
