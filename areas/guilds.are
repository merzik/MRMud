  mpmset self quest 0 5 31
else
  if quest(0,5,self) == 1
    mpecho The holy servant can stay in your plane no longer.
    mpecho The holy servant vanishes.
    mpquiet on
    north
    south
    east
    west
    up
    down
    mpquiet off
    mpgoto 2
    mpmset self quest 0 5 0
    mpmset self quest 5 1 0
    mpmset self quest 6 1 0
    suicide 
  else
    mpmadd self quest 0 5 -1
  endif
endif
~
>speech_prog p servant, all spells please~
if actorhasobjnum(30915)
or actorhasobjnum(30975)
or actorhasobjnum(30974)
or actorhasobjnum(30973)
  if position($n) == 6
    say I cannot fully spell you while you are fighting.
  else
    mpquiet on
    cast 'feast'
    cast 'sanctuary' $n
    cast 'bless' $n
    cast 'giant strength' $n
    cast 'enhanced heal' $n
    cast 'enhanced revive' $n
    cast 'enhanced rest' $n
    cast 'armor' $n
    cast 'shield' $n
    mpquiet off
    say You are fully spelled, $n.
    mpmadd self quest 0 5 -15
    if quest(0,5,self) <= 1
      mpecho The holy servant can stay in your plane no longer.
      mpecho The holy servant vanishes.
      mpquiet on
      north
      south
      east
      west
      up
      down
      mpquiet off
      mpgoto 2
      mpmset self quest 0 5 0
      mpmset self quest 5 1 0
      mpmset self quest 6 1 0
      suicide 
    endif
  endif
else
  tell $n I don't take orders from you.
endif
