    cast armor $n
    cast refresh $n
    cast 'heal' $n
    cast 'heal' $n
    cast 'heal' $n
    mpquiet off
    mpechoat $n You feel an incredible blast of energy.
    mpmadd self quest 0 5 -10
    if quest(0,5,self) <= 1
      mpecho The winged serpent flies off.
      mpgoto 2
      mpmset self quest 0 5 0
      mpmset self quest 5 1 0
      mpmset self quest 6 1 0
      suicide 
    endif
  endif
else
  tell $n Leave me alone!
  snarl $n
endif
~
>death_prog 100~
mpmset self quest 6 1 0
~
|
#30999
storm psionicstorm~
a psionic storm~
A psionic storm is brewing here.~
The psionic storm seems to be growing in size and power.  It would be wise
to evacuate the room as soon as possible.~
ACT_SENTINEL|ACT_SMART|ACT_ONE_FIGHT
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_UNDERSTAND
0 S
65 0 0 1d1+4999 1d85+15
0 0
POS_STANDING POS_STANDING SEX_NEUTRAL
>rand_prog 100~
if quest(0, 3, self) == 0
  mpmset self quest 0 3 7
else
  mpmadd self quest 0 3 -1
  mpecho The psionic storm grows in intensity.
endif
if quest(0,3,self) == 2
  mpecho It would be wise to leave before the storm erupts.
endif
if quest(0,3,self) == 1
  if rand(45)
  and level($r) < 65
    mpechoaround $r The psionic storm hurls $r across the realm!
    mpechoat $r The psionic storm hurls you across the realm!
    mpquiet on
    cast 'chill touch' $r
    cast 'curse' $r
    mpgorand 17000 17725 0 1
    mptransfer $r
    mpforce $r look
    cast 'stability' $r
    mpquiet off
    mpgoto 2
    mpmset self quest 0 3 0
    suicide
  else
    mpecho The psionic storm rains fireballs!
    mpquiet on
    cast earthquake
    cast earthquake
    cast earthquake
    cast earthquake
    mpquiet off
    mpgoto 2
    mpmset self quest 0 3 0
    suicide
    break
  endif
endif~
>fight_prog 100~
if quest(3, 1, self) == 0
  mpmset self quest 3 1 1
  rescale 30999 $n 100
endif
if actorhasobjnum(30917)
  mpecho The psionic storm vanishes.
  mpgoto 2
  suicide
endif~
>death_prog 100~
mpmset self quest 0 3 0
mpmset self quest 3 1 0~
