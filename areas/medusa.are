58 BODY_CLAW BODY_MOUTH|BODY_EYE|BODY_ARM|BODY_HAND|BODY_FOOT 1d1+2408 1d1+39
80878 344679
POS_STANDING POS_STANDING SEX_FEMALE
>fight_prog 10~
if rand(30)
  cackle 
else
  if rand(30)
    fume 
  else
    curse
  endif
endif
~
>fight_prog 20~
if rand(20)
  cast 'earthquake'
else
  if rand(20)
    cast 'curse' $n
  else
    if rand(20)
      cast 'energy drain' $n
    else
      if rand(20)
        cast 'flamestrike'$n
      else
        cast 'lightning bolt' $n
      endif
    endif
  endif
endif
~
|
