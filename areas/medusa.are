#11006
Slave~
Slave of Chaos~
A half snake, half man, creature slithers here praying to Chaos.~
This is a slave for all Chaos members.  He will serve any Chaos member.~
ACT_SENTINEL|ACT_SMART|ACT_NO_ORDER|ACT_BODY
AFF_DETECT_INVIS|AFF_DETECT_MAGIC|AFF_DETECT_HIDDEN|AFF_SANCTUARY|AFF_UNDERSTAND|AFF_TONGUES
0 S
95 BODY_HAND BODY_HEAD|BODY_TORSO|BODY_ARM|BODY_TAIL|BODY_HAND 2d500+8000 1d1+77
232588 RACE_HUMAN
POS_STANDING POS_STANDING SEX_NEUTRAL
>greet_prog 99~
if whichgod($n)!=2
  say You must follow Chaos to stay in this room!
  wave $n
  mptransfer $n 9755
else
  say Bring me the head of Medusa I will enchant it for you.     
  smile $n
endif
~
>give_prog I11001~
if whichgod($n) != 2
  say So, you slayed Medusa.  That is good.
  say You do not follow Chaos though.  That is bad.
  mpjunk i11001
else
  emote utters the words 'gnol evil soahc'
  mpjunk I11001
  mpoload 11009 60            
  give I11009 $n
  mpjunk I11009
  say Do not let it fall into the wrong hands.
endif
~
>death_prog 100~
if actorhasobjnum(30900)
  if quest(30,1,$n) == 0
    mpmset $n quest 30 1 1
    mpoload 30914
    mpforce $n HELP GUILDTOKEN
    mpquiet on
    c 'giant strength' $n
    give i30914 $n
    mpquiet off
  endif
endif~
|
#11007
Blind Witch~
A Blind Witch~
An old hag is here.~
You see an ugly hag.  This witch is one of three sisters.~
ACT_SENTINEL|ACT_BODY|ACT_SMART
AFF_SANCTUARY|AFF_CURSE|AFF_UNDERSTAND
-1000 S
58 BODY_CLAW BODY_MOUTH|BODY_LEG|BODY_ARM|BODY_HAND|BODY_FOOT 1d1+2408 1d1+39
80878 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>all_greet_prog 100~
if quest(0, 3, $n) == 0
  if isgood($n)
    say Die Bane of evil!
    mpkill $n
  else
    say Greetings Evil one!
    say My sisters and I have a task for you.
    say Bow down to me!
    mpmset $n quest 0 3 1
  endif
else
  if quest(0, 3, $n) == 1
    say If you will not bow, then you will die!
    mpkill $n
  else
    if quest(0, 3, $n) == 2
      if quest(3, 5, $n) == 31
        say You have done well, $n.
        say Here is your reward.
        mpoload 11013
        give i11013 $n
        mpoload 11014
        give i11014 $n
        mpmset $n quest 0 3 3
      endif
    endif
  endif
endif
~
>social_prog bow~
if quest(0, 3, $n) == 1
  if isgood($n)
  else
    say It has been too long since all of the Shrines
    say of evil have been tended.  Take this and pray
    say at the 5 evil shrines in the region.
    mpoload 11012
    give i11012 $n
    mpmset $n quest 0 3 2
  endif
endif
~
>fight_prog 10~
if rand(30)
  cackle 
else
  if rand(30)
    fume 
  else
    curse
  endif
endif
~
>fight_prog 20~
if rand(20)
  cast 'earthquake'
else
  if rand(20)
    cast 'curse' $n
  else
    if rand(20)
      cast 'energy drain' $n
    else
      if rand(20)
        cast 'flamestrike'$n
      else
        cast 'lightning bolt' $n
      endif
    endif
  endif
endif
~
|
