100000 RACE_DROW
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 50~
if ispc($n)
  if armystatus($n) == 0
     mpechoat $n Type <ARMY JOIN password> here to join the Drow Army.
  endif
  if sex($n) == 2
    mpforce $n grovel
    emote looks at you deprecatingly...
    snicker $n
    break
  else
    mpforce $n grovel
    say What are you looking at?
    emote Stares at you with his steely eyes.
    say Shut your mouth and go hunt those pesky gnome scums!
    mpecho Two guard immediately shove you out of this room.
    mptransfer $n 16310 
    break
  endif
endif
~
