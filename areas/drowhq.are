        mpmadd $n gold -5000000
        mpmadd $n exp -1000000
        mpmset $n quest 7 2 2
        mpgoto $2
        mpforce $2 stand
        mpmload 16312
        mpforce $2 wake
        mpforce $2 say Who goes there!?
        mppurge $i
