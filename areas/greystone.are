>greet_prog 99~
if actorhasobjnum(33062)
  say Have you fulfilled your orders yet?
endif
~
>rand_prog 15~
if quest(3,9,$r) == 5
  smile
else
  say Greetings Traveller...!
  say Would you be interested in joining our order!
  mpmset $n quest 3 9 0
endif
~
>speech_prog order~
if quest(3,9,$n) == 0
  say Why yes the Order of the Forest Runners!
  mpmset $n quest 3 9 1
endif
~
>speech_prog p forest runners~
if quest(3,9,$n) == 1
  say Yes, we are an order dedicated to protecting the forests!
  say Would you like me to sign you up?
  mpmset $n quest 3 9 2
endif
~
>speech_prog p sign me up~
if quest(3,9,$n) == 2
  say Excellent....
  say You must complete a task first in order to be a member!
  mpmset $n quest 3 9 3
endif
~
>speech_prog task~
if quest(3,9,$n) == 3
  say Why yes...
  say You can start by retrieving the most vital ORGAN on one of the Forest Defilers Bodies!
  say Let me assign you your papers.
  mpoload 33062
  give i33062 $n
  say There you go, now get hurry...
  say The Spirits of the forest need your help!
  mpmset $n quest 3 9 4
endif
~
>give_prog I33061~
mpjunk i33061
if quest(3,9,$n) == 4
  say The head is Excellent yes, but NOT an organ!
  say Here is a reward for your troubles!
  mpecho Per'tano hands you some gold!
  mpmadd $n gold 5000
else
  if quest(3,9,$n) == 5
    say Very Good Forest Runner!
    say Your rewards have been doubled!
    mpecho Per'tano hands your some gold!
    mpmadd $n gold 10000
  endif
endif
~
>give_prog I33064~
mpjunk i33064
if quest(3,9,$n) == 4
  say Good but still NOT an organ!
  say Here is a reward for your troubles!
  mpecho Per'tano hands you some gold!
  mpmadd $n gold 10000
else
  if quest(3,9,$n) == 5
    say Very Good Forest Runner!
    say Your rewards have been doubled!
    mpecho Per'tano hands your some gold!
    mpmadd $n gold 20000
  endif
endif
~
>give_prog I33063~
mpjunk i33063
if quest(3,9,$n) == 4
  say Excellent you have proven yourself worthy!
  mpoload 33060
  give i33060 $n
  mpmset $n long (Forest Runner) $n is here watching over the forests
  mpjunkperson $n i33062
  mpmset $n quest 3 9 5
else
  if quest(3,9,$n) == 5
    say Very Good Forest Runner!
    say Your rewards have been doubled!
    mpecho Per'tano hands your some gold!
    mpmadd $n gold 150000
  endif
endif
~
