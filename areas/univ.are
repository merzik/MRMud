>give_prog I19830~
if quest(2,1,$n) == 0
  if quest(1,1,$n) == 1
    tell $n Thank you.
    mpoload 19831
    mpechoat $n The registrar turns and fills out a transcript.
    give transcript $n
    tell $n Good, now that part of my job is finished.
    tell $n Ok, now you need to go see the Dean.
    mpechoat $n She starts to turn around but then looks back.
    tell $n Go on, go to the Dean's office!
    tell $n Knock before you enter, though.....
    tell $n He wont answer you if you dont.
    mpjunk report
    mpmadd $n quest 2 1 1 
  endif
else
  mpjunk report
  tell $n Why are you bringing me this again?
  tell $n I already gave you your transcript!
endif
