AFF_STEALTH
0 S
95 0 0 1d1+22320 1d1+140
0 RACE_DROW
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(24,1,$n)==1
  mpecho The assassin guard says 'I told you not to return!'
  mpkill $n
else
  if class($n)==2
    mpechoat $n The assassin guard tells you 'Welcome.  The Guildmaster is waiting.'
  else
    if class($n)==6
      mpechoat $n The assassin guard tells you 'Welcome.  The Guildmaster is waiting.'
    else
      mpechoat $n The assassin guard tells you 'You are not permitted to enter the secret guild.'
      mpmset $n quest 24 1 1
      mptransfer $n 19812
      mpat $n mpecho The assassin guard says 'And don't come back, lest you risk death.'    
    endif
  endif
endif
~
|
