>speech_prog p Hello~
if quest(3,1,$n) == 0
  if quest(2,1,$n) == 1
    say Well, well, well.
    chuckle 
    say So you are ready to graduate, eh?
    mpecho The Dean looks at you quizically.
    say I assume you have your transcript?
  endif
endif
~
>give_prog I19831~
if quest(3,1,$n) == 0
  if quest(2,1,$n) == 1
    mpecho The Dean looks over your transcript.
    say You have completed your requirements for graduation.
    say However, I do not have the authority to give you your diploma.
    say Go speak to the chancellor, and he will give it to you.
    mpecho The Dean reaches for the phone.
    say I will phone the Chancellor and let him know you are on your way over.
    if isaffected($n)==SPELL_SANCTUARY
    else
      say Before you go, I can do one thing for you.
      mpecho The Dean lifts his hands and a bright light glows.
      mpquiet on
      cast sanctuary $n
      mpquiet off
    endif
    mpjunk transcript
    mpmadd $n quest 3 1 1
  endif
else
  mpjunk transcript
  say I already gave the Chancellor your name.
  say Just go see him for you diploma.
endif
mptransfer $n 19931
mpat $n mpforce $n look
~
