#4310
mournermob~
a mourner~
A mourner is here.~
She is dressed in black and wears a veil.~
ACT_RACE|ACT_BODY|ACT_SENTINEL|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND 0 S
50 BODY_HAND|BODY_HEAD 0 1d1+1039 1d1+32
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>rand_prog 100~
  if quest(0, 5, self) == 0
    sniff
    mpforce pallbearermob comfort mournermob
    mpmset self quest 0 5 1
  else
    if quest(0, 5, self) == 1
      mpforce pallbearermob east
      east
      mpmset self quest 0 5 2
    else
      if quest(0, 5, self) == 2
        mpforce pallbearermob north
        north
        mpmset self quest 0 5 3
      else
        if quest(0, 5, self) == 3
          mpforce pallbearermob north
          north
          mpmset self quest 0 5 4
        else
          if quest(0, 5, self) == 4
            mpforce pallbearermob north
            north
            mpmset self quest 0 5 5
          else
            if quest(0, 5, self) == 5
              mpforce pallbearermob north
              north
              mpmset self quest 0 5 6
            else
              if quest(0, 5, self) == 6
                mpforce pallbearermob north
                north
                mpecho The pallbearer sets the coffin down on the altar.
                mpmset self quest 0 5 7
              else
                if quest(0, 5, self) == 7
                  mpforce priest say We are gathered here to mourn the loss of someone dear to us.
                  mpecho Mourners file past viewing the body one last time.
                  mpmset self quest 0 5 8
                else
                  if quest(0, 5, self) == 8
                    mpecho The priest blesses the dead man as the lid is set on the coffin.
                    sniff
                    mpmset self quest 0 5 9
                  else
                    if quest(0, 5, self) == 9
                      mpecho The pallbearer picks up the coffin.
                      mpforce pallbearermob south
                      south
                      mpmset self quest 0 5 10
                    else
                      if quest(0, 5, self) == 10
                        mpforce pallbearermob south
                        south
                        mpmset self quest 0 5 11
                      else
                        if quest(0, 5, self) == 11
                          mpforce pallbearermob south
                          south
                          mpmset self quest 0 5 12
                        else
                          if quest(0, 5, self) == 12
                            mpforce pallbearermob south
                            south
                            mpmset self quest 0 5 13
                          else
                            if quest(0, 5, self) == 13
                              mpforce pallbearermob south
                              south
                              mpmset self quest 0 5 14
                            else
                              if quest(0, 5, self) == 14
                                mpforce pallbearermob east
                                east
                                mpmset self quest 0 5 15
                              else
                                if quest(0, 5, self) == 15
                                  mpforce pallbearermob east
                                  east
                                  mpmset self quest 0 5 16
                                else
                                  if quest(0, 5, self) == 16
                                    mpforce pallbearermob east
                                    east
                                    mpmset self quest 0 5 17
                                  else
                                    if quest(0, 5, self) == 17
                                      mpforce pallbearermob mpgoto 4350
                                      mpgoto 4350
                                      mpforce gravediggermobone say We better get outta here, funeral is comin.
                                      mpecho The two diggers pick up their shovels and leave.
                                      mppurge gravediggermobone
                                      mppurge gravediggermobtwo
                                      mpmset self quest 0 5 18
                                    else
                                      if quest(0, 5, self) == 18
                                        mpecho The pallbearer gently settles the coffin into the open grave.
                                        cry
                                        mpmset self quest 0 5 19
                                      else
                                        if quest(0, 5, self) == 19
                                          mpareaecho The bells ring in mourning.
                                          mpecho As the Mourners leave, two men begin to fill in the grave.
                                          mpmload 4311
                                          mpmload 4312
                                          mpquiet on
                                          mpoload 4309
                                          mppurge i4308
                                          mpoload 4308 
                                          put i4309 grave
                                          mpquiet off
                                          mpmset gravediggermobone quest 0 3 0
                                          mpmset gravediggermobtwo quest 0 3 7
                                          mpmset self quest 0 5 0
                                          mppurge pallbearermob
                                          mppurge $i
                                        endif
                                      endif
                                    endif
                                  endif
                                endif
                              endif
                            endif
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~
|

#4311
sam digger gravediggermobone sammob diggermob~
Sam the Gravedigger~
A grave digger is here.~
He is dressed in black and carries a shovel, but the black could just be
very dirty clothes.~
ACT_RACE|ACT_BODY|ACT_SENTINEL|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND 0 S
50 BODY_HAND|BODY_HEAD 0 1d1+1039 1d1+32
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 100~
  if quest(0, 3, self) == 0
    mpecho The grave diggers continue to shovel dirt into the grave.
    mpmset self quest 0 3 1
  else
    if quest(0, 3, self) == 1
      say Shame about the old guy, but he had it comin'.
      mpmset self quest 0 3 2
    else
      if quest(0, 3, self) == 2
        mpforce gravediggermobtwo say He did? Why's that?
        mpecho The grave is half full.
        mpmset self quest 0 3 3
      else
        if quest(0, 3, self) == 3
          say He's been sleepin' around on his wife for years.
          say An', what's worse, he did it with married women.
          mpmset self quest 0 3 4
        else
          if quest(0, 3, self) == 4
            mpecho Joe whistles loudly at that.
            mpforce gravediggermobtwo say If I'da knowed that,
            mpforce gravediggermobtwo say  I could'a made some money on tha side.
            mpmset self quest 0 3 5
          else
            if quest(0, 3, self) == 5
              mpecho Sam grins happily.
              say I DID make some money on the side.
              mpecho The grave is filled in now.
              mppurge i4308
              mpmset self quest 0 3 6
            else
              if quest(0, 3, self) == 6
                mpforce gravediggermobtwo say Well then! I think you owe me a drink!
                mpecho The two grave diggers hoist their shovels onto their shoulders and leave.
                mpmset self quest 0 3 7                
                mppurge gravediggermobtwo
                mppurge $i
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~
|

#4312
joe digger gravediggermobtwo diggermob~
Joe the Gravedigger~
A grave digger is here.~
He is dressed in black and carries a shovel, but the black could just be
very dirty clothes.~
ACT_RACE|ACT_BODY|ACT_SENTINEL|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND 0 S
50 BODY_HAND|BODY_HEAD 0 1d1+1039 1d1+32
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 100~
  if quest(0, 3, self) == 0
    mpecho The two grave diggers begin to dig.
    mpmset self quest 0 3 1
  else
    if quest(0, 3, self) == 1
      say You know who's gettin' buried today?
      mpmset self quest 0 3 2
    else
      if quest(0, 3, self) == 2
        mpforce gravediggermobone say Not real sure.
        mpforce gravediggermobone say I did hear some rich merchant's wife
        mpforce gravediggermobone say died recently though.
        mpmset self quest 0 3 3
      else
        if quest(0, 3, self) == 3
          mpquiet on
          mpoload 4308
          mpquiet off
          mpecho Quite a hole has been opened in the ground now.
          say How'd she die?
          mpmset self quest 0 3 4
        else
          if quest(0, 3, self) == 4
            mpforce gravediggermobone say I heard she had a disease that some
            mpforce gravediggermobone say fool adventurer failed to cure.
            mpmset self quest 0 3 5
          else
            if quest(0, 3, self) == 5
              wince
              say They must have been chased out of town fast.
              mpmset self quest 0 3 6
            else
              if quest(0, 3, self) == 6
                mpecho The two diggers continue digging as they chat about this and that.
                mpmset self quest 0 3 7
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~
|

