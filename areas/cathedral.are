#4314
bridemob~
the bride~
The bride stands here.~
She is dressed in black and carries a ring.~
ACT_RACE|ACT_BODY|ACT_SENTINEL|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND 0 S
50 BODY_HAND|BODY_HEAD 0 1d1+1039 1d1+32
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>speech_prog p i object~
  mpmset self quest 0 4 15
  if sex($n) == 1
    say This is no time to get revenge for jilting you!
  else
    mpforce groommob say This is no time to get revenge for jilting you!
  endif
  mpforce groommob mpkill $n
  mpkill $n
~
>give_prog i3372~
  if quest(5, 1, $n) == 0
    mpecho The bride whispers thanks and hands you her replacement ring.
    mpjunk all
    mpoload 4311
    give i4311 $n
    mpmset $n quest 5 1 1
  endif
~
>time_prog 0~
  mppurge $i
~
>rand_prog 100~
  if quest(0, 4, self) == 0
    mpasound You hear the wedding march being played nearby.
    mpecho The bride takes a deep breath before moving.
    mpecho You hear the wedding march being played.
    mpat groommob mpecho You hear the wedding march being played.
    speed walk
    north
    mpmset self quest 0 4 1
  else
    if quest(0, 4, self) == 1
      mpat groommob mpecho The groom fidgets as he waits for his bride
      mpasound You hear the wedding march being played nearby.
      mpecho You hear the wedding march being played.
      mpat groommob mpecho You hear the wedding march being played.
      mpmset self quest 0 4 2
      north
    else
      if quest(0, 4, self) == 2
        mpat groommob mpecho The groom fidgets as he waits for his bride
        mpasound You hear the wedding march being played nearby.
        mpecho You hear the wedding march being played.
        mpat groommob mpecho You hear the wedding march being played.
        mpmset self quest 0 4 3
        north
      else
        if quest(0, 4, self) == 3
          mpat groommob mpecho The groom fidgets as he waits for his bride
          mpasound You hear the wedding march being played nearby.
          mpecho You hear the wedding march being played.
          mpat groommob mpecho You hear the wedding march being played.
          mpmset self quest 0 4 4
          north
        else
          if quest(0, 4, self) == 4
            mpat groommob mpecho The groom fidgets as he waits for his bride
            mpasound You hear the wedding march being played nearby.
            mpecho You hear the wedding march being played.
            mpat groommob mpecho You hear the wedding march being played.
            mpmset self quest 0 4 5
            north
          else
            if quest(0, 4, self) == 5
              mpecho The bride and groom face the priest as he begins.
              mpforce priest say We are gathered today to join this man and woman in matrimony.
              mpmset self quest 0 4 6
            else
              if quest(0, 4, self) == 6
                mpecho The priest turns to the groom.
                mpforce priest say Do you take this woman as your lawfully wedded
                mpforce priest say love slave for good?
                mpmset self quest 0 4 13
              else
                if quest(0, 4, self) == 13
                  mpforce priest say Does anyone object to these two being married?
                  mpecho The priest pauses waiting for a response.
                  mpmset self quest 0 4 14
                else
                  if quest(0, 4, self) == 14
                    mpmset self quest 0 4 7
                  else
                    if quest(0, 4, self) == 7
                      mpforce groommob say I do.
                      mpecho The groom places a ring on the bride's finger.
                      mpmset self quest 0 4 8
                    else
                      if quest(0, 4, self) == 8
                        mpecho The priest turns to the bride.
                        mpforce priest say Do you take this man as your lord and master forever?
                        mpmset self quest 0 4 9
                      else
                        if quest(0, 4, self) == 9
                          say I do.
                          mpecho The bride places a ring on the groom's finger.
                          mpmset self quest 0 4 10
                        else
                          if quest(0, 4, self) == 10
                            mpforce priest say I now pronounce you man and wife.
                            mpforce priest say You may kiss your bride.
                            mpmset self quest 0 4 11
                          else
                            if quest(0, 4, self) == 11
                              mpecho The groom softly kisses his new wife.
                              mpareaecho The bells sound to celebrate a wedding.
                              mpmset self quest 0 4 12
                            else
                              if quest(0, 4, self) == 12
                                mpecho The bride and groom run quickly out of the cathedral toward their honeymoon.
                                mpmset self quest 0 4 0
                                mppurge groommob
                                mpat ringbearermob mpecho The ring bearer leaves after the wedding party has left.
                                mpat ringbearermob mppurge ringbearermob
                                mppurge $i
                              endif
                            endif
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~
|

