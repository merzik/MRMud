  mpechoat $n You swim in a direction that appears to be upward.
  mpechoaround $n $n swims up.
  mptransfer $n 31295
else
if inroom($n)==28897
else
  if quest(6,1,$n)==1
    mpechoat $n You are trying to get your bearings.  Be patient.
  else
  if quest(6,1,$n)==0
    mpechoat $n You switch directions...
  endif
  endif
endif
endif
mpmset $n quest 6 1 1
~
