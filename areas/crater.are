   else
    if quest(0,4,$n)==5
     bow $n
     say Greetings, 1st Lieutenant $n.
    else
     if quest(0,4,$n)==6
      bow $n
      say Greetings, Captain $n.
     else
      if quest(0,4,$n)==7
       bow $n
       say Greetings, Major $n.
      else
       if quest(0,4,$n)==8
        bow $n
        say Greetings, Lt. Colonel $n.
       else
        if quest(0,4,$n)==9
         bow $n
         say Greetings, Colonel $n.
        else
         if quest(0,4,$n)==10
          bow $n
          say Greetings, General $n.
         endif
        endif
       endif
      endif
     endif  
    endif
   endif
