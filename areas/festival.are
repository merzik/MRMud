>greet_prog 100~
  if quest (7,3,$n) == 0
    say The master thought you might be visiting us but
    say he does not have time to waste on foolish mortals.
    say We have been given instructions to make certain
    say you are worthy of his attention.
    say To proceed, simply state the direction in which
    say you wish to move.  But be warned, I won't stand
    say for many incorrect attempts.
  endif
  if quest (7,3,$n) == 5
    say The master left instructions to send you to him.
    mptransfer pcs 37333
  endif
~
>speech_prog south~
  mpmset self quest 0 1 1
  say Excellent choice.
  say Maybe you are worthy after all.
  say Unfortunately I can't just let you leave.
  mpkill $n
~
>speech_prog north east west~
  if quest (7,3,$n) == 5
    mptransfer pcs 37333
    break
  endif
  if quest (7,3,$n) == 2
    say You are not worthy of the master's time.
    mpmset $n quest 7 3 0
    mptransfer pcs 37453
    break
  endif
  if quest (7,3,$n) == 1
    say That is your second wrong choice.
    say I haven't the time for your pitiful attempts.
    mpmset $n quest 7 3 2
    break
  endif
  if quest (7,3,$n) == 0
    say That is your first wrong choice.
    say Choose carefully from now on.
    mpmset $n quest 7 3 1
    break
  endif
~
>death_prog 100~
  if quest (0,1,self) < 1
    say Killing me is not the way.
  endif
  if quest (0,1,self) > 0
    say You may proceed.
    mpmset self quest 0 1 0
    mptransfer pcs 37334
  endif
~
|

