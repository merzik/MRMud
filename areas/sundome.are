#11603
sa'ar high priest~
Sa'ar~
Sa'ar is here, sitting by his desk.~
Sa'ar is the current High Priest of the Sun Dome. It is rumored that he has
never been beaten in combat.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY
AFF_DETECT_INVIS|AFF_SANCTUARY|AFF_INFRARED
1000 S
95 BODY_HEAD|BODY_TORSO|BODY_LEG|BODY_ARM 0 1d1+24999 1d20+120
100000 780605
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 99~
if whichgod($n) == 2
  mppurge guard
  mppurge guard
  mppurge guard
  shout Infidel!
  shout Guards! Guards!
  say DIE skum!
  mpkill $n
  mpecho A Sun Dome Templar arrives briskly.
  mpmload 11602
  mpecho A Sun Dome Templar arrives briskly.
  mpmload 11602
  mpecho A Sun Dome Templar arrives briskly.
  mpmload 11602
  mpforce templar mpkill $r
endif
~
>fight_prog 80~
if rand(50)
  cast 'acid blast' 
else
  if rand(40)
    knife 
  else
    if rand (30)
      kick 
    else
      if rand (10)
        cast 'faerie fire' 
      else
        mpecho A Sun Dome Templar arrives briskly.
        mpmload 11602
        mpforce templar mpkill $r
      endif
    endif
  endif
endif
~
