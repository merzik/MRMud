50000 468961
POS_STANDING POS_STANDING SEX_MALE
>greet_prog 99~
if whichgod($n) == 2
  mpkill $n
endif
~
>fight_prog 10~
if rand(40)
  kick 
else
  if rand(20)
    mpecho The Sun Dome Templar bashes you with his shield!
  else
    if rand(10)
      mpecho The Sun Dome Templar trips you and you go down!
    endif
  endif
endif
~
