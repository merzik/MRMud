-1000 S
55 0 0 1d1+1600 4d12+20
0 315851
POS_STANDING POS_STANDING SEX_NEUTRAL
>all_greet_prog 100~
mpechoat $n You feel that you're being scanned.
if whichgod($n) == 1
  say You seem to be a friend of the realm, $n. 
  say You may proceed.
  mpoload 11603
  unlock gate
  open gate
  mpjunk all
else
  if whichgod($n) == 2
    shout Infidel!
    say You have the foul stain of chaos upon you! 
    say You cannot pass.
    mpoload 11603
    close gate
    lock gate
    mpjunk all
    mpmload I11636
    mpecho A black hole opens in space and time and a wraith steps out.
    mpforce wraith mpkill $n
  else
    say $n may pass.
    mpoload 11603
    unlock gate
    open gate
    mpjunk all
  endif
endif
~
|
