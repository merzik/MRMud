>rand_prog 85~
if rand(5)
  emote utters the word, 'otserp'
else
  if rand(5)
    emote utters the word, 'flodnag'
  else
    if rand(5)
      emote utters the word, 'otsejam'
    endif
  endif
endif
mpquiet on
if rand(10)
  cast bless $r
else
  if rand(10)
    cast armor $r
  else
    cast 'cure light' $r
  endif
endif
