This gnome soldier sure doesn't look that tough.~
ACT_NO_ORDER|ACT_SCAVENGER|ACT_SMART|ACT_BODY|ACT_RACE
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_UNDERSTAND|AFF_TONGUES
0 S
1 BODY_LEG|BODY_ARM BODY_LEG|BODY_ARM 1d1+14 1d2+1
1 RACE_GNOME
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if race($n) != 5
  if rand(20)
    shout Save the gnomes!
    mpkill $n
  endif
else
  if actorhasobjnum(12300)
    bow $n
    if actorhasobjnum(12302)
      say Greetings, King $n.
    else
      if actorhasobjnum(12303)
        say Greetings, Queen $n.
      else
        if actorhasobjnum(12304)
          say Greetings, Prince $n.
        else
          if actorhasobjnum(12322)
            say Greetings, Princess $n.
          else
            if sex($n) == 1
              say Greetings, Master $n.
            else
              if sex($n) == 2
                say Greetings, Mistress $n.
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif
~
>death_prog 100~
if race($n) != 5
  mpechoat $n The gnome soldier gives you the finger!
else
  mpquiet on
  if quest(0,2,$n) == 1
    mpforce $n exittheempire
    if whichgod($n) == 0
      mptransfer $n 9755
      mpat 9755 mpforce $n death set
      mpat 9755 mpforce $n recall set
      chat $n has been removed from the empire.
    else
      if whichgod($n) == 1
        mptransfer $n 11404
        mpat 11404 mpforce $n death set
        mpat 11404 mpforce $n recall set
        chat $n has been removed from the empire.
      else
        if whichgod($n) == 2
          mptransfer $n 10955
          mpat 10955 mpforce $n death set
          mpat 10955 mpforce $n recall set
          chat $n has been removed from the empire.
        endif
      endif
    endif
  endif
  mpquiet off
endif
~
>speech_prog rank~
if race($n) != 5
  say You are $N.
else
  if actorhasobjnum(12300)
    if level($n) == 95
      say You are $N.
    else
      if level($n) >= 93
        say You are $n, Arch-Duke/Duchess of the Gnome Empire.
      else
        if level($n) >= 86
          say You are $n, Duke/Duchess of the Gnome Empire.
        else
          if level($n) >= 76
            say You are $n, Grand Baron/Baroness of the Gnome Empire.
          else
            if level($n) >= 61
              say You are $n, Lord Baron/Baroness of the Gnome Empire.
            else
              if level($n) >= 46
                say You are $n, Baron/Baroness of the Gnome Empire.
              else
                if level($n) >= 36
                  say You are $n, Emissary of the Gnome Empire.
                else
                  if level($n) >= 26
                    say You are $n, Squire of the Gnome Empire.
                  else
                    if level($n) >= 13
                      say You are $n, Page of the Gnome Empire.
                    else
                      say You are $n a Gnome Serf.
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif
~
