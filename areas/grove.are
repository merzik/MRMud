>speech_prog chakkor tower~
  if level($n) < 18
    mpecho {170}The obelisk glows with energy.{300}
    mpechoaround $n $n fades out of existence.
    mpechoat $n {170}You disappear suddenly!{300}
    mptransfer $n 9735
    mpgoto 9735
    mpechoaround $n {170}The obelisk glows with energy.{300}
    mpechoaround $n $n appears at the base of the obelisk!
    mpforce $n look
    mpechoat $n {170}You have arrived in Chakkor.{300}
    mpgoto 8927
  else
    mpechoat $n You are too big to call on the aid of the obelisk.
  endif
~
