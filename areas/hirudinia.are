>all_greet_prog 100~
if quest(0, 6, $n) == 9
  say I see you have made it this far, so you 
  say must be worthy opponents.  I shall give 
  say you a choice.  You appear to be very 
  say powerful, so may help me and leave with
  say your lives, or i will fight and you will
  say die.  But it is up to you to decide.
else
  if quest (0, 6, $n) == 22
    say You have done well by slaying the Bishop.
    say I fear there is yet another problem in
    say my way.  One of my minions has turned
    say its back on me and is slaughtering the
    say massive hordes in my armies.  Destroy
    say the scorpion, and bring me its tail.
    mpmset $n quest 0 6 23
  else
    if quest (0, 6, $n) == 24
      say Again you have served my purposes well, child.
      say Give me the tail of that vile, foul beast.
      mpmset $n quest 0 6 25
    endif
  endif
endif
~
>speech_prog fight~
if quest(0, 6, $n) == 9
  say You will never defeat me!
  mpkill $n
endif
~
>speech_prog leave help~
if quest(0, 6, $n) == 9
  mpmset $n quest 0 6 21
  say I need your help to overthrow the Chaotic forces that 
  say this land.  The Bishop of this city must pay with
  say his life.  Kill him, and return to me for further
  say instructions.  Fail me, and you will perish in the 
  say bowels of Hell for all Eternity.
endif
~
>fight_prog 55~
cast 'vampiric touch' $r
~
>death_prog 100~
if quest(0, 6, $n) == 9
  mpmset $n quest 0 6 10
  say You have defeated me in my own lair! How is that 
  say possible?!?  
  sigh
  say You may RETURN to your world with your lives this
  say time.  But beware... do not return, or you will
  say surely die a death most painful.
  mpecho $i slumps over in defeat and disappears.
  mpquiet on
  mpforce $n get all
  mpquiet off
else
  mpjunk all
endif
~
>give_prog i29465~
mpquiet on
mpjunk i29465
mpquiet off
if quest (0, 6, $n) == 25
  say Beautiful! Beautiful, my child!
  cackle
  say I can only offer you very little reward for 
  say your services.  You may pick from my vast 
  say collection of treasures.  Would you like
  say more powerful magic or more powerful 
  say offense?
  mpmset $n quest 0 6 26
endif
~
>speech_prog magic~
if quest (0, 6, $n) == 26
    say Very well, my child.
    mpquiet on
    cast 'giant strength' $n
    mpoload 29462
    mpoload 29463
    mpoload 29464
    mpquiet off
    mpmset $n quest 0 6 27
    give i29462 $n
    give i29463 $n
    give i29464 $n
endif
~
>speech_prog offense~
if quest (0, 6, $n) == 26
  say Very well, my child.
    mpquiet on
