>greet_prog 100~
if ispc($n)
  if reinc($n) > 0
    if whichgod($n) == 2
      rescale 29401 $n 150
    else
      rescale 29401 $n 85
    endif 
  endif
endif
if whichgod($n) == 1
shout M'Lord, stagnant Order wenches have infiltraded our fair city!
mpkill $n
endif
~
>fight_prog 75~
if whichgod($n) == 1
cast curse
cast 'energy drain'
cast acid blast
endif
~
