        say Now they wont be easy to find. 
        say I need Brackish Herbs, Dragons Blood, and Golden Thorn. 
        say Now let me think, where can these be found 
        mpmset $r quest 0 5 9 
      else 
        if quest(0, 5, $r) == 9 
          say Talk to Robyn Kendrick in Corwell about the Brackish Herbs. 
          say I understand dragons are rampaging in Ethshar again. 
          say Talk to Foxfire in Tethir Forest about the Golden Thorn. 
          say Be quick.  I will prepare the rest of the spell while you are gone. 
          mpmset $r quest 0 5 10 
        endif 
      endif 
    endif 
  endif 
endif 
