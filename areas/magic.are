>all_greet_prog 100~
if quest(15,3,$n) == 0
  if quest(21,2,$n) == 1
    bow
    say Greetings great warrior!
  endif
say Greetings.  Care to test your strength?
else
  if quest(15,3,$n) == 1
    laugh
    say REJECT!  You could not defeat that puny monster?
    mpmset quest(15,3,$n) == 0
  else
    if quest(15,3,$n) == 2
      say Good, you passed the first test.  You must be a fine
      say warrior.
      say Now, would you like to determine if you are a GREAT WARRIOR?
    else
      if quest(15,3,$n) == 3
        laugh
        say REJECT!  You could not defeat that puny monster?
      else
        if quest(15,3,$n) == 4
          say Congratulations great warrior!
          shout $n now has the honor of being a great warrior!
          mpmset $n quest 21 2 1
          mpmset $n quest 15 3 5
          say Lord Seflian may want to reward you, if you ask me to take you to him, I
          say gladly will.
        endif
      endif
    endif
  endif
endif
~
>speech_prog yes~
if quest(15,3,$n) == 0
  mpmset $n quest 15 3 1
  say Defeat the beast to the east and you may impress me.
  say A little.
  mpgoto 19542
  mpmload 19548
  mpgoto 19541
else
  if quest(15,3,$n) == 2
    mpmset $n quest 15 3 3
    say I like your determination.  If you can slay the beast to the
    say east I will pronounce you a great warrior.
    mpgoto 19542
    mpmload 19549
    mpgoto 19541
  else
    say Yes?  Yes what?
  endif
endif
~
>speech_prog no~
if quest(15,3,$n)==1
  if quest(18,3,$n) ==3
    scream
    say NO ONE FAILS THIS MANY TIMES AND GETS OUTTA HERE ALIVE!!
    slay $n
  endif
  if quest(18,3,$n)==2
    say FOOL!  This is your last chance to get it right, don't mess it up.  
    say You may start the quest over at the beginning.
    mpmset $n quest 15 3 0
    mpmset $n quest 18 3 3
  endif
  if quest(18,3,$n)==1
    say FOOL!  I'm going to give you 2 more chances to get it right, don't
    say mess up more than that.  You may start the quest over at the beginning.
    mpmset $n quest 15 3 0
    mpmset $n quest 18 3 2
  endif
  if  quest(18,3,$n)==0
    say FOOL!  I'm going to give you 3 chances to get it right, don't mess
    say up more than that.  You may start the quest over at the beginning.
    mpmset $n quest 15 3 0
    mpmset $n quest 18 3 1
  endif
endif
if quest(15,3,$n)==3
  if quest(18,3,$n)==3
     scream
     say NO ONE FAILS THAT MUCH AND MAKES IT OUT OF HERE ALIVE!
     slay $n
  endif
  if quest(18,3,$n)==2
     say FOOL!  This is your last chance to get it right, don't mess it up.  You
