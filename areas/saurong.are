#31780
large oak tree~
A Large Oak Tree~
A Large Oak Tree blocks your path.~
{060}It is the biggest tree you have ever seen. It's large limbs appear to
prevent you from getting by. You notice an odd looking knot on the tree, which
looks like a rod or staff could be placed in it.~
ACT_SENTINEL|ACT_SMART
AFF_DETECT_EVIL|AFF_TONGUES|AFF_UNDERSTAND|AFF_SANCTUARY|
AFF_DETECT_INVIS|AFF_DETECT_MAGIC|AFF_DETECT_HIDDEN
0 S
95 0 0 28000d1+1000 1d1-10
500 RACE_HUMAN
POS_STANDING POS_STANDING SEX_NEUTRAL
>rand_prog 5~
  mpecho $I moves its limbs!
~

>give_prog i11010~
   if class($n) != 1
       mpechoat $n Your inability to understand the powers of nature
       mpechoat $n prevents you from inserting the rod into the tree.
       drop i11010
   else
       mpmset $n quest 34 2 1 
   endif

    if quest(34, 2, $n) == 1
      if quest(36, 1, $n) == 1   
         if quest(37, 1, $n) == 1
              mpecho The lightning rod is securely placed within the tree.
              mpmset self quest 31 2 1
         endif
      endif
    endif

          if quest(34, 2, $n) == 1
            if quest(36, 1, $n) == 0
                 mpechoat $n Your inability to understand the powers of nature
                 mpechoat $n prevents you from inserting the rod into the tree.
                 drop i11010
            endif
         endif

              if quest(34, 2, $n) == 1
                if quest(37, 1, $n) == 0
                      mpechoat $n The large oak tree is too dry for the rod to stay in.
                      drop i11010
                endif
              endif
~
>rand_prog 50~
      if quest(31, 2, self) == 1
              mpecho The elements of nature collide together to assist.
              mpmset self quest 31 2 2
           else
                if quest(31, 2, self) == 2
                      mpecho A bolt of lightning hits the tree.
                      mpmset self quest 31 2 3
                  else
                        if quest(31, 2, self) == 3
                                  mpjunk i11010
                                  mptransfer all 32098
                                  mpat 32098 mpecho $I turns to stone and crumbles to the ground!
                                  mpat 32098 mpecho You manage to get by the tree before it falls on you!
                                  mpmset self quest 31 2 4
                        endif
                endif
     endif
~
>fight_prog 100~
     mpecho You chop off one of the tree's limbs, but it rejuvenates!
     mpecho Your attempt to inflict damage on the tree fails!
     mpquiet on
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     cast 'cure critical'
     mpquiet off
~
|
