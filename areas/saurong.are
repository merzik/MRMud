>all_greet_prog 100~
if quest(10, 3, $n) != 6 
          tell $n I knew you would come.
          mpmset self quest 26 4 1 
     else
          tell $n You have already received your reward!
          tell $n Now get out of here!
          mptransfer $n 31740
endif     
~

>rand_prog 55~
    if quest(26, 4, self) == 1
         say You are the first to have made it this far...
         mpmset self quest 26 4 2
         break
    endif
        if quest(26, 4, self) == 2
           say Your ability to answer my pets riddles is an
           say obvious indication of your intelligence...
           mpmset self quest 26 4 3
           break
        endif
            if quest(26, 4, self) == 3
               mpecho $I turns to face you...
               mpmset self quest 26 4 4
               break
            endif
                if quest(26, 4, self) == 4
                   say Do you think your intelligent?
                   mpmset self quest 26 4 5
                   break
                endif
                    if quest(26, 4, self) == 6
                       say If you dont know the answer then just say: I give up...
                       mpmset self quest 26 4 7
                       break
                    endif
                        if quest(26, 4, self) == 7
                           say At night they come without being fetched.
                           say And by day they are lost without being stolen.
                           smile 
                           mpmset self quest 26 4 8
                           break
                        endif
                            if quest(26, 4, self) == 9
                               say If you dont know the answer then just say:
                               say I give up...
                               mpmset self quest 26 4 10
                               break
                            endif
                                if quest(26, 4, self) == 10
                                   if class($r) == 0
                                      say A funny story is a joke
                                      say and sometimes people are called folk.
                                      say To have no funds is to be broke.
                                      say A frog will very often croak.
                                      say A fire causes lots of smoke.
                                      say An acorn grows into an oak.
                                      say Here is the riddle, do not choke!
                                      say The white of an egg is called the ......
                                      smile 
                                      mpmset self quest 26 4 11
                                   else
                                      if class($r) == 1
                                        say I never was, am always to be,
                                        say No one ever saw me, nor ever will
                                        say And yet I am the confidence of all
                                        say To live and breathe on this terrestrial ball.
                                        smile 
                                        mpmset self quest 26 4 11
                                      else       
                                        if class($r) == 2
                                           say It runs over fields and woods all day
                                           say Under the bed at night sits not alone,
                                           say With long tongue hanging out,
                                           say Awaiting for a bone.
                                           smile 
                                           mpmset self quest 26 4 11
                                        else
                                           if class($r) == 3
                                              say The beginning of eternity
                                              say The end of time and space
                                              say The beginning of every end,
                                              say And the end of every place.
                                              smile 
                                              mpmset self quest 26 4 11
                                           else
                                              if class($r) == 4
                                                 say Forever round,
                                                 say But never square.
                                                 say Bright and shiny
                                                 say When I am there.
                                                 say When I am not
                                                 say They call me new,
                                                 say But I am old,
                                                 say Older than you.
                                                 smile
                                                 mpmset self quest 26 4 11
                                              else
                                                 if class($r) == 5
                                                    say I don't come up.
                                                    say You say I do.
                                                    say I don't go down.
                                                    say You say that, too.
                                                    say I shine like nothing else can,
                                                    say Or won't.
                                                    say Even when you say I don't.
                                                    smile
                                                    mpmset self quest 26 4 11
                                                else
                                                    if class($r) == 6
                                                        say Forward I am heavy, backward I am not.
                                                        smile
                                                        mpmset self quest 26 4 11
                                                    else
                                                      if class($r) == 7
                                                        say If you were running a race, and you passed the person in second place, what place would you be in?
                                                        mpmset self quest 26 4 11
                                                    endif
                                              endif
                                         endif
                                    endif
                             endif
                      endif
               endif
       endif
~
>speech_prog p yes~
    if quest(26, 4, self) == 5
         say Well, since you feel so confident, 
         say answer for me this riddle:
         mpmset self quest 26 4 6
    endif
~

>speech_prog p stars~
   if quest(26, 4, self) == 8
       say Excellent.
       say One last riddle to prove your worth:
       mpmset self quest 26 4 9
   endif
~

>speech_prog p white~
  if quest(26, 4, self) == 11
        say You have most certainly proven your intelligence.
        mpmset $n quest 10 3 6
        mpmset self quest 26 4 12
        say For your bravery and devotion I reward 
        say you with this crystal. Use it wisely.
        mpquiet on
        mpoload 31715
        c 'giant strength' $n
        mpquiet off
        give crystal $n
     endif

    if quest(16, 4, $n) == 8
         if quest(7, 3, $n) == 6 
            if quest(20, 2, $n) == 3
               if quest(10, 3, $n) == 6
                  if quest(4, 3, $n) == 6
                     mpmset $n quest 0 4 5 
                     tell $n Well done, you have retrieved all of the crystals.
                     bow $n
                     say Good Luck, and God speed!
                     mptransfer $n 31740
                  endif
              else
                 bow $n
                 say Good Luck, and God speed!
                 mptransfer $n 31740
              endif
            else
               bow $n
               say Good Luck, and God speed!
              mptransfer $n 31740
            endif
         else
            bow $n
            say Good Luck, and God speed!
            mptransfer $n 31740
         endif
     else
        bow $n
        say Good Luck, and God speed!
        mptransfer $n 31740
     endif
~
