       say If you dont know the answer to my riddle then just say: 
       say I give up...
       mpmset self quest 17 3 2
    endif
~

>rand_prog 55~
   if quest(17, 3, self) == 2
         say Now then, answer for me this:
         cackle
         mpmset self quest 17 3 3
      else
          if quest(17, 3, self) == 3
             say I have two heads, yet I don't eat.
             say I have no heart, yet I do beat.
             say I have a snare, yet catch no game.
             say Please tell me now, what is my name?
             mpmset self quest 17 3 4             
       endif
    endif
~

>speech_prog p drum~
    if quest(17, 3, self) == 4
       say Very good. You may continue.
       mpecho $I utters the word, 'tropsnart'.
       mptransfer $n 31887
       mpat 31887 mpecho Your body begins to shiver.
    endif    
~

>speech_prog p I give up~
   laugh
   say You Fool!!
   mptransfer $n 31740
~

>speech_prog p no~
   say Well, thats too bad!
   mpecho $I utters the word, 'tropsnart'.
   mptransfer $n 31740
~

