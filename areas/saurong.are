>all_greet_prog 100~
 if race($n) == 0
   tell $n Hello there you sloven human fiend!
   tell $n What do you think of my juggling act?
 else
    if race($n) == 1
       tell $n Hello there my little skinny hybrid friend!
       tell $n What do you think of my juggling act? 
    else
       if race($n) == 2
          tell $n Hello there my skinny, pointy ear friend!
          tell $n What do you think of my juggling act?
       else
          if race($n) == 3
             tell $n Hello there my little elven outcast friend!
             tell $n What do you think of my juggling act?
          else
               if race($n) == 4
                  tell $n Hello there my little fat pudgy friend!
                  tell $n What do you think of my juggling act? 
               else
                   if race($n) == 5
                        tell $n Hello there my little short, stubby, hairy legged friend!
                        tell $n What do you think of my juggling act?
                   else
                       if race($n) == 6
                           tell $n Hello there my big ugly wannabe ogre friend!
                           tell $n What do you think of my juggling act?
                       else
                            if race($n) == 7
                                tell $n Hello there my big dumb burly friend!
                                tell $n What do you think of my juggling act? 
                            endif
                        endif
                    endif
              endif
          endif
      endif
   endif
endif
~
