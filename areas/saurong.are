        mpoload 31729
        c 'giant strength' $n 
        mpquiet off
        give hammer $n 
        give nails $n
        mpjunk coins
        mpmset $n quest 13 3 5
    else
        say Hey, thanks a bunch. You are so kind.
        cackle
        mpjunk coins
    endif
