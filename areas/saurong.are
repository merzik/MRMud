>give_prog i31702~
 if actorhasobjnum(31704)
    tell $n You already have a Pendant, why would you want another?
    mpjunk i31702
 else
    tell $n Ah yes! The Pendant of Protection!
    mpmset self quest 7 3 1
    mpjunk i31702
 endif
~ 

>rand_prog 60~
      if quest(7, 3, self) == 1 
            say This pendant seems pretty battered.
            say Let me strengthen it for you...
            mpmset self quest 7 3 2 
          else
              if quest(7, 3, self) == 2 
                  mpecho $I utters the words 'grasjthe'...
                  mpoload 31704
                  mpmset self quest 7 3 3
               else
                   if quest(7, 3, self) == 3
                       drop pendant
                       say There, that should be better.
                       mpmset self quest 7 3 4
                   endif
               endif
           endif
~
