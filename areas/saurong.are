~
>all_greet_prog 100~
if quest(0, 4, $n) == 9 
   say Ahh, its you $n
   say I hear the King is quite proud of you.
   say I was able to finish that piece of armor I was working on.
   say I was going to keep it, but once I had heard of your good deed
   say I thought it would be best to give it to you as a reward.
   say So here you go!
   mpquiet on
   mpoload 31752
   c 'giant strength' $n
   mpquiet off
   give helmet $n
   mpmset $n quest 0 4 10
endif
~ 

>give_prog i31707~
 if quest(4, 3, $n) == 5
        say Wow, where did you get these horns from?
        say Great, now I have enough ivory to complete the piece of 
        say armor I want to make.
        say Here I found this. You can have it.
        mpquiet on
        mpoload 31717
        c 'giant strength' $n
        mpjunk i31707
        mpquiet off
        give crystal $n
        mpmset $n quest 4 3 6
 else
    say I have no need for these.
    mpjunk i31707
endif

    if quest(16, 4, $n) == 8
         if quest(7, 3, $n) == 6 
            if quest(20, 2, $n) == 3
               if quest(10, 3, $n) == 6
                  if quest(4, 3, $n) == 6
                         mpmset $n quest 0 4 5
                         tell $n Well done, you have retrieved all of the crystals.
                     endif
                  endif
            endif
         endif
    endif   
~
