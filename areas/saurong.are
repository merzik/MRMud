>act_prog p puts a cyan crystal in a dragon pillar.~
if quest(0, 4, $n) == 5
  if quest(24, 3, $n) == 0
     mpquiet on
     get crystal pillar
     mpquiet off
     mpjunk i31718
     mpecho The dragon pillar rises to the ceiling and inserts the crystal.
     mpecho You hear a door open in the distance.
     mpmset $n quest 24 3 1
  else
     mpquiet on
     get crystal pillar
     mpquiet off
     mpechoat $n Incorrect Sequence!
     mpecho A crystal turns to dust!
     mpjunk i31718
  endif
else
  mpechoat $n You have failed to obtain the other crystals.
  mpecho A crystal turns to dust!
  mpquiet on
  get crystal pillar
  mpquiet off
  mpjunk i31718
endif
