very well built.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART
AFF_DETECT_HIDDEN|AFF_DETECT_INVIS|AFF_TONGUES|AFF_UNDERSTAND
0 S
90 0 0 9000d1+0 10d10+20
5000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(0, 4, $n) >= 2
   nod $n
else
   tell $n How the heck did you get past my boys?
   look $n
   smile
   tell $n Not bad, Not bad at all.
endif
~
>give_prog i31705~
   if quest(0,4,$n)==1
      say Whats this?
      mpecho $I opens the letter and reads it.
      mpmset self quest 0 2 1
      mpjunk i31705
   else
      say I have no need for this.
      mpjunk i31705
    endif   
~
>rand_prog 60~
   if quest(0, 2, self) == 1
       say So, Shuagan finally needs my help eh?
       say Perhaps it would be a good idea to join forces...
       mpmset self quest 0 2 2
    else
         if quest(0, 2, self) == 2
                mpecho $I writes something on the letter.
                say You think you can manage to take this back to him?
                mpmset self quest 0 2 3
         endif
   endif
~
>speech_prog p yes~
if quest(0, 2, self) == 3
if quest(0, 4, $n) == 1
        mpoload 31706
        mpoload 31708 
        mpquiet on
        c 'giant strength' $n
        mpquiet off
        give letter $n
        say Ohh, Wait!
        say Wear this bandana so my boys wont kick your ass.
        give bandana $n
        smile
        mpmset $n quest 0 4 2
endif
endif
~
