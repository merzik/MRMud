    mpmset $n quest 0 4 10 
    mpecho The Great Savant slowly awakens from his trance. 
    say Ahhh... it seems you have studied properly $n 
    say Do you wish to join our order? 
  else 
  endif 
else 
endif 
~ 
>speech_prog yes~ 
