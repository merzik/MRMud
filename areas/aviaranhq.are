>speech_prog p What is my rank?~
 if actorhasobjnum(13555)
 if level($n)>=10
 if level($n)<=19
 mpechoat $n You are a corporal in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Corporal $n hovers here.
 break
 endif
 endif
 if level($n)>=20
 if level($n)<=29
 mpechoat $n You are a sergeant in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Sergeant $n hovers here.
 break
 endif
 endif
 if level($n)>=30
 if level($n)<=39
 mpechoat $n You are a master sergeant in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Master Sergeant $n hovers here.
 break
 endif
 endif
 if level($n)>=40
 if level($n)<=49
 mpechoat $n You are a sergeant major in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Sergeant Major $n hovers here.
 break
 endif
 endif
 if level($n)>=50
 if level($n)<=59
 mpechoat $n You are a major in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Major $n hovers here.
 break
 endif
 endif
 if level($n)>=60
 if level($n)<=69
 mpechoat $n You are a lieutenant colonel in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Lieutenant Colonel $n hovers here.
 break
 endif
 endif
 if level($n)>=70
 if level($n)<=79
 mpechoat $n You are a colonel in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Colonel $n hovers here.
 break
 endif
 endif
 if level($n)>=80
 if level($n)<=89
 mpechoat $n You are a vice admiral in the Aviaran Airborne Army.
 mpmset $n long Aviaran Airborne Army Vice Admiral $n hovers here.
 break
 endif
 endif
 if level($n)>=90
 mpechoat $n You have achieved the rank of Admiral Of The Aviaran Airborne Army.
 mpmset $n long Admiral Of The Aviaran Army $n hovers above you.
 endif
 endif
 mppurge self
~
