#AREA Aviaran Skies~

#AUTHORS Pythos Fury~

#RANGES 0 95 0 99

#RESETMSG You hear the wails of cats in the distance.~

#FLAGS AFLAG_FREEQUIT|AFLAG_NOTELEPORT

#HELPS
-1 "AVIARAN SKIES"~
{160}        Aviaran Skies{300}
The skies above Ocean City, extending over the ocean are considered the
air space of the Aviaran Airborne Army.  Those Aviarans who desire a
career in the army in defense of Aviarans realms-wide arrive here to
train and hopefully be deemed worthy of the great honor of being inducted
into the Aviaran Airborne Army.

(a) Pythos
{a}PYTHOS
~
-1 PYTHOS~
Yes, please help Pythos as he needs a lot of help!
{130}Areas by Pythos{300}
{130}New Singase{300}
{130}Old Singase{300}
{130}Singase Plains{300}
{130}Aviaran Skies{300}
~
-1 'NEW SINGASE'~
Try help singase
~
-1 'OLD SINGASE'~
Try help singase
~
0 $~

#MOBILES
#13550
Army Airborne Admiral Avimus~
Admiral Avimus~
Aviaran Airborne Army Admiral Avimus hovers above you.~
This most powerful of Aviaran Army Aviators appears highly unapproachable
unless you have been ordered to see him.  His powerful form, stern face and
piercingly demanding eyes make you shake in your boots.  The only word he seems
to react to is 'enlist', which is what new recruits must do.~
ACT_IS_NPC|ACT_RACE|ACT_BODY|ACT_NO_ORDER|ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART
AFF_DETECT_HIDDEN|AFF_SANCTUARY|AFF_INFRARED|AFF_UNDERSTAND|AFF_FLYING|AFF_TONGUES|AFF_DETECT_INVIS
0 S
95 BODY_WING|BODY_HEAD BODY_WING|BODY_HEAD 1d1+10999 6d9+139
0 RACE_AVIARAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if race($n)==8
   nod $n
   if quest(0,3,$n)==3
      if quest(20,1,$n)==0
         say You did a masterful job.  I never doubted you would
         say do the job necessary to become one of us.
         mpoload 13551
         give i13551 $n
         mpjunk i13551
         mpmset $n quest 20 1 1
         say Take this document and go to the Acceptance
         say Chamber.  There you must AGREE to the restrictions
         say and all the guidelines on the document.
         say At that time, you will be a true member of the
         say mighty Aviaran Airborne Army.
         say Oh, ummm, before I forget......
         say If you want annals of your ancestry, you must see
         say Colonel Ahlerr and say "May I please have the annals sir?"
         say and he will do his necessary work for you.
         break
      endif
   endif
   break
endif
if race($n)==11
   growl $n
   say How did you ever get this far?
   mpquiet on
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   cast 'remove curse' $n
   mpforce $n remove all
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   cast 'dispel magic' $n
   mpforce $n drop all.recall
   mpquiet off
   mpkill $n
   cast acid $n
   cast acid $n
   cast 'vampiric touch' $n
   cast 'dispel good' $n
   kick $n
   trip $n
   break
else
   growl $n
   say Begone!
   mptransfer $n 27700
endif
~
>fight_prog 50~
   mpquiet on
   mpforce $n remove all
   mpforce $n drop all.recall
   mpquiet off
   mpechoat $n You shall die!
   mpechoat $n You whimper.
   mpechoaround $n $n whimpers.
   cast acid $n
   cast acid $n
   cast 'vampiric touch' $n
   cast 'dispel good' $n
   martialarts
   martialarts
   martialarts
   kick $n
   trip $n
~
>speech_prog enlist~
   say You may join the army... I will transfer you there.
   tell $n Type army join <password> to join the army.
   mptransfer $n 13599
~
>speech_prog retire~
   say You may retire from the army... I will transfer you there.
   tell $n Type army retire <password> to return the army.
   mptransfer $n 13599
~
>speech_prog enlist_blehspam~
if race($n)==8
   if quest(0,3,$n)==0
      say So, you wish to enlist in the Aviaran Airborne Army, do you?
      mpforce $n bow Avimus
      mpforce $n say Yes, sir, that is my desire.
      say You must understand that joining our legion is not a decision
      say to be taken lightly.
      mpforce $n say I fully understand, sir, that being in our airborne army is a great responsibility.
      say It isn't YOUR Airborne Army yet! Don't go off wrong headed and
      say call it yours when it is by no means yours!
      growl $n
      mpforce $n grovel Avimus
      say Get on your feet!
      say You look like a cat when you act like that!
      spit
      say I hate cats!
      say And you had better start hating cats and quit acting like
      say them if you know what is good for you.
      mpforce $n say Yes, sir.
      say you must prove yourself worthy of the Aviaran Airborne Army.
      mpgoto 13595
      slay cat
      slay cat
      slay cat
      mpmload 13559
      mpgoto 13592
      say Go kill the cat that is trapped in the Activities Chamber.
      say That will prove your worthiness.
      mpmset $n quest 0 3 1
      break
   endif
   if quest(0,3,$n)==1
      say I told you to go kill that cat!
      say If it died already by hands other than your own, you
      say have proven yourself to be less than the best.
      say If it died in some other fashion, then you can have
      say another chance.
      mpmset $n quest 0 3 2
      say Did it die in some other fashion?
      break
   endif
   if quest(0,3,$n)==2
      say I told you to go kill that cat!
      say If it died already by hands other than your own, you
      say have proven yourself to be less than the best.
      say If it died in some other fashion, then you can have
      say another chance.
      mpmset $n quest 0 3 2
      say Did it die in some other fashion?
      break
   endif
   if quest(0,3,$n)>=3
      say You already passed the test.
      say I already gave you the required documents.  If you
      say have lost them, what is it to me?  It's your loss and
      say not mine.
      sigh
      say I am in a giving mood today.
      mpoload 13551
      give i13551 $n
      mpjunk i13551 
   endif
endif
~
>speech_prog yes~
if quest(0,3,$n)==2
   mpgoto 13595
   slay cat
   slay cat
   slay cat
   mpmload 13559
   mpgoto 13592
   say Go kill the cat that is trapped in the Activities Chamber.
   say That will prove your worthiness.
   mpmset $n quest 0 3 1
endif
~
>speech_prog p Alienate me please, sir.~
if quest(0,3,$n)==3
   say You are not worthy of being called an Aviaran!
   say You are nothing better than an alley cat!
   mpoload 13552
   mpquiet on
   cast 'remove curse' self
   mpquiet off
   growl $n
   give i13552 $n
   mpjunk i13552
   say Now go into that
   growl $n
   say Alienation chamber and ALIENATE yourself.....
   say CAT!
endif
~
>speech_prog p retire_resign~
if quest(0,3,$n)==3
   say You are not worthy of being called an Aviaran!
   say You are nothing better than an alley cat!
   mpoload 13552
   mpquiet on
   cast 'remove curse' self
   mpquiet off
   growl $n
   give i13552 $n
   mpjunk i13552
   say Now go into that
   growl $n
   say Alienation chamber and ALIENATE yourself.....
   say CAT!
endif
~
