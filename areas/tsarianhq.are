1 0 0 10d10+10000 10d10+100
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>all_greet_prog 100~
if race($n) != 11
  mpechoat $n {110}Warning!  You have entered Tsarian Rock.{300}
  mpechoat $n {110}Enter at your own risk.{300}
  mpechoat $n {110}Aviaran are welcome for lunch!{300}
endif
~
