>greet_prog 100~
if quest(4,4,$n)>3
  mpechoaround $n The pink clerk trembles at the sight of $n.
  mpechoat $n The pink clerk trembles at the sight of you.
  mpechoat $n The pink clerk says 'Please... please, I beg you...
  mpechoat $n Don't take me to Arcus...'
  grovel $n
  mpmset $n quest 4 4 5
  mpmset self quest 4 4 1
else
if quest(4,4,self)==0
  say What can I do for you, $n, eh?
endif
endif
~
>rand_prog 2~
if quest(4,4,self)==0
wink $r
~
>rand_prog 4~
if quest(4,4,self)==0
  tickle self
  giggle 
  say I just met a man named LORENTZ, funny guy, all 
  say decked out in skintight white attire.  He taught 
  say me the joys of being tickled in the tummy.
  giggle
else
if quest(4,4,self)==1
  emote trembles with terror and tries to climb the walls!
endif 
endif
~
>rand_prog 60~
if inroom($r)==15636 
  if quest(4,4,self)==1
    cringe arcus
    mpecho The pink clerk says 'I throw myself at your feet for forgiveness.
    mpecho You are my generous master, and I am your humble servant.'
    mpmset self quest 4 4 2
  else
  if quest(4,4,self)==2
    mpecho Prince Arcus says 'You shall nevertheless be punished for your
    mpecho treachery.  Our holy father, Lord Neptune, showed us no mercy
    mpecho when we believed ourselves kings, and thus I shall show you none.
    mpecho Offer up your prayers to our holy father, and prepare to die.'
    mpmset self quest 4 4 3
  else
  if quest(4,4,self)==3
    mpecho The pink clerk suddenly rips open the chest of his cloak.
    mpecho Prince Arcus catches his breath as he recognizes a large brand
    mpecho carved into the clerk's flesh.
    mpecho Prince Arcus says 'Ah... so you have the mark of a Piscyrean
    mpecho elder.  I can see why you were sent away.  Well, you are at
    mpecho at least worthy of a trial.'
    mpecho Prince Arcus waves his hand nonchalantly.
    mpmset self quest 4 4 4
  else
  if quest(4,4,self)==4
    mpecho The city bailiff arrives to carry out Arcus' order.
    mpecho
    mpecho You accompany the clerk to the court.
    mptransfer pcs 15629
    mpgoto 15629
    mpmset self quest 4 4 5
  endif
endif
endif
endif
endif
if inroom($r)==15629 
  if quest(4,4,self)==5
    if rand(30)
    mpecho The judge peers at the clerk from atop his pedastal.
    mpecho The bailiff says 'I have here the official records of
    mpecho the events leading up to the arrest and apprehension of
    mpecho the city page, whose name and papers appear to be missing.
    mpecho It has long been known that the treacherous Lorentz has been
    mpecho organizing a small army of insurgents to violently oppose
    mpecho the chaste and morally righteous regime of Prince Arcus,
    mpecho and our agents followed his every move.  The pink clerk
    mpecho has been polling strangers for weeks in attempts to raise
    mpecho funding for his cohort's rebellion, and there is no doubt
    mpecho as to his role in the insurgency.'
    mpmset self quest 4 4 6
    endif
  else
  if quest(4,4,self)==6
    if rand(30)
    mpecho The judge nods, then turns to the pink clerk.
    mpecho The judge says 'Do you have anything to say for yourself?'
    mpecho The pink clerk stares at the judge, trembling, and
    mpecho launches into the sad tale of his expulsion from Piscyra
    mpecho and subsequence abuse in Midgaard and the Mushroom Village
    mpecho all for the sake of his lifestyle.  While the judge is
    mpecho visibly moved, he shakes his head slowly.
    mpecho The judge says 'While I empathize with your plight, it is
    mpecho no departure from the lives that all of us live, constantly
    mpecho supplicating ourselves to our wise and reasonable father,
    mpecho Lord Neptune.  You have been born into the body of a 
    mpecho Piscyrean noble, but you have acted irresponsibly and must
    mpecho be put to death.  I will, however, extend you the opportunity
    mpecho to postpone your death in a contest of strength and will.
    mpecho The bailiff will take you to the arena.'
    mpmset self quest 4 4 7
    endif
  else
  if quest(4,4,self)==7
    if rand(30)
    mpecho Amidst sobs of grief, the pink clerk is dragged off to meet
    mpecho the gladiator, though you know he doesn't stand a chance.
    mpecho
    mpecho The judge turns to you and says 'You are to be commended for
    mpecho bringing a close to this unfortunate situation.  We don't
    mpecho have many cases these days, but I like to keep my cousin
    mpecho busy.  He's a fine carpenter, but you may have noticed that
    mpecho we haven't many trees either, just rosewood from the garden
    mpecho that goes into trinkets like this one.  Please take this 
    mpecho gavel and let it guide you along the path of reason.  
    mpecho Be sure to check out the the inscription.'
    mpoload 15580
    mpquiet on
    c 'remove curse' self
    c 'remove curse' self
    c 'remove curse'
    drop all
    mpquiet off
    mpecho You hear the hollow clattering of wood on the parquet floor.
    mpmset self quest 4 4 0
    mppurge self
    endif
  endif
  endif
  endif
else 
  if inroom($r)==15631
  else
    emote heads back to the administration building lobby.
    mpgoto 15631
  endif
endif
~
>speech_prog p lorentz~
if quest(4,4,$n)==0
  emote cracks a lewd smile.
  mpechoaround $n The clerk leans over to $n and whispers something in 
  mpechoaround $n $m ear...
  mpechoat $n The clerk leans over and whispers in your ear...
  if sex($n)==1
    mpechoat $n 'Aw, honey, he could show you a thing or two.'
  else
  if sex($n)==2
    mpechoat $n 'He's the best friend a girl could have, but not much
    mpechoat $n of a lady's man.'
  else
  if sex($n)==0
    mpechoat $n The clerk appraises you with a skeptical eye...
  endif
  endif
  endif
  mpechoat $n 'Lorentz has always lived on the edge.  He has more courage in
  mpechoat $n his little finger than most people have their whole bodies.
  mpechoat $n Ever since ARCUS posted his decrees on "morality and
  mpechoat $n chaste living", Lorentz has had to live a tenuous life,
  mpechoat $n concealing all that makes him so special under a cloak
  mpechoat $n of deceit and dishonesty.'
  mpmset $n quest 4 4 1
else
  emote looks around nervously.
endif
~
>speech_prog p arcus~
if quest(4,4,$n)==1
  mpechoaround $n The clerk pauses, then begins to speak with $n once again.
  mpechoat $n 'Arcus seems to bear the weight of centuries-old catastrophe
  mpechoat $n squarely on his back.  It's as if by living in a moral cloister
  mpechoat $n he hopes to regain the grace of Lord Neptune, restoring
  mpechoat $n Atlantis to greatness.  His totalitarian regime is making
  mpechoat $n life unlivable for ENLIGHTENED folk such as myself, and I
  mpechoat $n resent his regulation of the bedroom.  He has no right!  What
  mpechoat $n I do in the privacy of my own home is between me and Lord
  mpechoat $n Neptune himself!'
  mpmset $n quest 4 4 2
else
  emote looks around nervously.
endif
~
>speech_prog p enlightened~
if quest(4,4,$n)==2
  mpechoaround $n The clerk once again takes up a conversation with $n.
  mpechoat $n 'Ah, so you seek enlightenment?  Well we will never see
  mpechoat $n the day when we might share our beliefs openly unless...
  mpechoat $n unless... you are willing to seek out Lorentz and fund
  mpechoat $n the small band of mercenaries he has assembled.  A contribution
  mpechoat $n of 1,000,000 gold coins would certainly help the cause.
  mpechoat $n Lorentz has taken to the street, so it is there you will find him.
  mpechoat $n He'll be expecting you.
  mpmset $n quest 4 4 3
  if sex($n)==1
    mpechoat $n 'And, honey... come back and see me when you're done.'
  else
  if sex($n)==2
    mpechoat $n 'Now you go, girlfriend!'
  else
  if sex($n)==0
    mpechoat $n The clerk appraises you with a skeptical eye...
  endif
  endif
  endif
else
  emote looks around nervously.
endif
~
