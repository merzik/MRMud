>all_greet_prog 100~
    if inroom($i) == 4749
      if quest(4, 1, $n) == 0
            say Any new reports on the excavations in the mines?
            mpmset self quest 8 1 1
            mpmset $n quest 4 1 1
      endif
    endif
~
>rand_prog 75~
     if quest(8, 1, self) == 1
        mpforce guard say No sir. No new reports, but the search still goes on.
        mpmset self quest 8 1 2
     endif
~
>speech_prog p siven beckons you.~
   if inroom($i) == 4749
      if quest(11, 4, $n) == 3
          if quest(17, 2, $n) == 0
              tell $n What does he want?
              sigh
              mpmset $n quest 17 2 1
          endif
      endif
  endif
~
>speech_prog p meet him at the ancients tomb.~
   if inroom($i) == 4749
      if quest(17, 2, $n) == 1
              tell $n He keeps babbeling on about how dad
              tell $n wanted us both to rule Juargan. 
              sigh
              mpmset $n quest 17 2 2
              mpecho $I leaves south.
              mpgoto 4769
      endif
  endif
~
>all_greet_prog 100~
      if quest(11, 4, $n) == 8
         tell $n You truly are an honorable warrior $n.
         bow $n
      endif
~
