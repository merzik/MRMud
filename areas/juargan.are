  if level($n) <= 40
    if inroom($i) == 4732
        if quest(5, 2, $n) == 0
            mpechoat $n $I looks you over.
            tell $n You look like you could be of use to me.
            tell $n Would you do me a favor?
            mpmset $n quest 5 2 1
      endif
    endif
