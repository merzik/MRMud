#4702
yentle123~
Yentle the Dwarf~
Yentle is here trying to grow rocks.~
The insane little dwarf who thinks he can grow a rock.  He is dressed in many
yellows and oranges, and seems to have a happy look about him despite his years
of failure at growing rocks.~
ACT_RACE|ACT_BODY|ACT_SMART|ACT_SENTINEL
AFF_UNDERSTAND|AFF_DETECT_HIDDEN|AFF_DETECT_INVIS|AFF_TONGUES
1000 S
10 0 0 10d10+100 2d6+9
300 RACE_DWARF
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
 if level($n) <= 40
   if inroom($i) == 4786
         if quest(0, 4, $n) == 0
            mpechoat $n $I looks at you cross-eyed.
            tell $n Ummm, Ummm, Hello.
            tell $n Im tryin to grow rocks, ya want to help me?
            mpmset $n quest 0 4 1
       endif
    endif
~
>speech_prog p yes~
  if quest(0, 4, $n) == 1
    tell $n Ummm, wow, ummm, yous are so nice.
    tell $n Yous haves to haves three stones
    tell $n soes ya cans grow dem.
    tell $n Uncles wont let me leave the yard,
    tell $n cause of all da fighting going on
    tell $n arounds here. Maybes yous cans
    tell $n finds em for me.
    mpecho $I starts to shake violently.
    mpmset $n quest 0 4 2
  endif
~
>give_prog i4722~
    if inroom($i) == 4786
        if quest(0, 4, $n) == 2
             tell $n Oh Boy!! yous founded a large stone. Yipee!!
             mpecho $I takes the large stone and sets it on the ground.
             tell $n Ok, yous needs to finded me twos more.
             mpmset $n quest 0 4 3
             mpjunk i4722
        else
            give large $n
            tell $n I's cant use dis rock first silly.
        endif
    endif
~
>give_prog i4721~
    if inroom($i) == 4786
         if quest(0, 4, $n) == 3
             tell $n Oh Boy!! yous founded a medium size stone. Yipee!!
             mpecho $I takes the stone and sets it on the large stone.
             tell $n Ok, yous needs to finded me one more.
             mpmset $n quest 0 4 4
             mpjunk i4721
         else
             give medium $n
             tell $n I's cant use dis rock first silly.
         endif
    endif
~
>give_prog i4720~
     if inroom($i) == 4786
        if quest(0, 4, $n) == 4
             tell $n Oh Boy!! yous founded a large stone. Yipee!!
             mpecho $I takes the stone and sets it on the medium stone.
             tell $n Now I wills stay and watch it grow.
             mpmset $n quest 0 4 5
             mpmset self quest 0 2 1
             mpjunk i4720
        else
             give small $n
             tell $n I's cant use dis rock first silly.
        endif
    endif
~
>rand_prog 50~
    if quest(0, 2, self) == 1
       mpmload 4721 
       mpforce siven1234 shout Yentil, get in here, dinner is ready!!
       mpmset self quest 0 2 2
       mppurge siven1234
    else
        if quest(0, 2, self) == 2
           shout Coming uncle Siven!
           say Well I's guess I's best be going.
           say Hey whys dont yous come inside
           say and meet uncle Siven.
           mpecho $I leaves east.
           mpgoto 4771
           mpmset self quest 0 2 3
        endif
    endif
~
>all_greet_prog 100~
    if inroom($n) == 4786
      if quest(0, 4, $n) >= 6
            tell $n Hi $n, I'm still waiting for
            tell $n des rocks ta grow!
            mpechoat $n $I gives you a huge smile.
      endif
    endif
~
