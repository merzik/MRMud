>all_greet_prog 100~
  if inroom($i) == 4771
   if quest(0, 4, $n) == 5
      tell $n Oh, excuse me sir, we have just sat down
      tell $n for dinner, would you please come back later.
      mpmset $n quest 0 4 6
      mpmset self quest 2 6 1
   endif
 endif
~
>rand_prog 55~
   if quest(2, 6, self) == 1
       mpforce yentle123 say Nos uncle Siven, dis man is my friend $r.
       mpforce yentle123 say Hes help me grow rocks in da yard.
       mpforce yentle123 say Can hes please stay for dinner uncle?
       mpmset self quest 2 6 2
       break
   endif
   if quest(2, 6, self) == 2
      say Well I guess that will be alright my young
      say Yentil. Please $r, rest and enjoy dinner with us.
      mpquiet on
      mpforce $r rest
      mpquiet off
      mpechoat $r You sit down at the table to eat.
      mpmset self quest 2 6 3
      break
   endif
   if quest(2, 6, self) == 3
      say So you have made a new friend my young Yentil?
      mpmset self quest 2 6 4
      break
   endif
   if quest(2, 6, self) == 4
      mpforce yentle123 say Yes uncle Siven, and he is 
      mpforce yentle123 say really nice too. He help me
      mpforce yentle123 say finded rocks so I cans grow dem.
      mpforce yentle123 smile
      mpecho Yentil starts playing with his food.
      mpmset self quest 2 6 5
      break
   endif
   if quest(2, 6, self) == 5
      say That is great my young Yentil.
      say Do not play with your food.
      say It is improper ettiquette.
      mpmset self quest 2 6 6
      break
   endif
   if quest(2, 6, self) == 6
      mpforce yentle123 say I'm sorry uncle Siven.
      mpmset self quest 2 6 7
      break
   endif
   if quest(2, 6, self) == 7
      say Why dont you clean up and go outside and
      say play, while $r and I talk.
      mpmset self quest 2 6 8
      break
   endif
   if quest(2, 6, self) == 8
      mpforce yentle123 say Ok uncle Siven.
      mpecho Yentil wipes his hands and face on a cloth.
      mpecho Yentil leaves west.
      mpquiet on
         mpforce yentle123 goto 4786
      mpquiet off
      mpmset self quest 2 6 9
      break
   endif
   if quest(2, 6, self) == 9
      say Yentils parents were killed fifteen years ago during
      say the Great Dwarven War and I have adopted him as my son,
      say and swore to his father before he died to be
      say his guardian. It is very kind of you $r to give
      say young Yentil some attention. There are not many
      say young children here in Juargan who will. Young
      say Yentil has a mental disorder, so the other
      say children make it rather difficult for him.
      mpmset self quest 2 6 10
      break
   endif
   if quest(2, 6, self) == 10
      say Unfortunately, there are even worse Problems in our
      say village that worries me more so than young Yentil's.
      mpmset self quest 2 6 11
      mpmset $r quest 0 4 6 
      break
   endif
   if quest(2, 6, self) == 12
      mpforce grimdale123 say What is it Siven?
      mpmset self quest 2 6 13
      break
   endif
   if quest(2, 6, self) == 13
      say The pieces of the staff have been found.
      mpecho $I bows before you.
      say And I have assembled the three pieces together to form
      say the original Staff of Ruling.
      mpmset self quest 2 6 14
      break
   endif
   if quest(2, 6, self) == 14
      mpecho Grimdale looks at you.
      mpforce Grimdale123 say I asked you to get those pieces for me.
      mpmset self quest 2 6 15
      break
   endif
   if quest(2, 6, self) == 15
      say No Grimdale, this Kingdom is not to be ruled by you
      say alone. Your father told me before he died, it was
      say important that both of his sons must rule Juargan
      say together. In order to safeguard and protect the
      say Kingdom, you both need to support each other.
      mpmset self quest 2 6 16
      break
   endif
   if quest(2, 6, self) == 16
      open large
      mpecho $I lays the Staff of Ruling on the corpse of King Zadrian.
      mpmset self quest 2 6 17
      break
   endif
   if quest(2, 6, self) == 17
      mpecho The stone sarcophagus begins to shake violently.
      mpmset self quest 2 6 18
      breal
   endif
   if quest(2, 6, self) == 18
      mpecho The ghost of King Zadrian appears before you.
      mpmload 4716
      mpmset self quest 2 6 19
      break
   endif
   if quest(2, 6, self) == 19
      mpforce zadrian123 say Grimdale. Mathius. My sons. I call upon you 
      mpforce zadrian123 say to listen to my words, if not those of the great
      mpforce zadrian123 say wise man Siven. 
      mpmset self quest 2 6 20
      break
   endif
   if quest(2, 6, self) == 20
      mpforce zadrian123 say Juargan must not be led astray by two men who seek 
      mpforce zadrian123 say their own initiatives. Jagoan and his forces will
      mpforce zadrian123 say return to dismantle what I created here in Juargan.  
      mpforce zadrian123 say You mustn't let this happen. You both share equal
      mpforce zadrian123 say power. The power to build, strenghten, and protect
      mpforce zadrian123 say your people. Together.
      mpmset self quest 2 6 21
      break
   endif
   if quest(2, 6, self) == 21
      mpecho The Ghost of Zadrian extends his arms out.
      mpforce zadrian123 say Both of you hold the head of the staff.
      mpmset self quest 2 6 22
      break
   endif
   if quest(2, 6, self) == 22
      mpecho Grimdale and Mathius hold the end of the staff.
      mpecho A bright green light shines forth blinding you.
      mpecho The room begins to shake vehemently.
      mpecho The power of Zadrian's ghost transfers into Grimdale and Mathius.
      mpmset self quest 2 6 23
      break
   endif
   if quest(2, 6, self) == 23
      mpecho The bright light quickly vanishes into the sarcophagus. 
      mpecho The lid of the sarcophagus slams shut.
      mppurge zadrian123
      mpmset self quest 2 6 24
      break
   endif
   if quest(2, 6, self) == 24
      mpecho Grimdale and Mathius both look at each other.
      mpmset self quest 2 6 25
      break
   endif
   if quest(2, 6, self) == 25
      say Your father, God rest his soul, has spoken.
      say Now heed his words and rule our Kingdom as one.
      say You now have the power of the Staff.
      mpmset self quest 2 6 26
      break
   endif
   if quest(2, 6, self) == 26
      mpmload 4717
      mpmload 4718
      mpmload 4719
      mpmload 4720
      mpecho General Jagoan and his guards show up!
      mpforce jagoan123 say Yes, and now that power belongs to me!
      mpforce jagoan123 say Guards! Seize them!
      mpecho One of the guards draws his sword and puts it to your throat!
      mpmset self quest 2 6 27
      break
   endif
   if quest(2, 6, self) == 27
      mpforce jagoan123 say Now hand over the Staff of Ruling!
      mpecho Grimdale hands over the staff with a defeated expression.
      mpmset self quest 2 6 28
      break
   endif
   if quest(2, 6, self) == 28
      mpforce jagoan123 say At last I have the Staff of Ruling.
      mpforce jagoan123 say Before I slit your fathers throat he told
      mpforce jagoan123 say me I could never succeed in my conquest.
      mpforce jagoan123 say Well, he was wrong!
      mpforce jagoan123 cackle
      mpforce jagoan123 say Guards! Kill them all!
      mpmset self quest 2 6 29
      break
   endif
   if quest(2, 6, self) == 29
      mpmload 4701
      mpmload 4708
      mpecho A dwarf guard and duergar guard show up!
      mpforce duergar say ATTACK!!!!
      mpforce dwarf say For Juargan!!!
      mpmset self quest 2 6 30
      break
   endif
   if quest(2, 6, self) == 30
      mpecho A Duergar Guard swings his sword and beheads a guard!
      mppurge guard1
      mpecho The Dwarf Guard thrusts his sword through a guards stomach!
      mppurge guard2
      mpecho Grimdale grabs the sword from the guard!
      mpecho Mathius draws his knife and slices his throat killing him!
      mppurge guard3
      mpmset self quest 2 6 31
      break
   endif
   if quest(2, 6, self) == 31
      mpecho Jagoan swipes the Staff of Ruling and takes off.
      mpecho Jagoan runs south.
      mptransfer jagoan123 4787
      mpecho You take off after Jagoan!
      mptransfer $r 4787
      mppurge dwarf 
      mppurge duergar
      mptransfer Mathius123 4788 
      mptransfer Grimdale123 4788
      mpgoto 4788
      mpmset self quest 2 6 32
      break
   endif
   if inroom($i) == 4789
       if quest(2, 6, self) == 32
          mpecho Siven, Grimdale and Mathius show up.
          mpecho Siven looks at you with awe.
          mpmset self quest 2 6 33
      else    
          if quest(2, 6, self) == 33 
             say You defeated the mighty Jagoan!
             say You are a brave warrior $r. 
             mpmset self quest 2 6 34
          else   
             if quest(2, 6, self) == 34
                mpecho You hand the Staff of Ruling over to Siven.
                say Thank you $r. 
                mpforce grimdale123 say Thank you for avenging the death
                mpforce grimdale123 say of our father $r.
                mpforce Mathius123 say We will both rule Juargan as one. 
                mptransfer Mathius123 4749
                mptransfer grimdale123 4732
                mpmset self quest 2 6 35
             else
                if quest(2, 6, self) == 35
                   mptransfer $r 4771
                   mpquiet on
                   goto 4771
                   mpquiet off
                   say For your courage and bravery $r,
                   say please except this reward.
                   mpoload 4733
                   give i4733 $r
                   say It was dug deep from the mines here. It might
                   say prove to be of use to you. It will restore your
                   say health, mana and movement while you sleep.
                   say Good luck to you $r.
                   mpmset self quest 2 6 36
                   mpmset $r quest 11 4 8 
                 endif
              endif
           endif
        endif
     endif
~
>speech_prog p problems~
if inroom($i) == 4771
 if quest(0, 4, $n) == 6
    tell $n I am very concerned about the welfare
    tell $n of our village. A dispute has been
    tell $n prominent now for several years between
    tell $n the two classes of Dwarves here in Juargan.
    mpmset $n quest 0 4 7
 endif
endif
~
>speech_prog p dwarves~
if inroom($i) == 4771
 if quest(0, 4, $n) == 7
    tell $n There are the small dwarves ruled by Mathius,
    tell $n and the duergar dwarves ruled by his
    tell $n brother Grimdale. They are both in search of
    tell $n the Staff of ruling.
    mpmset $n quest 0 4 8
 endif
endif
~
>speech_prog p staff~
if inroom($i) == 4771
 if quest(0, 4, $n) == 8
    tell $n The legendary staff holds a multitude of
    tell $n powers, and the one who carries it and
    tell $n follows the words written on it will
    tell $n gain the powers and strength to become
    tell $n the true King of Juargan. Unfortunately,
    tell $n fifteen years ago the former king of
    tell $n Juargan, Zadrian, also the father of
    tell $n Mathius and Grimdale, was forced to
    tell $n Destroy the staff.
    mpmset $n quest 0 4 9
 endif
endif
~
>speech_prog p destroy~
if inroom($i) == 4771
 if quest(0, 4, $n) == 9
    tell $n During this time fifteen years ago,
    tell $n the Great Dwarven War had broken out
    tell $n against the Ogre army led by the evil
    tell $n General Jagoan. King Zadrian was killed
    tell $n by Jagoan but not before Zadrian had
    tell $n destroyed the staff into three pieces
    tell $n and had them buried deep
    tell $n within the confines of the Mines.
    mpmset $n quest 0 4 10
 endif
endif
~
>speech_prog p mines~
if inroom($i) == 4771
 if quest(0, 4, $n) == 10
    tell $n The dwarves fought hard and were successful
    tell $n in driving General Jagoan out of Juargan,
    tell $n but ever since then Mathius and Grimdale
    tell $n have been feuding over who is the rightful
    tell $n heir to the throne. The dwarves split into
    tell $n two factions, the small dwarves led by
    tell $n Mathius, and the duergar dwarves led by
    tell $n Grimdale. Both factions claimed sections of
    tell $n the mines to themselves, and both are
    tell $n desperately seeking to find the pieces of
    tell $n the staff. The three pieces once joined
    tell $n together will transfer its power and
    tell $n energy to the one who holds it, and thus
    tell $n becomes the rightful Heir to the throne.
    mpmset $n quest 0 4 11
 endif
endif
~
>speech_prog p heir~
if inroom($i) == 4771
 if quest(0, 4, $n) == 11
    tell $n Before Zadrian died he confided in me that
    tell $n he wanted both of his sons to rule Juargan
    tell $n together as one. Despite my attempts to
    tell $n influence their thinking they are both
    tell $n stubborn and continue to carry on as seperatists.
    tell $n You must find the three pieces of the
    tell $n staff $n, and you MUST bring them to me.
    mpmset $n quest 0 4 12
 endif
endif
~
>all_greet_prog 100~
   if inroom($i) == 4771
     if quest(11, 4, $n) == 1
         tell $n Ahh $n, you have been successful
         tell $n in obtaining the pieces.
         tell $n Well Done!
         tell $n Give them to me please.
         mpmset $n quest 11 4 2
     endif
   endif
~
>give_prog i4723~
     if inroom($i) == 4771
       if quest(22, 1, $n) == 0
          mpmset $n quest 22 1 1
          smile $n
          mpjunk i4723
      else
          say I have no use for this!
          mpjunk i4723
      endif
    endif

     if quest(23, 1, $n) == 1
        if quest(24, 1, $n) == 1
           say Excellent. Now it is time to prove to these two men
           say that their father wanted them both to rule Juargan
           say together. Go and tell them both that "Siven beckons you."
           say and tell them to "meet him at the ancients tomb."
           say Do you understand?
        endif
     endif
