      if quest(7, 1, $n) == 0
          mpechoat $n You light the fuse and run for cover.
          mpecho KABOOM!!  KABOOM!!
          mpecho The granite wall crumbles to pieces.
          mpecho Something falls to the ground.
          mpquiet on
          get i4715 
