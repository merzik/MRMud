       if quest(11, 4, $n) == 6
           mpmset $n quest 11 4 7
           mpecho You thrust your weapon deeply into Jagoan's heart.
           mpecho You push Jagoan over the cliff as you release your weapon.
           mpecho You grab the Staff of Ruling from Jagoan before he goes over.
           mpquiet on
           goto 4788
           mpquiet off
           mptransfer siven123 4789
           mptransfer mathius123 4789
           mptransfer grimdale123 4789
           mppurge self
        endif
    endif
~
