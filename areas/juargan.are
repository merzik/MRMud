~
>speech_prog yes~
   if inroom($i) == 4732
      if quest(5, 2, $n) == 1
          tell $n I swear my men are useless. For several
          tell $n years now they have been searching for
          tell $n three pieces of a staff. My father broke
          tell $n the staff and buried them in three
          tell $n different areas of these mines in order
          tell $n to safeguard the village many years ago.
          tell $n This staff is very important to me.
          tell $n If you can help my men find the three 
          tell $n pieces I will reward you.
          mpechoat $n $I smiles at you perversely.
          mpmset $n quest 5 2 2
      endif
   endif
~
>all_greet_prog 100~
     if quest(11, 4, $n) == 1
        tell $n Ahh, Well done! You found the
        tell $n three pieces. Give them to me
        tell $n and I shall reward you.
        mpmset self quest 9 1 1 
     endif
~
