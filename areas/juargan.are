>rand_prog 30~
   if inroom($i) == 4787
      if quest(11, 4, $r) == 4
         rescale 4717 $r 110
         mpecho You catch up to Jagoan.
         say If you know whats good for ya, 
         say ya little runt, you will leave now.
         mpforce $r say Hand over the Staff or else I will strike you down!
         mpecho $I laughs at you insanely.
         mpecho $I runs north.
         mpmset $r quest 11 4 5
         mptransfer $r 4789
         mpquiet on
         goto 4789
         mpquiet off
       else
         say You arnt worth my time!
         mptransfer $r 4700
         mppurge self
       endif
   endif

   if inroom($i) == 4789
        if quest(11, 4, $r) == 5
         mpmset $r quest 11 4 6
         mpquiet on
         cast bless self
         mpquiet off
         say Ok you little runt! You are really pissing me off now.
         say Time for you to die!!
         mpkill $r
       endif
   endif
~
>fight_prog 25~
    mpquiet on
    c 'magic missile' $n
    mpquiet off
    mpecho {110}$I drop kicks you in the head!
~

>death_prog 100~
