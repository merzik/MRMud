#28249
kingquestmobeth~
The King Ethereal~
(Regal Aura) The King fades about here.~
This mob makes it a little more difficult for those without the source
area file to figure out some of the mob speechprogs.~
ACT_BODY|ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_WEAK
AFF_TONGUES|AFF_UNDERSTAND|AFF_ETHEREAL|AFF_INVISIBLE|AFF_DETECT_INVIS 
0 S
1 BODY_HEAD BODY_HEAD 1d1+10 1d1+6
1 RACE_HUMAN
POS_STANDING POS_STANDING SEX_NEUTRAL
>speech_prog cough~
 if quest(0,2,$n) == 1
  if quest(10,5,$n) == 0
   mpechoat $n The King looks at you and seems to notice that you are in his presence.
   mpechoaround $n The King looks at $n.
   mpecho The King clears his throat.
   mpecho {030}The King says 'It's nothing. I've had it for many years. Actually, it'{300}
   mpecho {030}The King says 'is more an inconvenience than anything else. The Cook'{300}
   mpecho {030}The King says 'used to make a remedy that would stop me from coughing'{300}
   mpecho {030}The King says 'all the time...'{300}
   mpecho The King sighs.
   mpmset $n quest 10 5 1
  endif
 endif
~
>speech_prog reward~
 if quest(0,2,$n) == 2
  mpquiet on
   mpoload 28225
   mpoload 28226
   mpoload 28227
   mpoload 28229
   mpoload 28231
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   if rand(25)
    mpoload 28228
    c 'remove curse'
    drop i28228
   endif
   if rand(25)
    mpoload 28230
    c 'remove curse'
    drop i28230
   endif
   drop i28225
   drop i28226
   drop i28227
   drop i28229
   drop i28231
   mpjunk all
  mpquiet off
  mpecho {030}The King says 'Here, take these as a token of my appreciation, $n.'{300}
  mpechoat $n The King places some items in front of you.
  mpechoat $n The King winks at you and wishes you all the best.
  mpechoaround $n The King winks at $n.
  mpmset $n quest 0 2 3
 endif
~
>speech_prog prophet~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 0
   mpechoat $n The King looks at you and appears to think to himself for a time.
   mpechoaround $n The King looks at $n.
   mpecho {030}The King says 'The Prophet watches over us all.'{300}
   mpmset $n quest 10 5 1
  endif
 endif
~
>speech_prog watches~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 1
   mpecho The King smiles at something.
   mpecho {030}The King says 'The Prophet is a quiet man. He used to come and go'{300}
   mpecho {030}The King says 'from time to time, always arriving in time to help'{300}
   mpecho {030}The King says 'prevent something dire from occurring.'{300}
   mpecho The King sighs.
   mpmset $n quest 10 5 2
  endif
 endif
~
>speech_prog time~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 2
   mpecho {030}The King says 'The Prophet is a wise man, his council is always'{300}
   mpecho {030}The King says 'welcome... as a mentor as well as a friend.'{300}
   mpecho The King looks over your shoulder and sighs.
   mpecho {030}The King says 'I have not seen the Prophet for two of your mortal'{300}
   mpecho {030}The King says 'lifetimes. I have waited an age to speak with him.'{300}
   mpmset $n quest 10 5 3
  endif
 endif
~
>speech_prog speak~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 3
   mpecho {030}The King says 'Yes, he was one of the few people I could really'{300}
   mpecho {030}The King says 'trust to remain true in the face of adversity.'{300}
   mpecho {030}The King says 'The Prophet used to spend time with a lot of the'{300}
   mpecho {030}The King says 'household actually... a very respected man.'{300}
   mpmset $n quest 10 5 4
  endif
 endif
~
>speech_prog gift~
 if quest(2,2,$n) == 2
  mpquiet on
   mpoload 28232
   mpoload 28233
   mpoload 28236
   mpoload 28237
   mpoload 28238
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   c 'remove curse'
   if rand(25)
    mpoload 28234
    c 'remove curse'
    drop i28234
   endif
   if rand(25)
    mpoload 28235
    c 'remove curse'
    drop i28235
   endif
   drop i28232
   drop i28233
   drop i28236
   drop i28237
   drop i28238
   mpjunk all
  mpquiet off
  mpechoat $n The King places some items in front of you.
  mpechoat $n The King murmurs something and they both chuckle quietly.
  mpechoat $n {030}The Prophet says 'If you ever need my help, use the rune.'{300}
  mpechoat $n {030}The Prophet says 'I'm sure we will speak again.'{300}
  mpechoat $n The Prophet places some more items in front of you.
  mpechoat $n The Prophet smiles at you before wandering off.
  mpmset $n quest 2 2 3
  mpmset $n quest 10 5 0
 endif
~
|
