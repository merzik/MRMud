  mpecho The Quartermaster takes the dead Toad from you and carefully examines it.
  mpecho {030}The Quartermaster says 'That's the one alright. Two more and I'll have'{300}
  mpecho {030}The Quartermaster says 'that staff ready for you.'{300}
  mpecho The Quartermaster mutters to himself and carefully puts the Toad aside.
  mpquiet on
   mpjunk all
  mpquiet off
  mpmset $n quest 23 3 5
  break
 endif
 if quest(23,3,$n) == 5
  mpecho The Quartermaster takes the dead Toad from you and carefully examines it.
  mpecho {030}The Quartermaster says 'That's the one alright. One more and I'll have'{300}
  mpecho {030}The Quartermaster says 'that staff ready for you.'{300}
  mpecho The Quartermaster mutters to himself and carefully puts the Toad aside.
  mpquiet on
   mpjunk all
  mpquiet off
  mpmset $n quest 23 3 6
  break
 endif
 if quest(23,3,$n) == 6
  mpecho The Quartermaster takes the dead Toad from you and carefully examines it.
  mpecho {030}The Quartermaster says 'That's the last one! Thank you, $n.'{300}
  mpecho {030}The Quartermaster says 'You have made me and my customers very happy!'{300}
  mpecho The Quartermaster mutters to himself and carefully puts the Toad aside.
  mpecho {030}The Quartermaster says 'This staff is said to be able to transport you'{300}
  mpecho {030}The Quartermaster says 'to a hidden glade in the mountains. The secret'{300}
  mpecho {030}The Quartermaster says 'of how it works has, alas, been lost.'{300}
  mpecho {030}The Quartermaster says 'The man who traded it to me gave me this valuable'{300}
  mpecho {030}The Quartermaster says 'shield as well. Please treasure it for me.'{300}
  mpecho The Quartermaster fumbles and the shield almost hits the ground!
  whew
  mpquiet on
   mpoload 6215
   mpoload 6245
   cast 'remove curse'
   cast 'remove curse'
   give i6245 $n
   cast 'giant strength' $n
   give i6215 $n
   drop i6215
   mpjunk all
  mpquiet off
  mpmset $n questr 6200 8 1 0
  mpmset $n quest 23 3 7
  mpechoat $n The Quartermaster thanks you again.
 endif
~
