>speech_prog p DEBUG EXTRA QUEST ONE~
 if quest(20,3,$n) == 0
  mpechoat $n You have not visited the Cook and asked her to prepare the duck.
  mpechoat $n Debug information: (20,3,$n)==0
 endif
 if quest(20,3,$n) == 1
  mpechoat $n You have asked the Cook to prepare the duck.
  mpechoat $n Debug information: (20,3,$n)==1
 endif
 if quest(20,3,$n) == 2
  mpechoat $n You have said SALT to the Gypsy woman for the first time.
  mpechoat $n Debug information: (20,3,$n)==2
 endif
 if quest(20,3,$n) == 3
  mpechoat $n You have said SALT to the Gypsy woman for the second time.
  mpechoat $n Debug information: (20,3,$n)==3
 endif
 if quest(20,3,$n) == 4
  mpechoat $n You have delivered the note to the Guard.
  mpechoat $n Debug information: (20,3,$n)==4
 endif
 if quest(20,3,$n) == 5
  mpechoat $n You have returned to the Gypsy and said MIDNIGHT to her.
  mpechoat $n Debug information: (20,3,$n)==5
 endif
 if quest(20,3,$n) == 6
  mpechoat $n You have given the salt to the Cook and been asked if you need bread.
  mpechoat $n Debug information: (20,3,$n)==6
 endif
 if quest(20,3,$n) == 7
  mpechoat $n You have returned to the Cook, said FRESH WHOLEMEAL BREAD to her.
  mpechoat $n You have been given the loaf of bread and the cooked duck.
  mpechoat $n Debug information: (20,3,$n)==7
 endif
~
