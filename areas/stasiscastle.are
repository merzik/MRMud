>speech_prog p would you prepare this for me, please?~
 if actorhasobjnum (6210)
  if quest(20,3,$n) == 0
   say Ah... I see you have been hunting! It's not very often I get
   say the chance to cook such a handsome looking beast as this.
   say Well, enough gossip. If you can find some salt for the meat
   say I'll get on with preparing this duck.
   mpforce $n give i6210 cookgardenquest
   mpquiet on
    mpjunk all
   mpquiet off
   mpmset $n quest 20 3 1
  endif
 endif
