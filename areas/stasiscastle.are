   mpmset $n quest 10 5 14
  endif
 endif
 mpquiet on
 mpoload 28208
  drop i28208
  mpjunk all
 mpquiet off
 mpecho Some firewood falls to the ground.
~
>death_prog 10~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 21
   mpquiet on
    mpoload 28212
    drop i28212
    mpjunk all
   mpquiet off
   mpecho A branch falls to the ground.
   mpmset $n quest 10 5 22
  endif
 endif
~
