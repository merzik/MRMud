>speech_prog p RESET VERSION BLAPHF~
  mpmset $n quest 32 2 0
  mpechoat $n Version bits reset.
~
>speech_prog p RESET QUEST ONE BLAPHF~
  mpmset $n quest 0 2 0
  mpmset $n quest 10 5 0
  mpechoat $n Quest One bits reset.
~
>speech_prog p RESET QUEST TWO BLAPHF~
  mpmset $n quest 2 2 1
  mpmset $n quest 10 5 0
  mpechoat $n Quest Two bits reset.
~
>speech_prog p RESET QUEST THREE BLAPHF~
  mpmset $n quest 4 2 0
  mpmset $n quest 16 4 0
  mpechoat $n Quest Three bits reset.
~
>speech_prog p RESET QUEST FOUR BLAPHF~
  mpmset $n quest 6 4 0
  mpechoat $n Quest Four bits reset.
~
>speech_prog p RESET GARDEN QUEST ONE BLAPHF~
  mpmset $n quest 20 3 0
  mpechoat $n Garden quest bits reset.
~
>speech_prog p RESET MIST JUNK BLAPHF~
  mpmset $n quest 26 4 0
  mpechoat $n Garden quest bits reset.
~
>speech_prog p RESET QUEST FIVE BLAPHF~
  mpmset $n quest 23 3 0
  mpmset $n questr 6200 8 1 0
  mpechoat $n Quest Five bits reset.
~

