#28207
prophet~
The Prophet~
(Saviour Aura) The Prophet.
~
The Prophet.
~
ACT_BODY|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND
0 S
95 BODY_HEAD BODY_HEAD 80d80+4800 6d6+80
15007 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>fight_prog 99~
 rescale 28207 $n 200
~
>all_greet_prog 100~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 9
   mpechoat $n The Prophet smiles as you walk in.
   say Welcome, $n.
   say I've been watching over you for some time now.
   say It's good to finally meet you in person.
   mpecho The Prophet stares off into space.
   mpmset $n quest 10 5 10
  endif
  if quest(10,5,$n) == 18
   mpechoat $n The Prophet smiles as you walk in.
   say Welcome back, $n.
   say I was watching some of those battles, and you
   say fought well. Could I have the key please?
   mpmset $n quest 10 5 19
  endif
 endif
~
>speech_prog king~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 10
   say The King is an honourable man. I miss our long
   say talks about philosophy and politics. You did a
   say fine thing helping him with that cough of his!
   say I sense you are honourable also.
   mpmset $n quest 10 5 11
  endif
 endif
~
>speech_prog honourable~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 11
   say It's a trait not all possess it appears. There
   say are forces afoot that would prefer to see the
   say King dead it appears.
   mpmset $n quest 10 5 12
  endif
 endif
~
>speech_prog forces~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 12
   say I cannot speak of prophecy aloud to one such
   say as you. Powerful forces surround your very fibre
   say and disrupt the natural order. I must leave
   say this place and prevent these evil events.
   say I need you to retrieve a kind of key for me.
   mpmset $n quest 10 5 13
  endif
 endif
~
>speech_prog key~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 13
   say Yes, you will know it when you find it. The
   say King will show you a hidden passage if you
   say give him the seal... we struck a bargain
   say many years ago.
   say You will need to battle some powerful wizards
   say to get the key.
   say When you are ready, say READY
   mpmset $n quest 10 5 14
  endif
 endif
~
>speech_prog ready~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 14
   mpecho The Prophet extends his hands and closes his eyes.
   mpechoat $n The world jumps sideways and you find yourself somewhere else.
   mpmset $n quest 10 5 15
   mptransfer $n 28260
  endif
  if quest(10,5,$n) == 20
   mpecho The Prophet extends his hands and closes his eyes.
   mpechoat $n The world jumps sideways and you find yourself somewhere else.
   mpmset $n quest 10 5 21
   mptransfer $n 28260
  endif
 endif
~
>give_prog i28210~
  if quest(2,2,$n) == 1
   if quest(10,5,$n) == 19
    mpecho The Prophet inserts the key into a hole in the stone wall.
    mpecho The wall begins to glow white.
    say I need you to bring me a branch from the Forest
    say so I can fashion a staff. Without the staff, I
    say would not be able to return here.
    say Take this rune, it will allow you to return.
    mpquiet on
     mpjunk i28210
     mpoload 28211
     cast 'giant strength' $n
     give i28211 $n
     drop i28211
     mpjunk i28211
    mpquiet off
    mpechoat $n The Prophet gives you a rune.
    mpechoaround $n The Prophet gives $n a rune.
    say When you are ready, say READY
    mpmset $n quest 10 5 20
    break
   endif
  endif
  give $n i28210
  drop i28210
  mpechoat $n The Prophet doesn't notice you.
  mpechoaround $n The Prophet completely ignores $n.
~
>speech_prog whoa!~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 22
   say Welcome back, $n.
   say I was watching some of those battles, and you
   say fought well. Could I have the branch please?
   mpmset $n quest 10 5 23
  endif
 endif
 if quest(2,2,$n) >= 2
  chuckle
  say I can open a portal to several locations that you
  say may find of use. Just say the word and I will
  say open them.
  say Chakkor (the fountain)
  say Passage (the hidden passage)
  say Mist (the center of the north edition)
  smile
 endif
~
>give_prog i28212~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 23
   mpechoat $n The Prophet looks it over for a while.
   mpechoaround $n The Prophet looks at the branch for a while.
   mpecho The Prophet passes his hands over the branch making it straight.
   say Perfect!
   say You have done well this day, $n.
   say Shall we go and visit the King?
   mpmset $n quest 10 5 24
   mpjunk all
  endif
 endif
~
>speech_prog chakkor~
 if quest(2,2,$n) >= 2
  bow
  mptransfer $n 9755
  tell $n Thank you... drive thru!
  mpat 9755 mpechoaround $n You hear a loud pop as $n magically appears.
 endif
~
>speech_prog passage~
 if quest(2,2,$n) >= 2
  bow
  mptransfer $n 28259
  tell $n Thank you... drive thru!
  mpat 28259 mpechoaround $n You hear a loud pop as $n magically appears.
 endif
~
>speech_prog mist~
 if quest(2,2,$n) >= 2
  bow
  mptransfer $n 10967
  tell $n Thank you... drive thru!
  mpat 10967 mpechoaround $n You hear a loud pop as $n magically appears.
 endif
~
>speech_prog yes~
 if quest(2,2,$n) == 1
  if quest(10,5,$n) == 24
   smile $n
   say stasis
   mpecho The wall shimmers and a door appears in the northern wall.
   mpmset $n quest 10 5 25
   mpquiet on
    mpforce $n follow prophet
    mpforce $n speed walk
   mpquiet off
   speed walk
   west
   north
   north
   mpquiet on
    mpforce $n follow self
    goto 28242
   mpquiet off
  endif
 endif
~
