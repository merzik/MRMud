#212
tristan kendrick king~
King Tristan Kendrick~
King Tristan Kendrick sits in his throne looking at you.~
He looks regal and demands your attention.~
ACT_SENTINEL|ACT_SMART|ACT_BODY|ACT_RACE
AFF_DETECT_INVIS|AFF_SANCTUARY|AFF_UNDERSTAND|AFF_TONGUES
500 S
85 BODY_HEAD BODY_HAND|BODY_FOOT 10d10+6500 2d10+70
200000 RACE_HUMAN
POS_RESTING POS_RESTING SEX_MALE
>greet_prog 100~
if quest(0, 4, $n) == 0
  say I have been waiting for a hero like you.
  say An evil has entered the land.  I need you to destroy it for me.
  say Talk to my non-human allies to get help.
  say When you have killed the Darkwalker, return to me.
  mpmset $n quest 0 4 1
else
  if quest(0, 4, $n) == 5
    say You have destroyed the Darkwalker and saved the Moonshae Islands.
    say Please take this in gratitude.
    mpoload 217
    mpmset $n quest 0 4 6
    give breastplate $n
  else
    if quest(0, 4, $n) > 5
      say Greetings, $n, Savior of Corwell.
      if quest(7, 2, $n) == 0
        say I am glad you have returned, $n.
        say A fugative has escaped our justice and must
        say be tracked down.  Will you help us?
      endif
    else
      say Have you destroyed the Darkwalker yet?
    endif
  endif
endif
~
>give_prog i6203~
if quest(9, 2, $n) == 1
  say You have served our kingdom well, $n
  say You have our gratitude.
  mpoload 231
  give i231 $n
  mpjunk all
  mpmset $n quest 9 2 2
endif
~
>all_greet_prog 0~
if class($n) == 6
  if quest(30, 1, $n) == 0
    shout I have banished a filthy assassin!
    mpmset $n quest 30 1 1
  else
    mptransfer $n 2899
    mpat $n mpforce $n say I am a loser!
    shout I have sent a backstabbing assassin to hell!
  endif
endif
~
>speech_prog spy scout ascarle invasion~
if quest(9, 2, $n) == 0
  say I have been looking for someone and I think
  say you will do superbly.  Scout the ruins of
  say Ascarle and work what sabotage you may.
  say If you can bring back the head of the leader.
  mpmset $n quest 9 2 1
endif
~
>give_prog i227~
mpmset $n quest 7 2 0
mpjunk all
say So you want to track down another killer?
~
>give_prog i230~
mpmset $n quest 7 2 0
mpjunk all
say So you want to track down another killer?
~
>give_prog i229~
mpmset $n quest 7 2 0
mpjunk all
say So you want to track down another killer?
~
>speech_prog yes ok sure yep~
if quest(0, 4, $n) > 5
  if quest(7, 2, $n) == 0
    say Thank you $n.
    say This will help you track the murderer down.  He
    say was last seen on a ship headed towards Tethyr.
    if rand(40)
      mpoload 227
      give i227 $n
    else
      if rand(40)
        mpoload 229
        give i229 $n
      else
        mpoload 230
        give i230 $n
      endif
    endif
    say Please track him down and kill him, You may keep
    say whatever he has on him.
    mpmset $n quest 7 2 1
  endif
endif
~
