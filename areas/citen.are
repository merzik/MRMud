50000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 80~
if ispc($n)
  if whichgod($n) == 1
    frown 
    mpecho The githzerai takes a closer look at $n.
    shout Guards! Guards! Our city is under attack by stagnant Order scum!
    mpkill $n
  else
    if whichgod($n) == 2
      say Greetings, $n
    else
      if whichgod($n) == 3
        say Putrid Demise slime!
        glare $n
      else
        if rand(20)
        MPECHO The githzerai citizen mutters something about outsiders in his city.
        endif
      endif
    endif
  endif
endif
~
|
#13305
death slaad~
the Death Slaad~
The greatest slaad of their race stands imperiously before you.~
The Slaad has changed it shape to resemble a miniature version of Gozai, the
titan primarily responsible for the construction of the City of Entropy.~
ACT_SENTINEL|ACT_SMART|ACT_BODY|ACT_RACE
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_SANCTUARY|AFF_INFRARED|AFF_UNDERSTAND|AFF_PROTECT_EVIL|AFF_TONGUES
0 S
150 BODY_HEAD|BODY_LEG|BODY_ARM|BODY_HAND BODY_HEAD|BODY_LEG|BODY_ARM 2d750+18000 10d10+100
531514 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if ispc($n)
  if whichgod($n) == 2
    say Greetings, friend. Please enter your city.
    cast "sanctuary" $n
    mptransfer $n 13314
    mpat 13314 MPFORCE $n look
  else
    if whichgod($n) == 1
       say You!!! You dare to profane this city with your presence ??
      say You may never pass into our city.
      if level($n) >= 65
        say I must rid the world of your insane concepts of Law and Order.
        mpkill $n
      else
        say You must leave this place at once, your presence offends me.
        mptransfer $n 13308
        mpat 13308 mpforce $n look
      endif
   else
    if whichgod($n) == 3
      say Foolish mortal. Decay has it's place but not in this city.
      say You may not pass.
      if level($n) >= 65
        mpkill $n
      else
        say You must leave this place at once, your presence offends me.
        mptransfer $n 13308
        mpat 13308 mpforce $n look
      endif
    else
      say You may pass, $n. Though, I do have my reservations...
      mptransfer $n 13314
      mpat 13314 MPFORCE $n look
    endif
  endif
 endif
endif
~
>fight_prog 99~
if rand(55)
  cast "acid blast" $n
else
  if rand(40)
    mpquiet on
    cast "heal" self
    cast "heal" self
    cast "heal" self
    mpquiet off
  endif
endif
~
|

