>all_greet_prog 80~
if ispc($n)
  if whichgod($n) == 1
    say Defend thyself as best you can, $n
    smirk 
    mpkill $n
  else
    if whichgod($n) == 2
      nod $n
  else 
    if whichgod($n) == 3
      eyebrow $n
      roll $n
    endif
  endif
endif
~
>entry_prog 80~
if ispc($r)
  if whichgod($r) == 1
    say Prepare to meet your pathetic god, $r
    smirk 
    mpkill $r
  else
    if whichgod($r) == 2
      nod $r
  else 
    if whichgod($r) == 3
      eyebrow $r
      roll $r
    endif
  endif
endif
~
>rand_prog 15~
mpechoat $r The Gray Slaad looks at you suspiciously.
~
>fight_prog 99~
if rand(12)
  mpechoat $n The Gray Slaad rakes its claws across your chest.
  mpquiet ON
  cast "poison" $n
  mpquiet OFF
  if rand(8)
    cast "weaken" $n
  endif
endif
~
