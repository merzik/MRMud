>speech_prog leave~
if whichgod($n) == 2
  nod $n
  mptransfer $n 13309
  mpat 13309 mpforce $n look
else
  if whichgod($n) == 1 or whichgod($n) == 3
    bow $n
    say Your slightest whim is my strongest desire.
    cackle 
    mptransfer $n 13308
    mpat 13308 MPFORCE $n look
  else
    say Leaving the city will cost you 10,000 gold pieces...
    laugh $n
  endif
endif
~
>bribe_prog 10000~
if whichgod($n) == 2 
  say Are you crazy, $n ??
  give 10000 coins $n
else
  if whichgod($n) == 1 or whichgod($n) == 3
    say Aaaaaaaaaaww...shucks...a gift..?
    say For lil' ol' me ?
    say How sweet
    ruffle $n
    cast "faerie fire" $n
  else
    say Thanks...hmmm...I'll just make sure it's all here...
    mpecho The Gate keeper takes his time counting the gold. 
    smile 
    say Come again some time, $n
    mptransfer $n 13300
    mpat 13300 MPFORCE $n look
  endif
endif
~
>fight_prog 99~
if rand(40)
  cast "earth"
else
  if rand(35)
    cast "acid" $n
  else
    if rand(20)
      cast "heal" self
    endif
  endif
endif
~
>rand_prog 25~
say Eh! Gringo! I can let you LEAVE the city if you reaaaally want to...
~
