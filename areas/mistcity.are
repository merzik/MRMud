>death_prog 100~
if actorhasobjnum(30900)
or actorhasobjnum(30966)
or actorhasobjnum(30967)
or actorhasobjnum(30968)
or actorhasobjnum(30969)
  if quest(30,1,$n) == 0
    mpmset $n quest 30 1 1
    mpoload 30914
    mpforce $n HELP GUILDTOKEN
    mpquiet on
    c 'giant strength' $n
    give i30914 $n
    mpquiet off
  endif
endif~
