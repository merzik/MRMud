#AREA Mob Factory~
#AUTHORS PinkF  ~





#HELPS
-1 MOB_FACTORY_CHANGES~
01.10.05 - Added color and effects to the Obelisk. (Mag)
~
-1 MOB FACTORY 'MOB FACTORY'~
MOB FACTORY
The mob factory is run by overseer Brandil with an iron fist.  He has
gathered some of the best magicians in the land to help him create or
summon monsters to be dispersed throughout the realms.

{110}Area revised/quest added by McMac and Yosho (2001){300}
~
0 $~




#RANGES 5 10 0 99
#MOBILES
#9400
ethereal obeliskguy2~
The ethereal obelisk guy~
The ethereal obelisk guy is here.~
This mob should be invisible to you.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY|ACT_RACE|ACT_UNDEAD
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_TONGUES|AFF_ETHEREAL
0 S
90 BODY_HEAD BODY_LEG 1d10+10000 1d10+100
292510 RACE_DWARF
POS_STANDING POS_STANDING SEX_MALE
>speech_prog chakkor tower~
  if level($n) < 18
    mpecho {170}The obelisk glows with energy.{300}
    mpechoaround $n $n fades out of existence.
    mpechoat $n {170}You disappear suddenly!{300}
    mptransfer $n 9735
    mpgoto 9735
    mpechoaround $n {170}The obelisk glows with energy.{300}
    mpechoaround $n $n appears at the base of the obelisk!
    mpforce $n look
    mpechoat $n {170}You have arrived in Chakkor.{300}
    mpgoto 9400
  else
    mpechoat $n You are too big to call on the aid of the obelisk.
  endif
~
|
#9401
beasthound hound dog~
The beasthound~
The beasthound is here, his eyes glowing green!~
The beasthound stalks back and forth, back bristling with
thick black hair, eyes gleaming with madness and fury.~
ACT_SMART|ACT_STAY_AREA|ACT_WIMPY
AFF_TONGUES|AFF_DETECT_INVIS|AFF_DETECT_HIDDEN
-700 S
14 0 0 1d75+100 1d13+5
5 822
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 20~
if quest (12,3,$n) < 6
   growl $n
   emote begins growling deep in the back of its throat.
endif
~
>death_prog 100~
if quest (12,3,$n) < 6
   emote falls to the ground and breathes its last.
   mpmadd $n quest 12 3 1
endif
~
|
#9402
overseer brandilmob~
Overseer Brandil~
The Overseer is here, making plans for the future.~
In his late middle years, Brandil is a retired adventurer
and warrior.  He is very tall, and has a chiselled look
about him.  He seems a bit grim, but is obviously very
dedicated to the training of young warriors.~
ACT_SMART|ACT_SENTINEL|ACT_STAY_AREA|ACT_NO_ORDER
AFF_TONGUES|AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_SANCTUARY
2 S
22 0 0 2d100+100 2d9+9
1000 2918
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest (0,3,$n) == 0
   salute $n
   say Hail, brave adventurer!
   say Do you seek challenges?
endif
if quest (3,3,$n) == 6
   say EXCELLENT! The Cityguard Heads are difficult,
   say and you've shown your worth indeed!
   mpoload 9402
   give i9402 $n
   mpmset $n quest 3 3 7
endif
if quest (6,3,$n) == 6
   say Wafer golems are easily created, easily
   say destroyed. I congratulate you, however
   say I suggest you seek bigger game.
   wink $n
   mpoload 9403
   give i9403 $n
   mpmset $n quest 6 3 7
endif
if quest (9,3,$n) == 6
   grin
   say I see you're coveredin slimey slime guts.
   say Your reward will be a clean bath!
   mpoload 9405
   give i9405 $n
   mpmset $n quest 9 3 7
endif
if quest (12,3,$n) == 6
   say Excellent work on those beasthounds!
   say They're tough nuts to crack, and I should
   say know, I created them.
   pat $n
   mpoload 9406
   give i9406 $n
   mpmset $n quest 12 3 7
endif
if quest (15,3,$n) == 6
   sigh
   say I should have set up more guidelines to this
   say game. Oh well, I can hire new workers.
   grumble
   mpoload 9407
   give i9407 $n
   mpmset $n quest 15 3 7
endif
if quest (18,3,$n) == 6
   chuckle
   say Technically the summoners are my employees,
   say not my creations, but we'll overlook it.
   mpoload 9404
   give i9404 $n
   say Keep up the good work.
   mpmset $n quest 18 3 7
~
>speech_prog yes yep ya sure~
if quest (0,3,$n) == 0
   nod $n
   say Well and good!
   say I have created many creatures to battle with.
   say Each type will challenge you differently.
   say Slay them as you may, and learn from them.
   say Occasionally return to me, and if I find
   say that you have grown sufficiently I shall
   say reward you accordingly.
   mpmset $n quest 0 3 1
endif
~
>death_prog 100~
if quest (0,3,$n) == 1
   scream
   say I didn't mean to teach you THIS!
   emote bleeds all over himself.
   mpmset $n quest 0 3 2
   mpoload 9400
   mpoload 9408
   mpquiet on
   remove fist
   drop fist
   drop i9408
   mpquiet off
   recho The Overseer's soul slips from his mortal body.
endif
if actorhasobjnum(30900)
  if quest(30,1,$n) == 0
    mpmset $n quest 30 1 1
    mpoload 30914
    mpforce $n HELP GUILDTOKEN
    mpquiet on
    c 'giant strength' $n
    give i30914 $n
    mpquiet off
  endif
endif
if level($n) > 20
mpjunk i9400
endif
~
|
