#AREA Hartsvale~
#AUTHORS Blythe~




#HELPS
-1 HARTSVALE~
{110}Hartsvale

{160}Hartsvale is an area based on the The Twilight Giants trilogy by Troy Denning.
They are part of TSR's Forgotten Realms books.  The kingdom of Hartsvale is a 
land where giants and giant kin are as common as humans.  It is even rumoured 
that some of the humans may have giant kin in their ancestry.

There are two quests in the area, one starting at the Titan of Twilight
(yielding level 90 ac/mana equip) and the other starting at
Brianna of Hartwick (yielding level 65 damage and ac gear).

NB: The giants of Hartsvale are very suspicious of assassins.

{110}(a) Area created by Blythe

{160}Last updated 14th December 1998{300}

{a}BLYTHE
~
0 $~




#RANGES 70 95 0 99
#FLAGS AFLAG_NODEBUG
#MOBILES
#5700
brianna hartwick queen~
Brianna of Hartwick~
Brianna of Hartwick stands here.~
A regal woman looks at you haughtily.  She stands near 7 feet tall. 
She looks very young to be the queen of Hartsvale.~
ACT_SENTINEL|ACT_SMART|ACT_BODY|ACT_RACE
AFF_DETECT_INVIS|AFF_SANCTUARY|AFF_UNDERSTAND|AFF_TONGUES
0 S
95 BODY_HAND BODY_HAND|BODY_FOOT 10d10+14000 2d10+80
359620 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>all_greet_prog 100~
if quest(0, 4, $n) == 0
  say Welcome to my court $n.
  say I'm sorry you have not come at a happier time.  
  say I am trying to find a traitor among us.  
  say If we don't find the traitor, 
  say I will be taken to Twilight Vale
  say against my will.  Will you help me find the traitor?
  emote looks at you enquiringly.
  mpmset $n quest 0 4 1
else
  if quest(0, 4, $n) == 7
    if sex($n) == 1
      mpmset $n long Lord $n of Hartsvale is here.
      say Welcome $n,
      say I knight thee Lord $n of Hartsvale 
      say for your great service to the crown!
    else
      mpmset $n long Lady $n of Hartsvale is here.
      say Welcome $n,
      say I knight thee Lady $n of Hartsvale 
      say for your great service to the crown!
    endif
    mpmset $n quest 0 4 8
  else
    if quest(0, 4, $n) == 1
      nod $n
    else
      if quest(0, 4, $n) == 8
        if sex($n) == 1
          say Welcome Lord $n of Hartsvale.
        else
          say Welcome Lady $n of Hartsvale.
        endif
      else
        say Have you found the traitor among us yet $n?
      endif
    endif
  endif
endif
~
>speech_prog yes~
if quest(0, 4, $n) == 1
say Go see Basil the Veeberg.
say He will tell you something that may help you.
mpmset $n quest 0 4 2
break
else
say Yes? Yes what?
peer $n
endif
~
>death_prog 1~
mpoload 5733
~
>give_prog i5736~
if quest(5, 4, $n) == 3
  mpecho Brianna drinks the Potion.
  mpecho Brianna's eyes glaze over.
  mpmset $n quest 5 4 4
endif
~
>speech_prog p Come to Twilight Vale with me.~
if quest(5, 4, $n) == 4
  mpechoat $n The Queen looks at you in a daze.
  say I will do what you say, $n.
  mpechoat $n You take the queen by the hand and lead her from the castle.
  mpmset $n quest 5 4 5
  mpmset self quest 12 4 0
endif
~
>rand_prog 100~
if quest(5, 4, $r) == 5
  if quest(12, 4, self) == 0
    if rand (50)
      if inroom($i) == 5705
        connect 1 5736
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r east
        east 
        mpat 5705 connect 1 -1
        mpmset self quest 12 4 1
        break
      endif
    endif
  endif
  if quest(12, 4, self) == 1
    if rand (50)
      if inroom($i) == 5736
        connect 0 5753
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r north
        north 
        mpat 5736 connect 0 -1
        mpmset self quest 12 4 2
        break
      endif
    endif
  endif
  if quest(12, 4, self) == 2
    if rand (50)
      if inroom($i) == 5753
        connect 0 5756
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r north
        north 
        mpat 5753 connect 0 5754
        mpmset self quest 12 4 3
        break
      endif
    endif
  endif
  if quest(12, 4, self) == 3
    if rand (50)
      if inroom($i) == 5756
        connect 0 5773
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r north
        north 
        mpat 5756 connect 0 5764
        mpmset self quest 12 4 4
        break
      endif
    endif
  endif
  if quest(12, 4, self) == 4
    if rand (50)
      if inroom($i) == 5773
        connect 0 5780
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r north
        north 
        mpat 5773 connect 0 5778
        mpmset self quest 12 4 6
        break
      endif
    endif
  endif
  if quest(12,4, self) == 6
    if rand (50)
      if inroom($i) == 5780
        mpechoat $r You mutter to yourself under your breath as you try to remember how to get back
        mpechoat $r to the Twilight Vale...
        mpforce $r north
        north 
        mpmset self quest 12 4 7
        break
      endif
    endif
  endif
  if quest(12, 4, self) == 7
    if rand (50)
      if inroom($i) == 5735
        mpmset $n quest 5 4 6
        mpechoat $r A-ha! This is they way back!
        mpforce $r north
        north 
        mpmset self quest 12 3 8
        mppurge $i
        break
      endif
    endif
  endif
endif
~
