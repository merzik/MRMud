287052 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(0, 4, $n) == 5
  say So! That little rat Avner is telling tales?  
  say Well I will get Brianna to Twilight Vale.
endif
~
>death_prog 100~
if quest(0, 4, $n) == 6
  mpmload 5706
  mpecho Another head bursts out of Arlien's armour, as you watch in horror!
  mpforce julien mpkill $n
endif
