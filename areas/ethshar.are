ACT_SENTINEL|ACT_SMART|ACT_BODY|ACT_RACE
0
0 S
1 BODY_HAND BODY_HAND 1d1+39 1d1+18
24 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>greet_prog 100~
if quest(15, 4, $n) == 9
  if quest(19, 3, $n) == 0
    say You look like someone that can help me.  One of my
    say enemies has cast a death spell on a friend of mine.
    say Please find where they put the death mark for me.
    say If you need, one of my polished diamonds may help you.
    mpmset $n quest 19 3 1
  else
    if quest(19, 3, $n) == 1
      say Have you located the death mark yet?
    else
      if quest(19, 3, $n) == 2
        say Have you located the death mark yet?
      else
        if rand(20)
          emote greets you as you walk in.
          say Is there anything I can show you?
          mpforce $n list
        endif
      endif
    endif
  endif
endif
~
>speech_prog heremon~
if quest(19, 3, $n) == 2
  if quest(15, 4, $n) == 9
    if quest(22, 1, $n) == 0
      say Thank you!  Now I will be able to remove it and save a life.
      mpmset $n quest 19 3 3
      say Here, take this as a reward for your services.
      mpoload 7531
      give i7531 $n
      mpmset $n quest 22 1 1
    endif
  endif
endif
~
