>rand_prog 6~
  if quest (0,10,self) == 30
    mpmset self quest 0 10 1
    mpareaecho {130}TIP: EQUIPMENT{300}{030} can be used to raise your {130}STATS{300}{030}.{020}
  else
    if quest (0,10,self) == 29
      mpmset self quest 0 10 30
      mpareaecho {130}TIP: WEAR{300}{030}, {130}WIELD{300}{030}, {130}HOLD{300}{030}, and {130}REMOVE{300}{030} manage your {130}EQUIPMENT{300}{030}.{020}
    else
      if quest (0,10,self) == 28
        mpmset self quest 0 10 29
        mpareaecho {130}TIP: EQUIP{300}{030} and {130}INVENTORY{300}{030} show information about your possessions.{020}
      else
        if quest (0,10,self) == 27
          mpmset self quest 0 10 28
          mpareaecho {130}TIP: WHERE{300}{030} shows the location of other visible characters in your area.{020}
        else
          if quest (0,10,self) == 26
            mpmset self quest 0 10 27
            mpareaecho {130}TIP: HELP <skill>{300}{030} or {130}HELP <spell>{300}{030} shows information about {130}SKILLS{300}{030} or {130}SPELLS{300}{030}.{020}
          else
            if quest (0,10,self) == 25
              mpmset self quest 0 10 26
              mpareaecho {130}TIP: WHO{300}{030} will show players you can {130}GROUP{300}{030} with.  {130}WHO ALL{300}{030} shows all players.{020}
            else
              if quest (0,10,self) == 24
                mpmset self quest 0 10 25
                mpareaecho {130}TIP:{300} {030}Joining a {130}CLAN{300}{030} will help you greatly.{020}
              else
                if quest (0,10,self) == 23
                  mpmset self quest 0 10 24
                  mpareaecho {130}TIP:{300} {030}Maximize your {130}INTELLIGENCE{300}{030} before you {130}PRACTICE SKILLS{300}{030} or {130}SPELLS{300}{030}.{020}
                else
                  if quest (0,10,self) == 22
                    mpmset self quest 0 10 23
                    mpareaecho {130}TIP:{300} {030}To {130}SPEAK{300}{030} with others you must understand and speak their {130}LANGUAGE{300}{030}.{020}
                  else
                    if quest (0,10,self) == 21
                      mpmset self quest 0 10 22
                      mpareaecho {130}TIP: FINGER <name>{300}{030} to learn information about other players.{020}
                    else
                      if quest (0,10,self) == 20
                        mpmset self quest 0 10 21
                        mpareaecho {130}TIP:{300} {030}Typing {130}HELP{300}{030} will activate the in game {130}HELP{300}{030} system.{020}
                      else
                        if quest (0,10,self) == 19
                          mpmset self quest 0 10 20
                          mpareaecho {130}TIP: NEWCHAT <message>{300}{030} to ask for tips from others.{020}
                        else
                          if quest (0,10,self) == 18
                            mpmset self quest 0 10 19
                            mpareaecho {130}TIP:{300} {030}Information is available at the {130}WEBSITE{300}{030} http://www.mortalrealms.com.{020}
                          else
                            if quest (0,10,self) == 17
                              mpmset self quest 0 10 18
                              mpareaecho {130}TIP: CONFIG{300}{030} contains many important options.{020}
                            else
                              if quest (0,10,self) == 16
                                mpmset self quest 0 10 17
                                mpareaecho {130}TIP:{300} {030}Type {130}SCORE{300}{030}, {130}STAT{300}{030}, or {130}AFFECTS{300}{030} for information about your character.{020}
                              else
                                if quest (0,10,self) == 15
                                  mpmset self quest 0 10 16
                                  mpareaecho {130}TIP:{300} {030}Keep plenty of {130}RECALL{300}{030} scrolls, but not in containers.{020}
                                else
                                  if quest (0,10,self) == 14
                                    mpmset self quest 0 10 15
                                    mpareaecho {130}TIP: HELP AREAS{300}{030} shows how to get information about an {130}AREA{300}{030}.{020}
                                  else
                                    if quest (0,10,self) == 13
                                      mpmset self quest 0 10 14
                                      mpareaecho {130}TIP: WEAR ALL{300}{030} does not necessarily wear best.{020}
                                    else
                                      if quest (0,10,self) == 12
                                        mpmset self quest 0 10 13
                                        mpareaecho {130}TIP:{300} {030}The obelisk is an easy way to {130}TRAVEL{300}{030} until you reach level 18.{020}
                                      else
                                        if quest (0,10,self) == 11
                                          mpmset self quest 0 10 12
                                          mpareaecho {130}TIP:{300} {030}Low hit points make you an easy target for {130}ASSASSINS{300}{030}.{020}
                                        else
                                          if quest (0,10,self) == 10
                                            mpmset self quest 0 10 11
                                            mpareaecho {130}TIP:{300} {030}Fighters should {130}TRAIN{300}{030} hit points instead of {130}MANA{300}{030}.{020}
                                          else
                                            if quest (0,10,self) == 9
                                              mpmset self quest 0 10 10
                                              mpareaecho {130}TIP:{300} {030}Equip fighters with damage roll enhancing {130}EQUIPMENT{300}{030}.{020}
                                            else
                                              if quest (0,10,self) == 8
                                                mpmset self quest 0 10 9
                                                mpareaecho {130}TIP:{300} {030}When in doubt, use {130}NEWCHAT{300}{030} to ask experienced players for tips.{020}
                                              else
                                                if quest (0,10,self) == 7
                                                  mpmset self quest 0 10 8
                                                  mpareaecho {130}TIP:{300} {130}RACE{300}{030} and {130}CLASS{300}{030} combinations are important.{020}
                                                else
                                                  if quest (0,10,self) == 6
                                                    mpmset self quest 0 10 7
                                                    mpareaecho {130}TIP: {130}SANCTUARY{300}{030} reduces the {130}DAMAGE{300}{030} you take by a third.{020}
                                                  else
                                                    if quest (0,10,self) == 5
                                                      mpmset self quest 0 10 6
                                                      mpareaecho {130}TIP:{300} {030}Always maximize {130}WISDOM{300}{030} and {130}CONSTITUTION{300}{030} before you {130}LEVEL{300}{030}.{020}
                                                    else
                                                      if quest (0,10,self) == 4
                                                        mpmset self quest 0 10 5
                                                        mpareaecho {130}TIP:{300} {130}ILLUSIONISTS{300}{030} need hit points and should wear AC enhancing {130}EQUIPMENT{300}{030}.{020}
                                                      else
                                                        if quest (0,10,self) == 3
                                                          mpmset self quest 0 10 4
                                                          mpareaecho {130}TIP: CLERICS{300}{030} heal the realms, {130}MANA{300}{030} is important to them.{020}
                                                        else
                                                          if quest (0,10,self) == 2
                                                            mpmset self quest 0 10 3
                                                            mpareaecho {130}TIP:{300} {030}Quests are available in most areas.{020}
                                                          else
                                                            if quest (0,10,self) == 1
                                                              mpmset self quest 0 10 2
                                                              mpareaecho {130}TIP:{300} {030}Equipment can boost {130}WISDOM{300}{030} and {130}CONSTITUTION{300}{030}.{300}
                                                            else
                                                              if quest(0,10,self) == 0
                                                                mpmset self quest 0 10 1
                                                              endif
                                                            endif
                                                          endif
                                                        endif
                                                      endif
                                                    endif
                                                  endif
                                                endif
                                              endif
                                            endif
                                          endif
                                        endif
                                      endif
                                    endif
                                  endif
                                endif
                              endif
                            endif
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~ 
