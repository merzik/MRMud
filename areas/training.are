#3718
avatar~
The Avatar of Order~
An Avatar of Order is here, training new mortals.~
He is a friendly looking man with blond hair and blue eyes. His vestments
are pure white and crisply cut. The Avatar radiates an aura of pure power
and seems to be able to train you in every way.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_TRAIN|ACT_SMART
AFF_DETECT_INVIS|AFF_SANCTUARY|AFF_TONGUES|AFF_UNDERSTAND
1000 S
50 0 0 1d1+2887 2d4+30
0 269671
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
  mpechoat $n {030}The Avatar of Order says 'Hello $n.'{020}
  mpechoat $n {030}The Avatar of Order says 'Please allow me to welcome you to the Mortal Realms.'{020}
  if class($n)==0
    mpechoat $n {030}The Avatar of Order says 'As an Illusionist I suggest you train mana.'{020}
    else
    if class($n)==1
      mpechoat $n {030}The Avatar of Order says 'As an Elementalist I suggest you train mana.'{020}
    else
      if class($n)==2
        mpechoat $n {030}The Avatar of Order says 'As a Rogue I suggest you train hp.'{020}
      else
        if class($n)==3
          mpechoat $n {030}The Avatar of Order says 'As a Ranger I suggest you train hp.'{020}
        else
          if class($n)==4
            mpechoat $n {030}The Avatar of Order says 'As a Necromancer I suggest you train mana.'{020}
          else
            if class($n)==5
              mpechoat $n {030}The Avatar of Order says 'As a Cleric I suggest you train mana.'{020}
            else
              if class($n)==6
                mpechoat $n {030}The Avatar of Order says 'As an Assassin I suggest you train hp.'{020}
              else
                if class($n)==7
                  mpechoat $n {030}The Avatar of Order says 'As a Monk, I suggest you train hp.'{020}
                else
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
~
>rand_prog 5~
  if rand(30)
    say More wisdom earns you more practices as you grow.
  else
    if rand(40)
      say Higher constitution will improve your hp gains.
    else
      if rand(50)
        say Higher intelligence increases mana gained.
      else
        if rand(70)
          say Better dexterity will gain you more movement.
        else
          if rand(100)
            say Equipment can be used to increase stats.
          endif  
        endif
      endif
    endif  
  endif
~
|

