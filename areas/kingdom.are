0 
0 S
95 0 0 1d1+8000 1d1+73
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 80~
if quest(0, 4, self) == 0
  @mpat dukecrydeequestmob mpforce dukecrydeequestmob shout Armies of the West, ATTACK!!!
  mpareaecho {130}The Duke of Crydee shouts 'Armies of the West, ATTACK!!!'
  mpquiet on
  mpgoto 1782
  mpquiet off
  north
  mpmset self quest 0 4 1
else
  if quest(0, 4, self) == 1
    @shout I've spotted the enemy!
    mpareaecho {130}A soldier of the kingdom shouts 'I've spotted the enemy!'{030}
    mpkill otherworldfightmob
    mpforce otherworldfightmob mpkill kingdomfightmob
    mpmset self quest 0 4 2
  else
    if quest(0, 4, self) == 10
      mpareaecho {130}A soldier of the kingdom shouts 'We've won the day!'{030}
      mpareaecho {130}A soldier of the kingdom shouts 'The otherworlders are in retreat!'{030}
      mpmset self quest 0 4 11
    else
      if quest(0, 4, self) == 11
        @mpat dukecrydeequestmob mpforce dukecrydeequestmob shout Return to camp!
        mpareaecho {130}The Duke of Crydee shouts 'Return to camp!'{030}
        south
        mpmset self quest 0 4 0
        mppurge self
      endif
    endif
  endif
endif
~
>death_prog 100~
mpmset self quest 0 4 0
mpmset otherworldfightmob quest 0 4 1
~
