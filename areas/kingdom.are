0 
0 S
95 0 BODY_CLAW|BODY_MOUTH 1d1+20000 1d1+200
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(0, 3, $n) == 0
  say You have found my lair, $n now what do you want?
else
  if quest(0, 3, $n) == 2
    say I sensed the death of the wraith.  You have done
    say well, but you are not finished yet!  The dwarves
    say on the surface annoy me with their tunneling.
    say They must die for this.
    mpmset $n quest 0 3 3
  else
    if quest(0, 3, $n) == 6
      say You have served me well.  Now it is time for my dinner.
      mpmset $n quest 0 5 7
      mpoload 1701
      mpoload 1702
      mpoload 1703
      mpoload 1707
      mpkill $n
    endif
  endif
endif
~
>death_prog 100~
if quest(0, 3, $n) == 7
  say I knew I would die today, but to you???
endif
~
>speech_prog gold white seek~
if quest(0, 3, $n) == 0
  if quest(3, 5, $n) > 19
    say You seek the gold and white armor?
    say I do happen to have that among my possessions.
    say You must do as I say in order to gain them.
    say A wraith has been haunting my halls.  Destroy it.
    mpmset $n quest 0 3 1
  endif
endif
~
