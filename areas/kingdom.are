#1717
tidepoolethereal~
tidepoolethereal~
catch crabs here.~
also does the tides~
ACT_RACE|ACT_BODY|ACT_SENTINEL|ACT_SMART
AFF_ETHEREAL 
0 S
1 0 0 1d1+8000 1d1+80
100 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>rand_prog 50~
if quest(0, 4, self) < 15
  mpmadd self quest 0 4 1
  if quest(0, 4, self) < 8
    if quest(3, 5, $r) == 3
      if rand(45)
        mpechoat $r You lunge for a crab swimming in the tide pool but it
gets away.
      else
        mpjunk all
        mpoload 1718
        mpquiet on
        give i1718 $r
        mpmset $r quest 8 1 1
        mpquiet off
        mpechoat $r You lunge for a crab and catch it!
        mpechoaround $r $r catches a crab!
      endif
    endif
  else
    if quest(0, 4, self) == 8
      mpecho The tide is beginning to come in.
    else
      if quest(0, 4, self) > 12
        mpecho The tide is going out and you are pulled out to sea with it.
        mptransfer all 1793
      endif
    endif
  endif
else
  if quest(0, 4, self) == 15
    mpmset self quest 0 4 0
    mpecho The tide has gone out dotting the beach with tide pools full of crabs.
    mpasound You see the tide going out.
  endif
endif
~
