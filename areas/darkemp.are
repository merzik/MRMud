217018 RACE_DROW
POS_STANDING POS_STANDING SEX_MALE
>give_prog i13615~
if goldamt($n) >= 10
  mpjunk i13615
  mpoload 13616
  emote throws the ribs on the grill.
  mpmadd $n gold -10
  give i13616 $n
else
  say You don't have 10 gold coins.
  give i13615 $n
endif
~
>bribe_prog 10~
say you need to supply the meat.
give 10 coins $n
~
