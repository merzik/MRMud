#13602
voice~
A voice~
The gate to the dark empire is here.~
The gate restricts all non-members of the empire from entering.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_RACE
AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_UNDERSTAND|AFF_TONGUES|AFF_ETHEREAL
0 S
95 0 0 1d1+14999 1d1+99
232253 RACE_DROW
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if level($n)>=13
  if race($n)==3
    tell $n Ep zpv xjti up foufs uif fnqjsf?
  else
    if race($n)==6
      tell $n Ep zpv xjti up foufs uif fnqjsf?
    else
      if race($n)==7
        tell $n Ep zpv xjti up foufs uif fnqjsf?
      endif
    endif
  endif
endif
~
>speech_prog zft~
if level($n)>=13
  if race($n)==3
    tell $n Zpv nbz foufs.
    mpat 13650 mpecho $n enters the empire.
    mptransfer $n 13650
    mpat 13650 mpforce $n look
    mpecho $n vanishes.
  else
    if race($n)==6
      tell $n Zpv nbz foufs.
      mpat 13650 mpecho $n enters the empire.
      mptransfer $n 13650
      mpat 13650 mpforce $n look
      mpecho $n vanishes.
    else
      if race($n)==7
        tell $n Zpv nbz foufs.
        mpat 13650 mpecho $n enters the empire.
        mptransfer $n 13650
        mpat 13650 mpforce $n look
        mpecho $n vanishes.
      endif
    endif
  endif
endif
~
|
