#6905
Audrey~
Audrey Renee-Maree~
Audrey Renee-Maree awaits the arrival of another student.~
She is absolutely gorgeous!  Her face seems to glow from its own light source.
Her form is slender, but not to the extreme and she walks with an uncommon
grace even to this place.  She wears some of the most elegant dresses in the
village.  There is only one other in the village who compares with her and you
surmise the other would quite probably be her sister.~
ACT_BODY|ACT_IS_NPC|ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_NO_ORDER|ACT_RACE
AFF_TONGUES|AFF_INFRARED|AFF_PROTECT_EVIL|AFF_PROTECT_GOOD|AFF_UNDERSTAND|AFF_DETECT_HIDDEN|AFF_DETECT_INVIS|AFF_SANCTUARY|AFF_HUNT
1000 S
98 BODY_HEAD BODY_MOUTH 1d1+15000 92d3+115
1000000 RACE_GNOME POS_STANDING POS_STANDING SEX_FEMALE
>greet_prog 100~
  if quest(0,1,$n) == 1
    mpforce $n shout I think I goofed up here.
    mpkill $n
  endif
~
>speech_prog test~
  if actorhasobjnum(6940)
    if quest(2,5,$n) >= 19
      say You have already gotten your chance.
    else
      if quest(2,5,$n) == 17
        say I believe you aren't ready to be tested.
        say Am I right?
        mpmset $n quest 2 5 18
      else
        if quest(2,5,$n) <= 16
          say Governor Sohtyp will not permit me to test you.
          say Prepare yourself better so I may test you.
        endif
      endif
    endif
    else
      say You are not ready to be tested at this time.
  endif
~
>speech_prog yes~
  if actorhasobjnum(6940)
    if quest(2,5,$n) == 18
      say Very well, then.
      mpmset $n quest 2 5 17
    else
      if quest(2,5,$n) == 19
        say Very well.
        mpmset $n quest 2 5 17
        mpquiet on
        mptransfer $n 6955
        mpgoto 6955
        mpquiet off
      else
        if quest(2,5,$n) == 20
          say Very well.
          mpmset $n quest 2 5 17
          mpquiet on
          mptransfer $n 6955
          mpgoto 6955
          mpquiet off
        endif
      endif
    endif
  endif
~
>speech_prog no~
  if actorhasobjnum(6940)
    if quest(2,5,$n) == 18
      say Okay, but I still don't believe you are ready.
      say Let's go to the back room where it is quieter.
      mptransfer $n 6959
      mpgoto 6959
      mpmset $n quest 2 5 19
      say I will ask you a question.
      say If you get it right, I will ask you a second one.
      say Get that one right to prove yourself worthy.
      say Tell me, where are your riches hidden?
    endif
  endif
~
>speech_prog p The measure of true wealth is not in your money or things, but in your number of friends and in your character.~
  if actorhasobjnum(6940)
    if quest(2,5,$n) == 19
      if inroom($n) == 6959
        mpmset $n quest 2 5 20
        say And what about your character?
        say There is another tablet which discusses this matter.
      endif
    endif
  endif
~
>speech_prog p Popularity is fickle, but your reputation will outlive you.~
  if actorhasobjnum(6940)
    if quest(2,5,$n) == 20
      if inroom($n) == 6959
        say Very well done, $n!
        say You shall be rewarded greatly.
        say Remember what you have learned in your studies.
        say Put it into practice and you will be a much better person for it.
        mpoload 6930
        mpquiet on
        cast 'remove curse' $i
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        cast 'remove curse' $n
        mpquiet off
        give i6930 $n
        mpquiet on
        mpforce $n remove i6940
        mpforce $n give i6940 Audrey
        mpjunk i6930
        mpjunk i6940
        mpquiet off
        mpmset $n quest 2 5 0
        mptransfer $n 6955
        mpgoto 6955
      endif
    endif
  endif
~
>death_prog 100~
  mpjunk i6907
  mpjunk i6908
  mpjunk i6909
~
>fight_prog 100~
  if rand(33)
    mpquiet on
    cast heal $i
    cast heal $i
    cast heal $i
    mpquiet off
  else
    if rand(20)
      cast 'energy drain' $r
    else
      if rand(20)
        mass acid
        endif
      endif
    endif
  endif
~
>hitprcnt_prog 35~
  mpmadd self currhp 4000
~
>rand_prog 05~
  if pcsinroom(6959) == 0
    if inroom($i) != 6955
      mpgoto 6955
    endif
  endif
~
