  mpechoaround $n {110}The guard's eyes glow red with fury at $n's presence!{300}
  mpkill $n
~
>death_prog 100~
  if quest (0,1,$n) == 0
    mpmset $n quest 0 1 1
    shout $n is a sworn enemy of Governor Sohtyp!
    shout Avenge me!  Defend our village!
  endif
  if level($n) >= 75
    mppurge $i
  endif
~
>give_prog I27721~
  mpjunk i27721
  mpechoat $n A Guard of New Singase looks at you with a skeptical eye.
  mpechoaround $n A guard of New Singase looks at $n with a skeptical eye.
  if inroom($n) == 6952
    mpoload 6913
    mpoload 6915
    mpquiet on
    wear i6913
    wear i6915
    mpquiet off
  else
    if inroom($n) == 6951
      mpoload 6910
      mpoload 6911
      mpquiet on
      wear i6910
      wear i6911
      mpquiet off
    else
      if inroom($n) == 6950
        mpoload 6912
        mpoload 6914
        mpquiet on
        wear i6912
        wear i6914
        mpquiet off
      else
        if inroom($n) == 6949
          mpoload 6916
          mpoload 6917
          mpoload 6918
          mpquiet on
          wear i6916
          wear i6917
          wear i6918
          mpquiet off
        endif
      endif
    endif
  endif
~
>rand_prog 50~
  if inroom($i) == 6949
    or inroom($i) == 6950
      or inroom($i) == 6951
        or inroom($i) == 6952
          break
  else
    mppurge $i
  endif
~
|
