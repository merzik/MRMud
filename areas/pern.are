  if quest(13, 4, $n) != 10
    mpmload 5626
    mpforce thread mpkill $n
  else
    if quest(13, 4, $n) == 5
      mpechoat $n Your dragon takes you between as a clump of thread threatens you.
      mptransfer $n 5691
    else
      if quest(13, 4, $n) == 10
        mpechoat $n You have burned the last thread from the sky, so your dragon takes you home.
        mpmset $n quest 13 4 0
        if sex($n) == 1
          mptransfer $n 5666
        else
          mptransfer $n 5665
        endif
      endif
    endif
  endif
endif
