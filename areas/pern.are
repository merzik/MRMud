~
>death_prog 60~
if quest(4, 4, $n) == 1
  mpechoat $n Your dragon pounces upon the Herdbeast eating hungrily.
  mpquiet on
  mppurge dragonet
  if sex($n) == 1
      mpmload 5621
      mpforce teranth follow $n
  else
      mpmload 5622
      mpforce remanth follow $n
  endif
  mpquiet off
  mpmset $n quest 4 4 2
  mpechoat $n You notice that your dragonet has grown over time.
  mpechoat $n You also notice that $l skin has stretched
  mpechoat $n and $j will need to be oiled.
else
  if quest(4, 4, $n) == 3
    mpechoat $n Your dragon pounces upon the Herdbeast eating hungrily.
    mpquiet on
    mppurge dragon
    mpmload 5623
    mpforce mature follow $n
    mpquiet off
    mpmset $n quest 4 4 4
    mpechoat $n You notice that your dragon has grown over time.
    mpechoat $n You also notice that $l skin has stretched
    mpechoat $n and $j will need to be oiled.
  else
    if quest(4, 4, $n) == 9
      mpechoat $n Your dragon pounces upon the Herdbeast eating hungrily.
      mpquiet on
      mppurge dragon
      mpmload 5624
      mpforce mature follow $n
      mpquiet off
      mpmset $n quest 4 4 10
      mpechoat $n You notice that your dragon has grown over time.
      mpechoat $n You also notice that $l skin has stretched
      mpechoat $n and $j will need to be oiled.
    endif
  endif
endif
~
