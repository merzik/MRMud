>social_prog pat~
if quest(4, 4, $n) == 0
if ispc($n)
    mpmload 5617
    mpecho The egg cracks open and a small dragon gazes adoringly at you.
    mpforce dragonet follow $n
    if sex($n) == 1
      mpmset 5617 sex 1
      mpechoat $n **My name is Teranth, I love you.**
      mpmset 5617 name teranth
    else
      mpechoat $n **My name is Remanth, I love you.**
      mpmset 5617 name remanth
    endif
    mpechoat $n **I'm Hungry.  Let's go hunt.**
    mpmset $n quest 4 4 1
    mppurge $i
  endif
endif
~
