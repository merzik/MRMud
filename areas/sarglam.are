>all_greet_prog 100~
if quest(0, 3, $n) == 3
  growl $n
endif
~
>fight_prog 50~
if quest(0, 3, $n) == 3
  if actorhasobjnum(13710)
    if rand(20)
      mpecho The wererat winces as your knife hits her.
    endif
  else
    mpecho Your weapon is unable to pierce the wererat's hide.
  endif
endif
~
>death_prog 100~
if quest(0, 3, $n) == 3
  if actorhasobjnum(13710)
    mpecho The wererat dies as you thrust your knife into its heart.
    mpmset $n quest 0 3 4
  endif
endif
~
|
