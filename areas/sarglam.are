0 S
90 0 0 1d1+6239 1d1+67
181487 RACE_HUMAN
POS_RESTING POS_RESTING SEX_MALE
>greet_prog 100~
if quest(0, 3, $n) == 0
  say $n!  Surely you have come to rid
  say us of this beast that plagues our streets.
else
  if quest(0, 3, $n) == 4
    mpjunk all
    say Thank you $n, for ridding our city of that foul beast.
    say Take these in thanks.
    mpquiet on
    mpoload 13701
    give steel $n
    mpoload 13702
    give steel $n
    mpoload 13703
    give steel $n
    mpoload 13704
    give steel $n
    mpoload 13705
    give steel $n
    mpoload 13706
    give steel $n
    mpoload 13707
    give steel $n
    mpoload 13708
    give steel $n
    mpoload 13709
    give steel $n
    drop all
    mpquiet off
    mpmset $n quest 0 3 0
  else
    say How goes the hunt for the beast?
  endif
endif
~
>speech_prog yes sure yup ok help~
if quest(0, 3, $n) == 0
  smile $n
  say Talk to the armorer for more information
  say on how you can find and kill this beast.
  mpmset $n quest 0 3 1
endif
~
|
