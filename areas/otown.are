>speech_prog vault~
 if level($n)>10
  say don't you even try and get near my vault!
  kill $n 
 else 
  if level($n)<5
   say don't bother me with your stupid ideas.
 else   
   if quest (0,3,$n)==0
   say That vault is so well protected no one has even the slightest chance of getting in.
   mpmset $n quest 0 3 1
   endif
  endif
 endif
~
>greet_prog 100~
 if quest (0,3,$n)==5
  if actorhasobjnum(QQ10)
   say YOU ARE GOING TO USE THOSE LOCKPICKS ON MY VAULT AREN'T YOU! GUARDS, KILL THIS THIEF!
   mpquiet on
   mpforce all give iQQ10 mayor
   mpquiet off
   mptransfer pcs QQ51
   mpgoto QQ51
   mpforce guard mpkill $n
   mpforce 2.guard mpkill $n
   mpforce 3.guard mpkill $n 
   mpkill $n
  endif
 endif
~
|


                  
      
      
      
      
