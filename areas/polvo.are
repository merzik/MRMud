  cast 'heal' $r
else
  if isnpc($r)
    cast 'heal' $r
  endif
endif
~
>rand_prog 100~
if ispc($r)
  cast 'remove curse' $r
  cast 'cure blind' $r
else
  if isnpc($r)
    cast 'remove curse' $r
    cast 'cure blind' $r
  endif
endif
~
