AFF_DETECT_INVIS|AFF_DETECT_HIDDEN|AFF_SANCTUARY
1000 S
99 0 0 1d1+21690 1d1+219
1000 838032
POS_STANDING POS_STANDING SEX_MALE
>speech_prog test~
if $n == Friend
  mptransfer $n 10497    
  mpat 10497 mpforce $n l
endif
~
>all_greet_prog 100~
if whichgod ($n) != 1
  mptransfer n$ 10432
endif
~
>rand_prog 5~
if ispc($r)
  cast 'sanct' $r
else
  if isnpc($r)
    cast 'sanct' $r
  endif
endif
~
>rand_prog 5~
if ispc($r)
  cast 'sanct' $r
  cast 'prot' $r
else
  if isnpc($r)
    cast 'sanct' $r
    cast 'prot' $r
  endif
endif
~
>rand_prog 10~
mppurge mushroom
cast 'create food'
~
>rand_prog 90~
