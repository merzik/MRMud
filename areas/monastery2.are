>greet_prog 100~
if whichgod($n) == 1
  slay $n
  cast 'earthquake'
endif
~
>rand_prog 50~
mpquiet on
if rand(25)
  cast 'sanctuary' $r
else
  if rand(33)
    cast 'enhanced revive' $r
  else
    if rand(50)
      cast 'giant strength' $r
    else
      cast 'enhanced heal' $r
    endif
  endif
endif
