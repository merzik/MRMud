>rand_prog 100~
if quest(0,1,$i) == 0
  down 
  down 
  down 
  down 
  down 
  mpmset $i quest 0 1 1
  recho This function temporarily disabled, open-gate.
else
  mpmset $i quest 0 1 0
  recho This function temporarily disabled, close-gate.
  mpgoto 16216
  suicide 
endif
