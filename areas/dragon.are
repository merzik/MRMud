>speech_prog gem~
if quest(5,1,$n) == 1
  if quest(10,1,$n) == 0
    if class($n) == 6
      tell $n Here is the gem you need. :)
      mpoload 31104
      drop gem
      mpmset $n quest 10 1 1
    else
      tell $n This is not your guild!
      grumble $n
    endif
  else
    tell $n You already got your gem!
  endif
endif
~
>death_prog 75~
