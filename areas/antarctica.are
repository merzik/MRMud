  mpjunk all
  mpecho The dragon quickly devours the dead gnome.
  mpecho The dragon looks at you with hungry eyes.
  mpmset $n quest 0 4 8
  mpkill $n
endif
~
>fight_prog 60~
if quest(0, 4, $n) == 8
  mpechoat $n {170}The dragon breathes a blast of frost toward you!{300}
  mpechoaround $n {170}The dragon breathes a blast of frost toward $n.{300}
  mpquiet on
  cast 'acid blast' $n
  mpquiet off
endif
~
>death_prog 100~
if quest(0, 4, $n) == 8
  mpmset $n quest 0 4 9
  mpecho Maybe the dead gnome in its belly slowed it down.
endif
~
