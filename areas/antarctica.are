#2706
snowqueenmob snow queen~
the Snow Queen~
The Queen of Snows did not invite you to be here.~
Dressed in all white, she almost charms you with her placidness.~
ACT_SENTINEL|ACT_BODY|ACT_RACE|ACT_SMART AFF_TONGUES|AFF_UNDERSTAND 0 S
30 0 0 1d1+479 1d1+21
27794 RACE_HUMAN
POS_STANDING POS_STANDING SEX_FEMALE
>greet_prog 100~
if quest(0, 4, $n) == 0
  if level($n) < 30
    mpechoat $n The Snow Queens beckons you over.
    say You will be my servant until I no longer
    say have need of you.  To start with, A remoraz
    say has mistakenly taken my furnace as a mate.
    say Get rid of it for me!
    mpmset $n quest 0 4 1
  endif
else
  if quest(0, 4, $n) == 2
    say I guess you did your job, but why are you wet?
    say Don't you know you can die like that in this cold?
    say Anyway, the master herbal has something for me.
    say Go get it, quickly!
    mpmset $n quest 0 4 3
  else
    if quest(0, 4, $n) == 9
      say You killed my pet!
      say You will pay for that!
      mpkill $n
    endif
  endif
endif
~
>death_prog 100~
if quest(0, 4, $n) == 9
  mpecho The Snow Queen's scream shakes the chamber
  mpmset $n quest 0 4 10
  mpoload 2709
  mpoload 2710
  mpoload 2711
  mpoload 2712
  mpoload 2713
endif
~
>rand_prog 100~
if quest(0, 4, self) > 0
  mpmadd self quest 0 4 1
endif
if quest(0, 4, $r) == 6
  say Excellent!
  mpecho The Snow Queen grins wickedly.
  say Now take that and feed my pet white!
  mpmset $r quest 0 4 7
endif
~
>give_prog i2707~
mpjunk all
mpecho The queen pops the mint into her mouth.
if quest(0, 4, $n) == 4
  if quest(0, 4, self) > 14
    Shout Where have you been, $n????
    say You are incapable of being my servant!
    say Maybe you are capable of feeding my pets!
    mpmset $n quest 0 4 15
    mpkill $n
  else
    say Good, now my pets need feeding
    mpecho The Snow Queen gestures and a gnome is brought in.
    mpmload 2711
    mpmset $n quest 0 4 5
    mpquiet on
    mpforce $n group snowqueenmob
    sleep
    mpquiet off
    mpforce scaredgnomemob say I will not go easily!
  endif
endif
~
|
