#15143
mistwalkercaptain captain~
The Mist Walker Captain~
The Captain of the Mist Walker Stands here.~
Dressed in typical sailors garb, he captains the Mist Walker with
confidence and ease.~
ACT_SENTINEL|ACT_SMART|ACT_BODY|ACT_RACE
AFF_UNDERSTAND|AFF_TONGUES
0 S
95 BODY_HAND BODY_FOOT 10d10+25000 1d10+155
10000 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(21, 1, $n) == 0
  shout A stowaway! $n is a stowaway!
  mpecho $n is thrown overboard.
  mpmset $n quest 13 5 0
  mptransfer $n 15101
else
  if quest(13, 5, $n) == 0
    say You forgot to pick a destination.
    say Go back and see the Harbour Master.
    mpforce $n east
  else
    mpat 15274 connect 3 15101
    if quest(13, 5, $n) == 1
      mpecho The Captain shouts Set sail for Moonshae Islands
    else
      if quest(13, 5, $n) == 2
        mpecho The Captain shouts Set sail for Holy River
      else
        if quest(13, 5, $n) == 3
          mpecho The Captain shouts Set sail for Isle of Mist
        else
          if quest(13, 5, $n) == 4
            mpecho The Captain shouts Set sail for Troll Island
          else
            if quest(13, 5, $n) == 5
              mpecho The Captain shouts Set sail for Ocean City
            endif
          endif
        endif
      endif
    endif
    mpmset mistwalkercaptain quest 19 2 0
    mpat 15274 mpmset harbourmastermob quest 22 1 1
  endif
endif
~
>rand_prog 50~
if quest(19, 2, mistwalkercaptain) == 0
  connect 1 15101
  mpecho You cast off and pull away from the docks of Zazesspur.
  mpmset mistwalkercaptain quest 19 2 1
else
  if quest(19, 2, mistwalkercaptain) == 1
    mpecho You sail through the Sea of Swords.
    mpmset mistwalkercaptain quest 19 2 2
  else
    if quest(19, 2, mistwalkercaptain) == 2
      if quest(13, 5, $r) == 1
        connect 1 201
        mpecho You sail up to the Corwell Docks of Moonshae Islands.
        mpecho All disembark
        mpmset $r quest 13 5 0
        mpmset $r quest 21 1 0
        mpforce $r east
        connect 1 15101
      else
        if quest(13, 5, $r) == 2
          connect 2 27580
          mpecho You sail up to the right bank of Holy River.
          mpecho All disembark
          mpmset $r quest 13 5 0
          mpmset $r quest 21 1 0
          mpforce $r south
          connect 2 15101
        else
          if quest(13, 5, $r) == 3
            connect 2 10747
            mpecho You sail up to the Isle of Mist.
            mpecho All disembark
            mpmset $r quest 13 5 0
            mpmset $r quest 21 1 0
            mpforce $r south
            connect 2 15101
          else
            if quest(13, 5, $r) == 4
              connect 0 15911
              mpecho You sail up to the beach of Troll Island.
              mpecho All disembark
              mpmset $r quest 13 5 0
              mpmset $r quest 21 1 0
              mpforce $r north
              connect 0 15101
            else
              if quest(13, 5, $r) == 5
                connect 0 11458
                mpecho You sail up to the beach of Ocean City.
                mpecho All disembark
                mpmset $r quest 13 5 0
                mpmset $r quest 21 1 0
                mpforce $r north
                connect 0 15101
              endif
            endif
          endif
        endif
      endif
    endif
    mpat 15274 mpecho The Mist Walker sails into port.
    connect 1 15274 both
    mpat 15274 mpmset harbourmastermob quest 22 1 0
    mpmset self quest 19 2 0
  endif
endif
~
