>greet_prog 100~
if race($n) == 10
  if level($n) == 95
    if quest(0, 4, $n) == 8
        mpquiet on
        mpjunkperson $n i8731
        mpoload 8734
        cast 'giant strength' $n
        give i8734 $n
        mpforce $n wear i8734
        mpquiet off
        mpecho $i looks on at you with growing impatience.
        say What took you so long?  I am now ready to achieve my
        say complete fulfillment. Only you know the truth behind
        say what needed to be done to cleanse my soul. You must
        say realize that these truths cannot be discovered by anyone.
        say For this knowledge, you will pay with your life!!
        mpmset $n quest 0 4 9
        mpkill $n
    endif
  else
  if level($n) < 26
    if quest(0, 4, $n) == 0
      if sex($n) == 1
        say Welcome, my son. Your youth will be of great HELP to me.
      else
        say Welcome, my dear. Your young body may be of great HELP to me.
        wink $n
      endif
    else
      if quest(0, 4, $n) == 3
        gasp
        mpecho $i grabs his brother and hugs him tightly.
        say Thank you so much for bringing my brother to me.
        say If I find that I need your help further, I will speak
        say to you through this.  Please wear it at all times.
        mpquiet on
        cast 'giant strength' $n
        mpquiet off
        mpoload 8729
        give i8729 $n
        mpmset $n quest 0 4 4
      endif
    endif
  else
    if level($n) == 45
      if quest(0, 4, $n) == 4
        mpquiet on
        mpjunkperson $n i8729
        mpoload 8732
        cast 'giant strength' $n
        give i8732 $n
        mpforce $n wear i8732
        mpquiet off
        say Thank you for returning so promptly. I again am
        say in need for your help in my quest for fulfillment.
        say I need for you to find something that will help me
        say to restore my Virtue, an Emblem of sorts.
        say Find this, and bring it to me.
        mpmset $n quest 0 4 5
      endif
    endif
  else
    if level($n) == 70
      if quest(0, 4, $n) == 6
        mpquiet on
        mpjunkperson $n i8730
        mpoload 8733
        cast 'giant strength' $n
        give i8733 $n
        mpforce $n wear i8733
        mpquiet off
        say Again I am in need of much help.  I truly am sorry for
        say disrupting so much of your life for my own fulfillment.
        say I have cleared my name with my family and have regained
        say my virtue, all thanks to you, but alas, I have been unable
        say to retrieve my own soul from the chaotic oblivion. Lord Chaos
        say himself came here many moons ago, unhappy with my abilities
        say as a ruler of this chaotic dimension.  As a result, he reached
        say into my very being and tore my soul out from within, and trapped
        say me in this dimension so that I cannot retrieve it myself.
        say The last I had heard, Chaos had hidden my soul in one of the 
        say larger cities in his vast empire.  Please, if you manage to
        say find it, I will reward you handsomely.
        mpmset $n quest 0 4 7
      endif
    endif 
  endif
endif
~
>speech_prog help~
if quest(0, 4, $n) == 0
  if race($n) == 10
    if level($n) < 26
      mpmset $n quest 0 4 1
      say I have lived a long, long life.  I am seeking fulfillment
      say and it is time that I make amends for all the horrible
      say things I have done.  Many years ago, in a power hungry  
      say haze, I sold the souls of my entire family to Chaos in
      say exchange for ruling over this dimension.  Everyone in my
      say family has died, except for my youngest brother.  After
      say losing his soul, he was bound here, as one of the tortured
      say lost souls wandering around.  If you can find him, please
      say tell him that his brother needs to see him.
    endif
  endif
endif
~
>give_prog i3313~
if quest(0, 4, $n) == 5
  mpjunk i3313
  say Ah, yes!  This will do just fine.  Allow me
  say to thank you, and once again, if I am in need
  say of your services, I will speak to you through this.
  mpquiet on
  cast 'giant strength' $n
  mpquiet off
  mpoload 8730
  give i8730 $n
  mpmset $n quest 0 4 6
endif
~
>give_prog i3314~
if quest(0, 4, $n) == 5
  mpjunk i3314
  say Ah, yes!  This will do just fine.  Allow me
  say to thank you, and once again, if I am in need
  say of your services, I will speak to you through this.
  mpquiet on
  cast 'giant strength' $n
  mpquiet off
  mpoload 8730
  give i8730 $n
  mpmset $n quest 0 4 6
endif
~
>give_prog i29469~
if quest(0, 4, $n) == 7
  mpjunk i29469
  say I am most impressed with your abilities, young one.
  say I hope that you have not undergone any great harm
  say in retrieving my soul from Oblivion.  I would be
  say most unhappy to find that some terrible fate had
  say begotten you.
  mpquiet on
  cast 'giant strength' $n
  mpquiet off
  mpoload 8731
  say Shall I request your assistance again, I will speak to
  say you through this.
  give i8731 $n
  mpmset $n quest 0 4 8
endif
~
>fight_prog 70~
if quest(0, 4, $n) == 9
  mpecho $i reaches out to you with psychic tendrils.
  cast 'energy drain' $n
endif
~
>death_prog 100~
if quest(0, 4, $n) == 9
  mpmset $n quest 0 4 10
  say NO!!  I am to gain fulfillment on this day!!
  say I CANNOT BE DEFEATED IN SUCH A WAY!
  mpquiet on
  cast 'dispel magic' $n
  cast 'dispel magic' $n
  cast 'dispel magic' $n
  cast 'dispel magic' $n
  cast 'dispel magic' $n
  cast 'giant strength' $n
  mpoload 8727
  mpoload 8728
  give i8727 $n
  give i8728 $n
  mpquiet off
  mpecho $i slumps over and turns to dust.
endif
~
|

