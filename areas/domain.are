ACT_SENTINEL|ACT_SMART|ACT_NO_ORDER|ACT_BODY
AFF_UNDERSTAND|AFF_TONGUES
0 S
95 0 BODY_HEAD|BODY_HAND 1d1+8000 11d6+40
291482 780605
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if whichgod($n)>1
  shout GUARDS!!!! A minion of the false god has entered the hall!
  break
endif
if whichgod($n)==1
  rescale 13969 $n 150
else
if quest(0,2,$n) == 1
  rescale 13969 $n 105
  say Still learning the trade, I will go easy on you!
else
  if quest(0,2,$n) == 2
  rescale 13969 $n 115
    say Strong and sure, we shall see who stands after the battle!
  else
    if quest(0,2,$n) == 3
  rescale 13969 $n 125
      say A bold and daring one...... I shall best you yet!
    else
  rescale 13969 $n 100
      say BAH! Beginner!  Would you like me to fall on my sword???
      spit 
    endif
  endif
endif
endif
~
>fight_prog 100~
if whichgod($n)>1
  if rand(15)
    mpmload 13801
    mpecho A guard is summoned to fight for Lord Order!
    mpforce $n say I shall overcome Order
  endif
~
>death_prog 100~
gasp 
look $n
mpecho A warrior touches the gaping wound your blade just dug.
mpecho A warrior prays to Lord Order for mercy.
mpecho A large translucent hand reaches down and touches the warrior on the head.
if rand(10)
  mpmload 13969
  say My brethren will see you vanquished!
  mpforce 2.knight mpkill $n
endif
~
