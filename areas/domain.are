281483 RACE_ORC
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
say Welcome $n.
if whichgod($n)==1
  emote jump kicks a block of wood.
  rescale 13982 $n 100
else
  if whichgod($n)>1
    say Fiend!  How dare you show your hide here!
    say You will meet your maker $n.
    mpforce $n say I shall overcome Order
  endif
endif
mpquiet on
