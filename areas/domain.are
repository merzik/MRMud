  if pcsinroom(13878) == 0
    mpmset self quest 0 31 0
  endif
endif
~
>speech_prog armour~
if quest(2,1,self) == 1
  if quest(9,2,$n) == 0
    nod $n
    say Your choice of a Sash, Helmet, Bracer, or Boots.
    mpmset $n quest 9 2 1
  else
    if quest(9,2,$n) == 1
      nod $n
      say Your choice of a Sash, Helmet, Bracer, or Boots.
    else
      say You have already chosen the path of Damage, choose it again.
    endif
  endif
endif
~
