  mpecho {130}Lord Dracip says 'Of course you are, IMBECILE!'{300}
  mpecho {130}Lord Dracip says 'Whom is your God?'{300}
  mpmset self quest 1 3 2
endif
~
>speech_prog order~
if quest(1,3,self) == 2
  mpecho Lord Dracip nods his head in approval.
  mpecho {130}Lord Dracip says 'When you are ready, say so'{300}
  mpmset self quest 1 3 3
endif
~
>speech_prog p I am ready~
if quest(2,1,$n) == 0
if quest(1,3,self) == 3
  mpmset self quest 1 3 0
  if quest(0,2,$n) > 0
    mpecho Lord Dracip nods his head in approval.
    mpecho {130}Lord Dracip says 'Of course, Sir.'{300}
    mpmload 13822
    if level($n) < 80
      mpforce SHRINE_ONE_MOB rescale 13822 $n 200
    else
      mpforce SHRINE_ONE_MOB rescale 13822 $n 150
    endif
    mpmset $n quest 7 1 1
    mpforce SHRINE_ONE_MOB mpkill $n
  endif
endif
endif
~
