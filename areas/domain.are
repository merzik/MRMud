>all_greet_prog 100~
mpechoat $n A shimmering shape pulses before you!
if quest(2,1,$n) == 1
  if quest(3,1,$n) == 1
    if quest(4,1,$n) == 1
      if quest(5,1,$n) == 1
        if quest(6,1,$n) == 1
          if quest(8,1,$n) != 1
            bow $n
            say Congratulations, $n.
            say You have proven yourself a mighty and worthy warrior.
            mpareaecho $n has proven to be a truly great warrior.
            say $n, You may have your choice of equipment for such a display.
            say $n, will you choose Armour, Damage, or Defer till later?
            mpmset self quest 2 1 1
          endif
        endif
      endif
    endif
  endif
endif
~
>rand_prog 10~
