        if hasobjnum(13814)
          mpoload 13815
        else
          if hasobjnum(13813)
            mpoload 13814
          else
            if hasobjnum(13812)
              mpoload 13813
            else
              if hasobjnum(13811)
                mpoload 13812
              else
                if hasobjnum(13810)
                  mpoload 13811
                else
                  mpoload 13810
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif
wear all
mpquiet off
