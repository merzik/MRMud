100000 RACE_HALFLING
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if race($n) == 1
   say Hello there.
   say You look really strong, do you wish to join us?
else
   if armystatus($n) == 1
      say Hi $n.
      smile $n
   else
      if armystatus($n) == 2
         say It is always nice to see an old friend again.
         smile
      endif
   endif
endif
if race($n) != 1
   say HOW DID YOU GET IN HERE!
   say Now get lost!
   mpechoat $n You have been thrown out! *OUCH*
   mptransfer $n 9755
endif
~
>speech_prog yes~
if race($n) == 1
   if quest(0,4,$n) == 0
   say Great! Go up stairs and tell Nilrem :
   say I wish to have an audience with his highness.
   mpmset $n quest 0 4 1
endif
~
|
