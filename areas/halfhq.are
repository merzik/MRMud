   mpmset $n quest 0 4 2
   say Very well.
   emote opens the huge wooden door.
   connect 0 2514
   mpforce $n north
   emote closes the huge wooden door.
   connect 0 -1
endif
~
>speech_prog p I wish to see the King.~
