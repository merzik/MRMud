>all_greet_prog 100~
if quest(0, 5, $n) == 2
   emote looks up at you and then turns his head back down.
endif
if quest (0, 5, $n) == 23
   if actorhasobjnum (25016)
      say Good, you've managed to merge the Great Book with
      say the pages you found. 
      say I hope you didn't have too much trouble finding
      say the pages.
      say I need to write new powerful spells into the
      say book so that it will give you protection.
      say But I need to have the book.
   else
   say Only an educated mind can wield such magic.
   endif
endif
if quest (0, 5, $n) == 18
   say I see you've collected some of the pages, 
   say excellent!
   say Hrmm one of the pages seems to have been torn in
   say half...
   ponder
   say Perhaps you could find someone skillful enough
   say to find a way to hold them together.
   mpmset $n quest 0 5 19
endif
if quest (0, 5, $n) == 24
   if quest (5, 5, $n) > 0
      if quest (10, 5, $n) == 0
         say I will give the book to the mayor when I am 
         say finished.
         emote vigoursly writes spells for the future battle. 
      endif
   endif
endif
