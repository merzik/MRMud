>all_greet_prog 100~
if quest(0, 5, $n) == 4
   say Greetings friend.
   say Jerreck tells me that you're looking for the
   say pages from the Great Book.
   say Is that right?
   mpmset $n quest 0 5 5
else
   if quest (0, 5, $n) == 6
      say Are you ready to fight?
   else
   say How may I be of service?
   endif
endif
~
>speech_prog yes~
if quest(0, 5, $n) == 5
   say Fortunatly for you I have one of the pages. 
   say You must prove yourself worthy in order to
   say receive the page from the Great Book.
   say Are you ready to fight?
   mpmset $n quest 0 5 6
endif
~
>speech_prog p fight~
if quest(0, 5, $n) == 6
  mpkill $n
endif
~
>death_prog 100~
if quest(0, 5, $n) == 6
   say You have proved yourself worthy of receiving
   say the page from the Great Book. 
   mpoload 25018
   give i25018 $n
   mpmset $n quest 0 5 7
endif
~
>speech_prog no~
if quest(0, 5, $n) == 6
   say Come back when you are ready to fight me.
   emote turns his head back down to his desk.
endif
~
>fight_prog 35~
emote calls for the assistance of his guard.
mpmload 25005
~
