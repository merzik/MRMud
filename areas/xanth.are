#28105
ouroboros water dragon~
the Ouroboros~
An enormous water dragon coils around the castle here.~
It is a long water dragon with black and white scales that holds its
tail in its teeth.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY|ACT_RACE
AFF_UNDERSTAND|AFF_TONGUES
0 S
50 BODY_MOUTH BODY_TAIL 10d10+1000 1d10+30
100000 RACE_DROW
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(0, 5, $n) == 0
  if quest(5, 3, $n) < 3
    mpechoat $n You take a step back as you realize the moat is filled with firewater.
    mptransfer $n 7677
  endif
else
  if quest(0, 5, $n) > 7
    if quest(5, 3, $n) < 3
      mpechoat $n You take a step back as you realize the moat is filled with firewater.
      mptransfer $n 7677
    endif
  endif
endif
~
>rand_prog 40~
connect 3 -1
if quest(0, 5, $r) == 1
  mpechoat $r You step onto the back of the water dragon, and start
  mpechoat $r walking as the loops of the dragon in front of you rise
  mpechoat $r and the bit you are on starts to submerge.
  mpmset $r quest 0 5 2
  if rand(30)
    mpechoat $r The water dragon's coils pulse and you are thrown clear.
    mpmset $r quest 0 5 1
    mpforce $r east
  endif
else
  if quest(0, 5, $r) == 2
    mpechoat $r You look up as you walk along the coil and see that
    mpechoat $r you are two rows of coils into the moat; about halfway.
    mpmset $r quest 0 5 3
    if rand(30)
      mpechoat $r The water dragon's coils pulse and you are thrown clear.
      mpmset $r quest 0 5 1
      mpforce $r east
    endif
  else
    if quest(0, 5, $r) == 3
      mpechoat $r All of a sudden you look up and find yourself on the
      mpechoat $r innermost coil.  You can hop off onto a narrow ledge.
      connect 3 28181
      mpmset $r quest 0 5 4
    else
      if quest(0, 5, $r) == 4
        mpechoat $r The water dragon's coils pulse and you are thrown clear.
        mpmset $r quest 0 5 1
        mpforce $r east
      else
        if rand(30)
          mpechoat $r The water dragon's coils pulse and you are thrown clear.
          mpforce $r east
        endif
      endif
    endif
  endif
endif
~
