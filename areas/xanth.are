#AREA Xanth~
#AUTHORS Jaxom  ~





#HELPS
-1 XANTH~
The land of Xanth is one full of magic.  There is an old law that says
that each person must have a magical talent in order to be there, otherwise
they will be exiled.  You may find that the Xanth resembles a certain
mundane peninsula, even though it lies south of Ethshar on the continent
of Toril.

(a) Jaxom

Last updated May 13, 1998
{a}JAXOM
~
0 $~




#RANGES 20 50 1 50
#FLAGS AFLAG_NODEBUG|AFLAG_NOTELEPORT
#MOBILES
#28100
trentmob king~
King Trent~
King Trent stands here.~
He is a middle aged man that stands tall and sure of himself.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY|ACT_RACE
AFF_UNDERSTAND|AFF_TONGUES
500 S
50 BODY_HAND BODY_HAND 10d10+1000 1d10+30
92051 RACE_HUMAN
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if class($n) == 6
  say You may not enter Xanth without a magic talent!
  mptransfer $n 28100
else
  if class($n) == 3
    say You may not enter Xanth without a magic talent!
    mptransfer $n 28100
  else
    if class($n) == 2
      say You may not enter Xanth without a magic talent!
      mptransfer $n 28100
    else
      if quest(0, 5, $n) == 0
        say Welcome to Xanth, $n
        say I have been looking for someone like you.
        say I am trying to discover the source of magic in Xanth.
        say Will you help me?
      else
        say What news have you, $n?
      endif
    endif
  endif
endif
~
>speech_prog yes ok sure~
if quest(0, 5, $n) == 0
  smile 
  say Wonderful!
  say I suggest you start with a visit to Good Magician Humphrey
  mpmset $n quest 0 5 1
else
  say huh?
  say Yes what?
endif
~
>speech_prog privacy~
if quest(0, 5, $n) == 11
  say Very well, we shall have to give him the shieldstone
  say that helps to protect Xanth from invaders.
  say Go to the border guard and tell him
  say 'Trent needs the shieldstone.'
  mpmset $n quest 0 5 12
endif
~
>give_prog i28103~
if quest(0, 5, $n) == 13
  say Thank you, $n
  say I have modified the stone for use for the Demon.
  say You had better take this to your Demon now.
  mpquiet on
  mpjunk all
  mpoload 28103
  mpquiet off
  give shieldstone $n
  mpmset $n quest 0 5 14
else
  say Where did you get that?
  say That is vital for the defence of Xanth!
endif
~
>speech_prog source demon~
if quest(0, 5, $n) == 15
  say You have done well in the quest I set for you.
  say Take this as your reward.
  mpquiet on
  mpoload 28106
  give xanthite $n
  mpoload 28107
  give xanthite $n
  mpoload 28108
  give xanthite $n
  mpoload 28109
  give xanthite $n
  mpoload 28110
  give xanthite $n
  mpoload 28111
  give xanthite $n
  mpoload 28112
  give xanthite $n
  drop all
  mpquiet off
  mpechoat $n King Trent gives you a set of Xanthite armor.
  mpmset $n quest 0 5 16
else
  say What about it?
endif
~
>rand_prog 30~
mpquiet on
if rand(25)
  cast 'sanctuary' $n
else
  if rand(25)
    cast 'giant strength' $n
  else
    if rand(25)
      cast bless $n
    else
      cast heal $n
    endif
  endif
endif
mpquiet off
~
|
#28101
humphreymob good magician~
Humphrey~
Good Magician Humphrey is here.~
He is short and old and looks rather like a gnome.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY|ACT_RACE
AFF_UNDERSTAND|AFF_TONGUES
1000 S
50 BODY_HAND BODY_HAND 10d10+1000 1d10+30
91017 RACE_GNOME
POS_STANDING POS_STANDING SEX_MALE
>all_greet_prog 100~
if quest(0, 5, $n) == 6
  mpat 28183 connect 4 -1
  say Well? What do you want?
else
  if quest(5, 3, $n) == 2
    say You have gotten past my obstacles, what do you want?
  else
    say You don't belong here!  Go away.
    mptransfer $n 28100
  endif
endif
~
>speech_prog source magic~
if quest(0, 5, $n) == 6
  mpechoat $n Without thought the gnomelike magician begins to speak.
  say The source of magic in Xanth lies deep below the surface.
  say You may find an entrance near the Region of Madness.
  say Oh yes, you may need this.
  mpoload 28100
  mpquiet on
  cast 'giant strength' $n
  mpquiet off
  give moss $n
  mpmset $n quest 0 5 7
  say Now leave me alone!
  mpechoat $n Humphrey waves his hand and you find yourself somewhere else.
  mptransfer $n 28161
endif
~
>speech_prog help~
if quest(5, 3, $n) == 2
  mpmset $n quest 5 3 3
  mpoload 28113
  give i28113 $n
  mpoload 28114
  give i28114 $n
  mpoload 28115
  give i28115 $n
  mpoload 28116
  give i28116 $n
  say There!  If that doesn't help you nothing will!
  say No go away!
  mptransfer $n 28100
endif
~
|
#28102
X(A/N)th demon~
the Demon X(A/N)th~
The Demon X(A/N)th broods here.~
He is enormous and looks to be made of stone.  He exudes magic
out of every pore.~
ACT_SENTINEL|ACT_STAY_AREA|ACT_SMART|ACT_BODY|ACT_RACE
AFF_SANCTUARY|AFF_UNDERSTAND|AFF_TONGUES
-500 S
50 BODY_HAND BODY_HAND 10d10+1500 1d10+30
92642 RACE_DROW
POS_SLEEPING POS_SLEEPING SEX_NEUTRAL
>speech_prog source~
if quest(0, 5, $n) == 9
  say Of course I am the source of magic.
  say Now tell me why I should not kill you for disturbing me!
  mpmset $n quest 0 5 10
endif
~
>rand_prog 100~
if quest(0, 5, $r) == 8
  shout Why have you awoken me?
  mpmset $r quest 0 5 9
else
 if quest(0, 5, $r) == 10
  if rand(10)
   say You can give me no reason?  Then perish in the void!
   mpmset $r quest 0 5 7
   mpquiet on
   cast astral $r
   mpquiet off
   mptransfer $r 28146
   mpat $r mpforce $r recall set
 else
  mpkill $r
 endif
endif
~
>speech_prog privacy~
if quest(0, 5, $n) == 10
  say Come back when you can ensure my privacy
  say and I will let you live.  Now begone!
  mpmset $n quest 0 5 11
  mptransfer all 28114
endif
~
>fight_prog 40~
say You dare to fight me?!?!
cast 'acid blast' $r
cast 'acid blast' $n
~
>death_prog 100~
say Get out of my land!
mptransfer all 28100
~
>give_prog i28103~
if quest(0, 5, $n) == 14
  say You have proved resourceful indeed, but I would
  say have you know that I can provide myself with anything
  say I need including privacy.  Take this anyway for I have
  say no need of it.
  say Now begone!
  mpquiet on
  mpjunk all
  mpoload 28117
  mpquiet off
  give shieldstone $n
  mpmset $n quest 0 5 15
  mptransfer all 28114
else
  say What am I to do with this? Go away!
  give shieldstone $n
  mptransfer all 28120
endif
~
