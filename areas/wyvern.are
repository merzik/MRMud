X wyvern.bmp~
>all_greet_prog 100~
if quest(0, 4, $n) == 4
  say That so called Ranger Lord sent you??
  say Well I will send you back to him in pieces!
  rescale 1616 $n 100
  mpkill $n
else
  rescale 1616 $n 160
  growl $n
endif
~
>death_prog 100~
if quest(0, 4, $n) == 4
  mpecho The Wyvern screams it horrible death cry.
  mpoload 1675
  mpmset $n quest 0 4 5
else
  if actorhasobjnum(30900)
or actorhasobjnum(30966)
or actorhasobjnum(30967)
or actorhasobjnum(30968)
or actorhasobjnum(30969)
    if quest(30,1,$n) == 0
      mpmset $n quest 30 1 1
      mpoload 30914
      mpforce $n HELP GUILDTOKEN
      mpquiet on
      cast 'giant strength' $n
      give i30914 $n
      mpquiet off
    endif
  endif
~
|
