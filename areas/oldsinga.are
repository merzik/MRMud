  >speech_prog p another failure coming to see you~
  if quest(0,5,$n) == 3
     cackle
     say So you let Yangal fool you with her riddle!
     say Well you made me lose a bet with her and
     say I owe her 50,000 gold coins!
     say You'll have to pay me for my loss!
     if goldamt($n) >= 50000
        mpechoat $n Bidanggu takes your money.
        mpechoaround $n Bidanggu takes money away from $n.
        mpmadd $n gold -50000
        mpmset $n long $n, the unwise stands here foolishly.
        mpmset $n quest 0 5 0
        mpforce $n shout I am dumb!
     else
        say Please come back when you have enough money
        say to pay my debts!
        mpechoat $n {110}Bidanggu drives his heel into your foot.{300}
        mpechoaround $n Bidanggu drives his heel into $n's foot.
        mpmadd $n currhp -10
        mpmset $n quest 0 5 4
        mptransfer $n 27734
     endif
  endif
 if quest(0,5,$n) == 21
     growl $n
     say You DO realize, don't you, that I had a bet with
     say Ganngalida that you would defeat his riddle?
     say You have cost me 50,000 gold coins and I will beat
     say it out of you if necessary!
     if goldamt($n) >= 50000
        mpechoat $n Bidanggu takes your money.
        mpechoaround $n Bidanggu takes money away from $n.
        mpmadd $n gold -50000
        mpmset $n long Worthless gutter scrapings named $n.
        mpmset $n quest 0 5 17
        mpforce $n shout I am dumber than a bucket of rocks!
      else
        mpechoat $n {110}Bidanggu drives his heel into your foot.{300}
        mpechoaround $n Bidanggu drives his heel into $n's foot.
        mpmadd $n currhp -10
        say You had better come back with my gold or....
        say I will hunt you down!
        say Dog!
        mptransfer $n 27734
     endif
 endif
 if quest(0,5,$n) == 13
     say You loser! You are the dumbest person I have ever met!
     say You made me lose my bet with Ganalanja!
     say You WILL repay me!
     if goldamt($n) >= 50000
        mpechoat $n You feel lighter by 50,000 gold coins!
        mpmadd $n gold -50000
        mpmset $n long The dumbest person in the realms wanders aimlessly about.
        mpmset $n quest 0 5 10
        mpforce $n shout I am the dumbest person in the realms!
     else
        mpechoat $n {110}Bidanggu drives his heel into your foot.{300}
        mpechoaround $n Bidanggu drives his heel into $n's foot.
        mpmadd $n currhp -10
        mpmset $n 0 5 14
        say Now go! Do not return until I have my gold!
        mptransfer $n 27734
     endif
 endif
 if quest(0,5,$n) == 18
     groan
     say I was certain you would be able to outwit Garrawa.
     sigh
     say You have cost me 50,000 gold coins, fool!
     say You will pay me what I lost or I will not help you.
     if goldamt($n) >= 50000
        mpechoat $n Bidanggu takes your money.
        mpechoaround $n Bidanggu takes money away from $n.
        mpmadd $n gold -50000
        mpmset $n long $n, the fool stands here.
        mpmset $n quest 0 5 15
        mpforce $n shout I am such a fool!
     else
        mpechoat $n {110}Bidanggu drives his heel into your foot.{300}
        mpechoaround $n Bidanggu drives his heel into $n's foot.
        mpmadd $n currhp -10
        say Now, go! Return when you can repay me for my losses!
        mptransfer $n 27734
     endif
 endif
 if quest(0,5,$n) == 8
     mpforce $n say Yannyalu wants her money, you lost the bet!
     say So you let Yannyalu fool you with her problem!?
     mpforce $n nod
     say Well I am not going to pay for YOUR stupidity, YOU will!
     if goldamt($n) >= 50000
        mpechoat $n Bidanggu takes your money.
        mpechoaround $n Bidanggu takes money from $n.
        mpmadd $n gold -50000
        mpmset $n long $n, the stupid stands here stupidly gazing into the sun.
        mpmset $n quest 0 5 5
        mpforce $n shout I am stupid!
     else
        say Well! You think I'm going to let you off? 
        say I need 50,000 gold coins to pay my debt to Yannyalu.
        mpechoat $n {110}Bidanggu drives his heel into your foot.{300}
        mpechoaround $n Bidanggu drives his heel into $n's foot.
        mpmadd $n currhp -10
        say Come back when you have my money!
        mpmset $n quest 0 5 9
        mptransfer $n 27734
     endif
 endif
  ~
  >all_greet_prog 100~
  if quest(0,5,$n) == 3
