  mppurge self
  endif
 ~
 >give_prog I27721~
  mpecho A Guard of Old Singase thanks you for your generosity.
  mpjunk i27721
  if inroom($n) == 27738
   mpoload 27714
   mpoload 27715
   mpquiet on
   wear i27714
   wear i27715
   mpquiet off
  else
  if inroom($n) == 27742
   mpoload 27716
   mpoload 27717
   mpquiet on
   wear i27716
   wear i27717
   mpquiet off
  else
  if inroom($n) == 27740
   mpoload 27718
   mpquiet on
   wear i27718
   mpquiet off
  else
  if inroom($n) == 27736
   mpoload 27719
   mpquiet on
   wear i27719
   mpquiet off
  else
   chuckle
  endif
 endif
