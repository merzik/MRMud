#AREA Orc Village~
#AUTHORS Jaxom  ~

#AUTHORS Jaxom Robinton~




#HELPS
-1 ORC_VILLAGE_CHANGES~
12.29.04 - 20 spelling corrections. (Mag)
12.29.04 - Added portions to the quest for the Thong of Elf Ears
           to allow the chief to give out the level 60, 80, and
           90 thongs depending on the questor's level. (Mag)
12.29.04 - Changed mpjunk all in chief orc mprog to mpjunk i#####. (Mag)
~

-1 'ORC VILLAGE' ORC_VILLAGE~
{010}ORC VILLAGE
-----------
Orc village is a small encampment of orcs near elven city.  They
were originally set up as a check on the growing city of elves but
have since become a city in their own right.  These are two cities
that you will not find trading diplomats unless they trade
diplomat's pieces.
{300}
{170}This area was created on May 25, 1998 by:

{150}(a) Jaxom

{a}JAXOM
~
0 $~





#RANGES 20 40 0 99
#FLAGS AFLAG_NOTELEPORT
#MOBILES
#2800
guard orcish~
An orcish guard~
An orcish guard patrols here.~
{010}He is a brutish looking orc.  His skin is grey-green in color and covered with
coarse hair.  His forehead juts out and his nose is snoutlike.  His ears are
short and pointed and resemble those of a wolf and he has sharp canine teeth.
~
ACT_BODY|ACT_SMART|ACT_SENTINEL|ACT_RACE
AFF_UNDERSTAND|AFF_DETECT_HIDDEN|AFF_TONGUES
-200 S
95 BODY_HAND BODY_CLAW 1d1+10000 1d1+100
10000 RACE_ORC
POS_STANDING POS_STANDING SEX_MALE
>greet_prog 100~
if race($n) == 6
  if class($n) == 5
    if quest(0, 2, $n) == 1
      say A greeting to you, Shaman $n.
    endif
  else
    if quest(0, 2, $n) == 1
      if class($n) == 2
        if level($n) > 89
          bow $n
          say Welcome Chief $n.
        else
          if level($n) > 70
            say Welcome Subchief $n.
          else
            if level($n) > 50
              say What do you want, $n?
            else
              say Get out of my face, Dung Breath.
            endif
          endif
        endif
      else
        if class($n) == 3
          if level($n) > 89
            bow $n
            say Welcome Chief $n.
          else
            if level($n) > 70
              say Welcome Subchief $n.
            else
              if level($n) > 50
                say What do you want, $n?
              else
                say Get out of my face, Dung Breath.
              endif
            endif
          endif
        else
          if class($n) == 6
            if level($n) > 89
              bow $n
              say Welcome Chief $n.
            else
              if level($n) > 70
                say Welcome Subchief $n.
              else
                if level($n) > 50
                  say What do you want, $n?
                else
                  say Get out of my face, Dung Breath.
                endif
              endif
            endif
          else
            mpecho The orc is afraid to meet your gaze.
            say Greetings to you, Witch Doctor $n.
          endif
        endif
      endif
    else
      say Talk to chief Big Nose if you are new here.
    endif
  endif
else
  if race($n) == 2
    shout Elven scum has entered the village!
    say Your ears are mine, scum!
    rescale 2800 $n 130
    mpkill $n
    mpmset $n quest 0 2 2
    break
  endif
  if quest(0, 2, $n) == 2
    shout An enemy of the camp is here!
    rescale 2800 $n 110
    mpkill $n
  endif
endif
~
>all_greet_prog 0~
if class($n) == 6
  if quest(30, 1, $n) == 0
    shout I have banished a filthy assassin!
    mpmset $n quest 30 1 1
  else
    mptransfer $n 2899
    mpat $n mpforce $n say I am a loser!
    shout I have sent a backstabbing assassin to hell!
  endif
endif
~
>speech_prog open~
if race($n) == 6
  unlock gate
  open gate
endif
~
>death_prog 100~
if race($n) == 6
  mpecho The orc gives a curse and a grunt of admiration as it dies.
else
  if race($n) == 2
    say No, I can not lose to a pointy eared freak!
  else
    shout $n has betrayed the orcs!
    mpmset $n quest 0 2 2
  endif
endif
~
|
#2801
chief orc~
The orc chief~
The orc chief stands here.~
{010}He is a brutish looking orc.  His skin is grey-green in color and covered with
coarse hair.  His forehead juts out and his nose is snoutlike.  His ears are
short and pointed and resemble those of a wolf and he has sharp canine teeth.
~
ACT_RACE|ACT_BODY|ACT_SMART|ACT_SENTINEL
AFF_TONGUES|AFF_UNDERSTAND|AFF_DETECT_HIDDEN|AFF_DETECT_INVIS
-200 S
95 BODY_HAND BODY_CLAW 1d1+10000 1d1+100
10000 RACE_ORC
POS_STANDING POS_STANDING SEX_MALE
>give_prog i12142~
if race($n) == 6
  if quest(0, 2, $n) == 3
    if quest(2, 3, $n) < 5
      mpmadd $n quest 2 3 1
      say Good work.  Keep at it.
      mpjunk i12142
    else
      if quest(2, 3, $n) == 5
        say You have brought me sufficient ears.
        mpecho The chief pulls out a leather strap and attaches the ears to it. 
        if level($n)>89
          mpoload 2805
          give i2805 $n
        endif
        if level($n)>79
          if level($n)<90
            mpoload 2804
            give i2804 $n
          endif
        endif
        if level($n)>59
          if level($n)<80
            mpoload 2803
            give i2803 $n
          endif
        endif
        if level($n)>39
          if level($n)<60
            mpoload 2802
            give i2802 $n
          endif
        endif
        if level($n)<40
          mpoload 2801
          give i2801 $n
        endif
      endif
    endif
  endif
endif
if race($n) == 2
  say A traitor to your race?  Die like the rest!
  mpkill $n
endif
if race($n) !=2
  if race($n) !=6
    say I appreciate the fact that you kill elves,
    say but what do you want from me?
  endif
endif
endif
~
>greet_prog 100~
if race($n) == 6
  if class($n) == 5
    if quest(0, 2, $n) == 1
      say A greeting to you, Shaman $n.
    endif
  else
    if quest(0, 2, $n) == 1
      if class($n) == 2
        if level($n) > 89
          bow $n
          say Welcome Chief $n.
        else
          if level($n) > 70
            say What do you want Subchief $n?
          else
            if level($n) > 50
              say What do you want, $n?
            else
              say Get out of my face, Dung Breath.
            endif
          endif
        endif
      else
        if class($n) == 3
          if level($n) > 89
            bow $n
            say Welcome Chief $n.
          else
            if level($n) > 70
              say What do you want Subchief $n?
            else
              if level($n) > 50
                say What do you want, $n?
              else
                say Get out of my face, Dung Breath.
              endif
            endif
          endif
        else
          if class($n) == 6
            if level($n) > 89
              bow $n
              say Welcome Chief $n.
            else
              if level($n) > 70
                say What do you want Subchief $n?
              else
                if level($n) > 50
                  say What do you want, $n?
                else
                  say Get out of my face, Dung Breath.
                endif
              endif
            endif
          else
            mpecho The orc is afraid to meet your gaze.
            say Greetings to you, Witch Doctor $n.
          endif
        endif
      endif
    else
      if quest(0, 2, $n) == 0
        say If you wish to join my village, bring me 5 elf ears.
        say You must carry this with you as you slaughter the elves.
        mpoload 2800
        give i2800 $n
        mpmset $n quest 2 3 1
        mpmset $n quest 0 2 3
      endif
    endif
  endif
else
  if race($n) == 2
    if quest(5, 3, $n) == 1
      say So, the elves think they can get rid of me do they?
      mpkill $n
    else
      shout Elven scum has entered the village!
      say Your ears are mine, scum!
      rescale 2801 $n 150
      mpkill $n
      mpmset $n quest 0 2 2
      break
    endif
  endif
  if quest(0, 2, $n) == 2
    shout An enemy of the camp is here!
    rescale 2801 $n 110
    mpkill $n
  endif
endif
~
>all_greet_prog 0~
if class($n) == 6
  if quest(30, 1, $n) == 0
    shout I have banished a filthy assassin!
    mpmset $n quest 30 1 1
  else
    mptransfer $n 2899
    mpat $n mpforce $n say I am a loser!
    shout I have sent a backstabbing assassin to hell!
  endif
endif
~
>death_prog 100~
if race($n) == 6
  if quest(0, 2, $n) == 2
    say All the realms will know about the backstabbing elves!
  else
    if quest(5, 3, $n) == 1
      mpecho The orc gives a curse and a grunt of admiration as it dies.
    endif
  endif
else
  if race($n) == 2
    if quest(5, 3, $n) == 1
      say No, I can not lose to a pointy eared freak!
      mpmset $n quest 5 3 2
    endif
  else
    shout $n has betrayed the orcs!
    mpmset $n quest 0 2 2
  endif
endif
~
