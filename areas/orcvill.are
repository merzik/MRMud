>fight_prog 30~
if rand(50)
  cast harm $n
else
  if rand(50)
    cast heal $i
  endif
endif
~
>rand_prog 10~
if race($r) == 6
  if quest(2, 3, $n) == 6
    if rand(20)
      cast bless $r
    else
      if rand(20)
        cast 'giant strength' $r
      else
        if rand(10)
          cast 'enhanced heal' $r
        else
          if rand(10)
            cast sanctuary $r
          else
            cast 'cure critical' $r
          endif
        endif
      endif
    endif
  endif
endif
~
